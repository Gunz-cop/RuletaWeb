---
/**
 * Sección "más herramientas" de la home: la cabecera de sección y la
 * rejilla de tarjetas.
 *
 * La ruleta ya no vive aquí (se mudó a /ruleta), así que el modo foco de la
 * home también se fue con ella -- esta sección ya no necesita ocultarse
 * para nada; ese comportamiento ahora es propio de /ruleta.
 */
import HubGrid from './HubGrid.astro';
---

<section class="hub-section" id="herramientas" aria-label="Más herramientas de decisión">
  <div class="wrap">
    <div class="section-header reveal">
      <div class="section-tag">Caja de herramientas</div>
      <h2 class="section-heading">Nueve formas de dejarlo al azar</h2>
      <p class="section-subtitle">Para fiestas, dinámicas en familia, planes con amigos o actividades de equipo en el trabajo.</p>
    </div>

    <HubGrid />
  </div>
</section>
<style>
  .hub-section .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hub-section .section-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 500px;
    margin: 0.75rem auto 0;
  }

  /* Tamaño de portada del índice: en la home, la pieza central de la
     página, las filas leen más grandes que en sus otras diez hermanas
     (las nueve páginas de herramienta y BlogPost vía BlogSidebar). No se
     toca HubGrid.astro para esto -- ese archivo es el que comparten esas
     once páginas, así que cualquier cambio ahí se les filtra a todas. En
     cambio, estos overrides :global() viven solo en este componente, que
     solo la home importa, igual que index.astro ya hace con las cabeceras
     de sección (.section-header/.section-tag/.section-heading). Cero
     diferencia para las páginas de herramienta y el blog. */
  .hub-section :global(.hub-row) {
    padding: 1.9rem 0;
  }

  .hub-section :global(.hub-row-icon) {
    width: 52px;
    height: 52px;
  }

  .hub-section :global(.hub-row-icon svg) {
    width: 26px;
    height: 26px;
  }

  .hub-section :global(.hub-row h3) {
    font-size: 1.3rem;
  }

  .hub-section :global(.hub-row p) {
    font-size: 0.95rem;
  }
</style>
