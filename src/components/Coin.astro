---
// Moneda 3D con canto real. Solo marcado y apariencia: el volteo lo
// anima moneda.js con la Web Animations API sobre .coin-flight (arco),
// .coin (giro en X) y .coin-floor-shadow (sombra en el suelo). Cada moneda
// lleva `data-coin` para que el script las encuentre; la grande conserva
// además los id #coin, #coin-flight y #coin-floor-shadow.
//
// El canto son capas finas apiladas en translateZ: de frente no se ven,
// pero cuando la moneda pasa de canto forman un borde sólido en vez de
// desaparecer como una hoja de papel.
//
// La moneda es un objeto ilustrado, no UI: por eso sí lleva degradados
// (el metal no se lee como metal sin reflejos), aunque el resto de la
// página siga el sistema editorial sin degradados de DESIGN.md.
//
// Las letras y nombres de las caras son los de "cara o cruz"; moneda.js los
// cambia por el juego de nombres regional elegido (data-face-glyph /
// data-face-label).
interface Props {
  size?: 'lg' | 'sm';
  uid?: string;
}
const { size = 'lg', uid = 'main' } = Astro.props;
const lg = size === 'lg';
const EDGE_LAYERS = lg ? 12 : 6;
const edge = Array.from({ length: EDGE_LAYERS }, (_, i) => i);
const faces = [
  { side: 'heads', glyph: 'C', label: 'Cara' },
  { side: 'tails', glyph: 'X', label: 'Cruz' },
];
---

<div class={`coin-stage coin-stage--${size}`} data-coin>
  <div class="coin-flight" id={lg ? 'coin-flight' : undefined}>
    <div class="coin" id={lg ? 'coin' : undefined} style={`--coin-layers: ${EDGE_LAYERS}`}>
      {edge.map((i) => (
        <span class="coin-edge" style={`--i: ${i}`} aria-hidden="true"></span>
      ))}
      {faces.map((f) => (
        <div class={`coin-face coin-face--${f.side}`} aria-hidden="true">
          <svg class="coin-engraving" viewBox="0 0 100 100">
            {lg && (
              <>
                <path id={`coin-arc-${uid}-${f.side}`} d="M 19 50 A 31 31 0 0 1 81 50" fill="none" />
                {/* Leyenda en bajorrelieve: copia clara desplazada + copia oscura */}
                <text class="coin-legend coin-legend--light" dy="0.5">
                  <textPath href={`#coin-arc-${uid}-${f.side}`} startOffset="50%" text-anchor="middle">DECÍDELO · 2026</textPath>
                </text>
                <text class="coin-legend">
                  <textPath href={`#coin-arc-${uid}-${f.side}`} startOffset="50%" text-anchor="middle">DECÍDELO · 2026</textPath>
                </text>
              </>
            )}
            {/* Gráfila: el anillo de perlas que llevan casi todas las monedas */}
            <circle cx="50" cy="50" r="39" class="coin-beads" />
          </svg>
          <span class="coin-glyph" data-face-glyph={f.side}>{f.glyph}</span>
          {lg && <span class="coin-label" data-face-label={f.side}>{f.label}</span>}
        </div>
      ))}
    </div>
  </div>
  <div class="coin-floor-shadow" id={lg ? 'coin-floor-shadow' : undefined} aria-hidden="true"></div>
</div>

<style>
  .coin-stage {
    --coin-size: 184px;
    --coin-depth: 12px;
    /* Latón dorado, sesgado hacia el terracota del sitio */
    --metal-hi: #f7dc9c;
    --metal: #dca656;
    --metal-mid: #bf8638;
    --metal-lo: #8a5a1f;
    --metal-ink: #7a4f18;
    position: relative;
    width: var(--coin-size);
    height: calc(var(--coin-size) + 2.5rem);
    margin: 0 auto;
    perspective: 900px;
  }

  .coin-flight {
    position: relative;
    z-index: 1;
    width: var(--coin-size);
    height: var(--coin-size);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .coin {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    cursor: pointer;
  }

  .coin-edge,
  .coin-face {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  /* Canto: capas alternas claro/oscuro que de lado se leen como estriado */
  .coin-edge {
    background: var(--metal-mid);
    transform: translateZ(calc(
      (var(--i) / (var(--coin-layers) - 1) - 0.5) * (var(--coin-depth) - 2px)
    ));
  }

  .coin-edge:nth-child(odd) {
    background: var(--metal-lo);
  }

  .coin-face {
    display: grid;
    place-items: center;
    align-content: center;
    background:
      radial-gradient(circle at 30% 24%, rgb(255 250 230 / 0.6), rgb(255 250 230 / 0) 36%),
      radial-gradient(circle at 72% 80%, rgb(80 45 8 / 0.35), rgb(80 45 8 / 0) 48%),
      conic-gradient(from 215deg, var(--metal), var(--metal-hi), var(--metal), var(--metal-mid), var(--metal-lo), var(--metal-mid), var(--metal));
    box-shadow: inset 0 0 0 1px rgb(80 45 8 / 0.7);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Borde estriado */
  .coin-face::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 24%, rgb(255 250 230 / 0.45), rgb(255 250 230 / 0) 45%),
      repeating-conic-gradient(var(--metal-mid) 0deg 2deg, var(--metal-hi) 2deg 4deg);
    -webkit-mask: radial-gradient(closest-side, transparent 93%, #000 93.5%);
    mask: radial-gradient(closest-side, transparent 93%, #000 93.5%);
  }

  /* Canto interior del listel: el campo queda hundido respecto al borde */
  .coin-face::after {
    content: '';
    position: absolute;
    inset: 7%;
    border-radius: 50%;
    box-shadow:
      inset 0 3px 4px rgb(70 38 4 / 0.5),
      inset 0 -2px 3px rgb(255 238 195 / 0.45),
      0 0 0 1px rgb(255 238 195 / 0.35);
  }

  .coin-face--heads {
    transform: translateZ(calc(var(--coin-depth) / 2));
  }

  .coin-face--tails {
    transform: rotateX(180deg) translateZ(calc(var(--coin-depth) / 2));
  }

  .coin-engraving {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .coin-legend {
    font-family: 'Outfit', sans-serif;
    font-size: 6.4px;
    font-weight: 700;
    letter-spacing: 1.4px;
    fill: var(--metal-ink);
  }

  .coin-legend--light {
    fill: rgb(255 240 200 / 0.7);
  }

  .coin-beads {
    fill: none;
    stroke: var(--metal-ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 0 3.05;
    opacity: 0.55;
  }

  /* Relieve: luz arriba, sombra abajo */
  .coin-glyph,
  .coin-label {
    position: relative;
    font-family: 'Outfit', sans-serif;
    color: var(--metal-ink);
    text-shadow:
      0 1px 0 rgb(255 240 200 / 0.75),
      0 -1px 1px rgb(60 32 4 / 0.45);
  }

  .coin-glyph {
    font-weight: 800;
    font-size: 4.2rem;
    line-height: 1;
    margin-top: 0.6rem;
  }

  .coin-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Sombra ya difuminada de origen; solo se anima scale/opacity */
  .coin-floor-shadow {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 0;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), transparent);
    will-change: transform, opacity;
  }

  /* Monedas pequeñas del modo "varias": sin leyenda ni nombre, solo letra */
  .coin-stage--sm {
    --coin-size: 56px;
    --coin-depth: 5px;
    height: calc(var(--coin-size) + 0.75rem);
    margin: 0;
  }

  .coin-stage--sm .coin-glyph {
    font-size: 1.5rem;
    margin-top: 0;
  }

  .coin-stage--sm .coin-floor-shadow {
    height: 8px;
  }

  @media (max-width: 639px) {
    .coin-stage--lg {
      --coin-size: 112px;
      --coin-depth: 8px;
      height: calc(var(--coin-size) + 0.5rem);
    }

    .coin-stage--lg .coin-glyph {
      font-size: 2.5rem;
      margin-top: 0.35rem;
    }

    .coin-stage--lg .coin-label {
      font-size: 0.5rem;
    }

    .coin-stage--sm {
      --coin-size: 52px;
    }
  }
</style>
