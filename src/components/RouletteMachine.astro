---
/**
 * La ruleta de la home: la rueda, el panel de opciones y sus dos pestañas.
 *
 * Migrado al sistema editorial (ver DESIGN.md): sin la cabina arcade
 * (badge "DECI-BOARD V2.0" + LEDs parpadeantes), sin degradados ni glow, un
 * solo acento cálido (--accent-warm) en vez del trío neón. El bloque ya no
 * usa las clases compartidas .arcade-cabinet-frame/.arcade-header/
 * .arcade-badge/.arcade-leds/.led-* ni .secondary-btn/.danger-btn/
 * .primary-btn de global.css: esas siguen vivas para dados/moneda/etc.,
 * que no están migradas todavía, así que tocar su definición global habría
 * migrado esas páginas de rebote. En su lugar, este componente define sus
 * propias clases scopeadas (.wheel-toolbar-btn, .wheel-card, .input-card…).
 *
 * .section-tag/.section-heading SÍ son las clases compartidas de
 * global.css (con el tamaño de sección de home ya sobrescrito en
 * index.astro): son el mismo encabezado de sección que usan "Cómo
 * funciona" y el índice de herramientas, y de paso resucitan una regla de
 * modo foco que llevaba órfana desde el refactor a componentes —
 * `body.focus-mode-active :global(.roulette-section .section-header)` en
 * index.astro esperaba un `.section-header` dentro de esta sección que
 * nunca existió aquí (la cabina arcade no se llamaba así). Ahora sí hay
 * uno, así que el modo foco vuelve a ocultarlo como estaba pensado.
 *
 * Es la pieza más grande que vivía en index.astro. El marcado y sus reglas
 * viajan juntos, así que el scope de Astro sigue aplicando igual, y
 * roulette.js la maneja entera por id, no por clase, de modo que no le
 * afecta que el marcado haya cambiado de archivo.
 *
 * Lo que NO viaja son las reglas del modo foco: recolocan la ruleta desde
 * fuera y se quedan en index.astro, donde han tenido que pasar a :global()
 * porque el scope de la página ya no alcanza este marcado. El test de
 * estados lo comprueba (npm run test:estado).
 *
 * Las reglas de .checklist-item van con :global() porque ese HTML lo genera
 * roulette.js, no este archivo.
 */
---

<section class="roulette-section reveal" id="ruleta" aria-label="Ruleta de Decisión Aleatoria">
  <div class="wrap">
    <div class="section-header">
      <div class="section-tag">Herramienta principal</div>
      <h2 class="section-heading roulette-heading">Gira y <em>decide.</em></h2>
    </div>

    <div class="app-grid">
      <!-- Columna Izquierda: La Ruleta -->
      <div class="wheel-column">
        <div class="wheel-title-container">
          <h3 id="wheel-title-text" title="Haz clic para editar el título">Ruleta de Opciones</h3>
          <button id="edit-title-btn" class="edit-title-btn" title="Editar título" aria-label="Editar título de la ruleta">
            <span aria-hidden="true">✏️</span>
          </button>
        </div>
        <div class="wheel-card">
          <div class="wheel-outer-wrapper">
            <!-- Indicador visual superior -->
            <div class="pointer" id="wheel-pointer">
              <!-- Sin degradado (el sistema editorial no admite): las dos
                   paradas de #pointer-grad quedaron del arcade neón — un
                   único --accent-warm liso en las dos formas. -->
              <svg width="34" height="34" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 30L3 7.5L27 7.5L15 30Z" fill="#e2905a"/>
                <path d="M15 25L6.5 9L23.5 9L15 25Z" fill="#1a1207"/>
              </svg>
            </div>
            <!-- Canvas de la ruleta -->
            <canvas id="roulette-canvas"></canvas>
            <!-- Botón central GIRAR -->
            <button id="spin-button" class="spin-center-button" aria-label="Girar la rueda aleatoria">GIRAR</button>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Entrada de Datos -->
      <div class="input-column">
        <div class="input-card">
          <h3 id="input-title" class="section-title">Opciones de la Ruleta</h3>
          <p class="section-desc">Escribe tus opciones o contrólalas de forma individual.</p>

          <!-- Pestañas -->
          <div class="card-tabs" role="tablist">
            <button id="tab-edit" class="tab-btn active" role="tab" aria-selected="true" aria-controls="tab-edit-content">📝 Texto</button>
            <button id="tab-manage" class="tab-btn" role="tab" aria-selected="false" aria-controls="tab-manage-content">
              <span class="tab-btn-label">👁️ Ocultar/Activar</span>
              <span class="tab-btn-count">(<span id="active-count">0</span>/<span id="total-count">0</span>)</span>
            </button>
          </div>

          <!-- Pestaña 1: Editor de texto -->
          <div id="tab-edit-content" class="tab-content-pane" role="tabpanel" aria-labelledby="tab-edit">
            <textarea id="options-input" autocomplete="off" spellcheck="false" placeholder="Ingresa tus opciones aquí, una por línea..." aria-label="Escribe las opciones de la ruleta una por línea"></textarea>
            <div class="btn-group">
              <button id="shuffle-btn" class="wheel-toolbar-btn" title="Mezclar aleatoriamente el orden">
                <span class="wheel-toolbar-btn-label"><span class="btn-icon" aria-hidden="true">🔀</span> Mezclar</span>
              </button>
              <button id="clear-btn" class="wheel-toolbar-btn wheel-toolbar-btn--danger" title="Vaciar la lista completa">
                <span class="wheel-toolbar-btn-label"><span class="btn-icon" aria-hidden="true">🗑️</span> Limpiar</span>
              </button>
            </div>
          </div>

          <!-- Pestaña 2: Lista de descarte -->
          <div id="tab-manage-content" class="tab-content-pane hidden" role="tabpanel" aria-labelledby="tab-manage">
            <div class="manage-header-flex">
              <p class="manage-instruction">Desmarca las casillas para ocultar opciones de la ruleta temporalmente sin borrarlas.</p>
              <button id="activate-all-btn" class="wheel-toolbar-btn wheel-toolbar-btn--sm" title="Activar todas las opciones">
                <span class="wheel-toolbar-btn-label"><span class="btn-icon" aria-hidden="true">✅</span> Activar Todas</span>
              </button>
            </div>
            <div id="options-checklist-container" class="options-checklist-container">
              <!-- Se genera dinámicamente con JavaScript -->
            </div>
          </div>
        </div> <!-- input-card -->
      </div> <!-- input-column -->
    </div> <!-- app-grid -->
  </div> <!-- wrap -->
</section>
<style>
  /* Ruleta Section */
  .roulette-section {
    padding: 2rem 0 4rem;
  }

  /* Mismo tratamiento tipográfico que "Cómo funciona": kicker +
     .section-heading vienen de global.css (tamaño ya agrandado para la
     home en index.astro), la palabra de énfasis en Newsreader itálica
     cálida es el mismo patrón que usa HomeHero/HomeHowItWorks. Newsreader
     ya está cargada por index.astro (única página que usa este
     componente), así que no hace falta un <link> nuevo aquí. */
  .roulette-heading {
    margin: 0;
  }

  .roulette-heading em {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--accent-warm);
  }

  /* App Grid Layout */
  .app-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .app-grid {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: stretch;
      gap: 2.5rem;
    }
  }

  /* Wheel Styling */
  .wheel-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .wheel-title-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    width: 100%;
    max-width: 520px;
  }

  #wheel-title-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    word-break: break-word;
    cursor: pointer;
    transition: color 200ms var(--ease-out);
    user-select: none;
  }

  @media (hover: hover) and (pointer: fine) {
    #wheel-title-text:hover {
      color: var(--accent-warm);
      text-decoration: underline;
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }
  }

  /* Objetivo táctil de 44px: en desktop el ícono se ve chico a propósito
     (0.25rem de padding visual), pero en táctil el área de toque real es
     el cuadro invisible completo, no el glifo. */
  .edit-title-btn {
    background: transparent;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    font-size: 1.1rem;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .edit-title-btn:hover {
      color: var(--accent-warm);
    }
  }

  .edit-title-btn:active {
    transform: scale(0.9);
  }

  .wheel-card {
    background: var(--bg-surface);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  @media (min-width: 480px) {
    .wheel-card {
      padding: 1.5rem;
    }
  }

  .wheel-outer-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #roulette-canvas {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
  }

  .pointer {
    position: absolute;
    top: -4px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    transform-origin: top center;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4));
    pointer-events: none;
  }

  /* Botón GIRAR: relleno sólido del acento cálido, sin degradado ni glow
     neón. Sigue siendo un botón físico (círculo, no texto subrayado como
     .hero-cta) porque vive centrado sobre la rueda, no en un flujo de
     texto — pero pierde el pulso cian y el halo que tenía en la estética
     arcade. Contraste del texto: #1a1207 sobre #e2905a da 7.38:1 (AAA para
     texto normal; 8.37:1 era el contraste de #1a1207 contra negro puro, no
     contra el fondo real del botón — de ahí el número anterior mal puesto
     aquí). Blanco solo llega a ~2.5:1, así que la tinta oscura es la única
     opción legible, igual que .primary-btn ya hace con su degradado. */
  .spin-center-button {
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--accent-warm);
    border: none;
    color: #1a1207;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    transition: transform 160ms var(--ease-out);
    user-select: none;
    z-index: 20;
  }

  /* Feedback de presión: es la única señal de estado que un dedo puede
     recibir, así que no depende de :hover. */
  .spin-center-button:active {
    transform: scale(0.94);
  }

  @media (hover: hover) and (pointer: fine) {
    .spin-center-button:hover {
      transform: scale(1.06);
    }
  }

  .spin-center-button:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 3px;
  }

  .spin-center-button:disabled {
    cursor: not-allowed;
    color: var(--text-tertiary);
    background: var(--bg-elevated);
    box-shadow: none;
    transform: scale(1);
  }

  /* Input Column Styling */
  .input-column {
    display: flex;
    flex-direction: column;
  }

  .input-card {
    background: var(--bg-surface);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  @media (min-width: 480px) {
    .input-card {
      padding: 1.5rem;
    }
  }

  .section-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  /* Pestañas: es de lo más tocado de todo el bloque, así que cada botón
     lleva su propia altura táctil mínima (44px) en vez de depender del
     padding relleno con el texto. El estado activo es un borde inferior +
     color de texto — persiste sin :hover, así que se lee igual en táctil.
     flex:1 evita que "👁️ Ocultar/Activar (0/0)" empuje a la otra pestaña
     fuera de los 390px: si no cabe en una línea, cada botón envuelve su
     propio texto en dos en vez de desbordar la fila. */
  .card-tabs {
    display: flex;
    border-bottom: 1px solid var(--divider-line);
    margin-bottom: 1.25rem;
  }

  .tab-btn {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    text-align: center;
    line-height: 1.3;
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }

  /* Explícito, no implícito: .tab-btn-label hereda el color de .tab-btn
     (gris inactivo / --accent-warm cuando .active), a diferencia de
     .tab-btn-count, que abajo se fija siempre en --text-secondary. Sin
     esta regla la herencia funciona igual, pero queda sin decir por qué
     el span existe. */
  .tab-btn-label {
    color: inherit;
  }

  /* El contador va en su propia línea a propósito, no como un desborde de
     texto que envuelve donde le toca: "(6/20)" partido a la mitad por un
     wrap accidental se leía como un bug, no como diseño.
     Nada de opacity para atenuarlo: a 0.72rem (~11.5px) cuenta como texto
     normal para AA (necesita 4.5:1), y --text-secondary al 80% de opacidad
     sobre --bg-surface cae a ~4.05:1 — por debajo del umbral. Con opacidad
     1 da 5.72:1. --text-tertiary tampoco alcanza (2.84:1), así que el color
     tiene que ser --text-secondary sí o sí, sin atenuar. */
  .tab-btn-count {
    font-size: 0.72rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }

  @media (hover: hover) and (pointer: fine) {
    .tab-btn:hover { color: var(--text-primary); }
  }

  .tab-btn.active {
    color: var(--accent-warm);
    border-bottom-color: var(--accent-warm);
  }

  .tab-content-pane {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tab-content-pane.hidden { display: none !important; }

  #options-input {
    width: 100%;
    height: 250px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1rem;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.5;
    resize: none;
    outline: none;
    transition: border-color 0.25s ease;
  }

  #options-input:focus {
    border-color: var(--accent-warm);
  }

  .btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
  }

  .manage-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .manage-instruction {
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.4;
    margin: 0;
    flex: 1;
    min-width: 180px;
  }

  /* Botones de la ruleta (mezclar/limpiar/activar todas): texto con
     acento en vez de pastilla rellena, siguiendo el mismo criterio que
     .hero-cta ("botones como texto subrayado" — ver DESIGN.md).
     El botón en sí solo da el área de toque (44px, flex centrado, sin
     borde propio): si el border-bottom fuera del botón, con min-height:44
     y el texto centrado el borde cae en el límite inferior del área
     táctil, ~10px por debajo de la palabra — se ve una rayita flotando,
     no un subrayado. El borde real vive en el <span> interno
     (.wheel-toolbar-btn-label), que abraza justo el texto, igual que
     .hero-cta. Queda visible siempre, no solo al :hover, porque en táctil
     el hover no existe y el botón tiene que leerse como tocable sin
     necesitar un puntero. */
  .wheel-toolbar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.25rem 0.1rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-family: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .wheel-toolbar-btn-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--divider-line);
    color: inherit;
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .wheel-toolbar-btn:hover .wheel-toolbar-btn-label {
      color: var(--text-primary);
      border-bottom-color: var(--text-secondary);
    }
  }

  .wheel-toolbar-btn:active .wheel-toolbar-btn-label {
    transform: scale(0.97);
  }

  .wheel-toolbar-btn--danger .wheel-toolbar-btn-label {
    color: var(--accent-danger);
    border-bottom-color: rgba(239, 68, 68, 0.35);
  }

  @media (hover: hover) and (pointer: fine) {
    .wheel-toolbar-btn--danger:hover .wheel-toolbar-btn-label {
      color: #f87171;
      border-bottom-color: #f87171;
    }
  }

  .wheel-toolbar-btn--sm {
    font-size: 0.78rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .options-checklist-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 250px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  .options-checklist-container::-webkit-scrollbar { width: 5px; }
  .options-checklist-container::-webkit-scrollbar-track { background: rgba(0,0,0,0.15); border-radius: 4px; }
  .options-checklist-container::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.07); border-radius: 4px; }
  .options-checklist-container::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.14); }

  /* min-height 44px + padding vertical: cada fila del checklist es un
     objetivo táctil completo, no solo la casilla de 17px. word-break en
     el span de texto evita que una opción larga sin espacios desborde el
     ancho a 390px (ver AGENTS.md / verificación mobile-first). */
  :global(.checklist-item) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 0.5rem 0.85rem;
    cursor: pointer;
    user-select: none;
    transition: background-color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.checklist-item:hover) {
      background: rgba(255, 255, 255, 0.02);
      border-color: var(--card-border-hover);
    }
  }

  :global(.checklist-item input[type="checkbox"]) {
    accent-color: var(--accent-warm);
    width: 18px; height: 18px;
    flex-shrink: 0;
    cursor: pointer;
  }

  :global(.checklist-item span) {
    font-size: 0.9rem;
    color: var(--text-primary);
    word-break: break-all;
    transition: color 200ms var(--ease-out);
  }

  :global(.checklist-item.disabled) {
    opacity: 0.5;
    background: rgba(0, 0, 0, 0.08);
  }

  :global(.checklist-item.disabled span) {
    text-decoration: line-through;
    color: var(--text-tertiary);
  }

/* Ajustes de móvil. Estaban al final del <style> de index.astro, fuera del
   bloque contiguo de la ruleta, y quedarse allí dejaba la tarjeta con más
   relleno del debido: el canvas se dimensiona por JS a partir del
   contenedor, así que la rueda salía visiblemente más pequeña en móvil. */
@media (max-width: 480px) {
  .roulette-section .section-header {
    margin-bottom: 1.5rem;
  }
}
</style>
