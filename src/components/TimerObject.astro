---
// El objeto del temporizador, uno por modo: la papa (se calienta y tiembla
// mientras corre el tiempo), un círculo que guía la respiración (aguantar
// un impulso) y un cuenco que suena en cada aviso. Solo marcado y
// apariencia: temporizador.js elige cuál se ve con [data-mode] y lo anima
// con la Web Animations API. Es un objeto ilustrado, no UI, así que lleva
// degradados (ver DESIGN.md, "Excepción: objetos ilustrados").
---

<div class="tobj relative flex flex-col items-center" id="timer-object" data-mode="papa" aria-hidden="true">
  <div class="tobj-rig" id="timer-rig">
    <div class="tobj-body relative" id="timer-body">

      <svg class="tobj-art tobj-papa" viewBox="0 -34 200 184">
        <defs>
          <radialGradient id="tobj-piel" cx="38%" cy="32%" r="75%">
            <stop offset="0%" stop-color="#e7bd85" />
            <stop offset="55%" stop-color="#b98244" />
            <stop offset="100%" stop-color="#6e4520" />
          </radialGradient>
          <radialGradient id="tobj-calor" cx="50%" cy="55%" r="70%">
            <stop offset="0%" stop-color="#ff7a45" />
            <stop offset="70%" stop-color="#e2502a" />
            <stop offset="100%" stop-color="#a8301a" />
          </radialGradient>
        </defs>
        {/* Vapor: aparece a medida que la papa se calienta */}
        <g class="tobj-steam" id="timer-steam" fill="none" stroke="#f0f0f5" stroke-width="3" stroke-linecap="round">
          <path d="M72 6 C64 -4 80 -12 72 -24" />
          <path d="M102 2 C94 -10 110 -18 102 -30" />
          <path d="M132 6 C124 -4 140 -12 132 -24" />
        </g>
        <path class="tobj-papa-shape" fill="url(#tobj-piel)" d="M30 80 C22 45 60 18 105 20 C150 22 182 45 178 80 C175 118 140 136 98 134 C55 132 36 112 30 80 Z" />
        <path class="tobj-heat" id="timer-heat" fill="url(#tobj-calor)" d="M30 80 C22 45 60 18 105 20 C150 22 182 45 178 80 C175 118 140 136 98 134 C55 132 36 112 30 80 Z" />
        <g fill="#5a3616" opacity="0.55">
          <ellipse cx="72" cy="58" rx="4" ry="2.5" />
          <ellipse cx="130" cy="50" rx="3.5" ry="2.2" />
          <ellipse cx="152" cy="96" rx="4" ry="2.6" />
          <ellipse cx="94" cy="108" rx="3.2" ry="2" />
          <ellipse cx="54" cy="96" rx="2.6" ry="1.8" />
        </g>
        <ellipse cx="80" cy="44" rx="24" ry="9" fill="#ffffff" opacity="0.16" transform="rotate(-16 80 44)" />
      </svg>

      <div class="tobj-art tobj-aire">
        <span class="tobj-aire-ring absolute inset-0 rounded-full"></span>
        <span class="tobj-aire-core absolute inset-0 rounded-full" id="timer-breath-core"></span>
        <span class="tobj-aire-text absolute inset-0 grid place-items-center" id="timer-breath-text">Respira</span>
      </div>

      <svg class="tobj-art tobj-cuenco" viewBox="0 0 200 150">
        <defs>
          <linearGradient id="tobj-laton" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0%" stop-color="#5a3d15" />
            <stop offset="30%" stop-color="#c8963f" />
            <stop offset="45%" stop-color="#f3d27a" />
            <stop offset="70%" stop-color="#a7752a" />
            <stop offset="100%" stop-color="#4a3210" />
          </linearGradient>
          <linearGradient id="tobj-hueco" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#2c1e0b" />
            <stop offset="100%" stop-color="#7a5520" />
          </linearGradient>
        </defs>
        <ellipse cx="100" cy="130" rx="74" ry="13" fill="#2a2230" />
        <path fill="url(#tobj-laton)" d="M30 64 C34 112 64 128 100 128 C136 128 166 112 170 64 Z" />
        <ellipse cx="100" cy="64" rx="70" ry="12" fill="url(#tobj-hueco)" stroke="#f0cf7a" stroke-width="2" />
        <ellipse class="tobj-onda" cx="100" cy="64" rx="70" ry="12" fill="none" stroke="#e2905a" stroke-width="2" />
        <ellipse class="tobj-onda" cx="100" cy="64" rx="70" ry="12" fill="none" stroke="#e2905a" stroke-width="1.5" />
      </svg>

    </div>
  </div>
  <div class="tobj-floor pointer-events-none" id="timer-floor"></div>
</div>

<style>
  .tobj {
    /* Todo sale del tamaño. En los móviles bajos (360×560, 375×548) el
       botón queda con más de 100px de holgura, así que no hace falta
       compactarlo; si un día hiciera falta, basta con bajar este valor. */
    --obj: 10rem;
  }

  @media (min-width: 640px) {
    .tobj { --obj: 12.5rem; }
  }

  @media (min-width: 1024px) {
    .tobj { --obj: 14rem; }
  }

  .tobj-rig,
  .tobj-body {
    will-change: transform;
  }

  .tobj-body {
    width: var(--obj);
    height: var(--obj);
  }

  .tobj-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }

  .tobj[data-mode='papa'] .tobj-papa,
  .tobj[data-mode='impulso'] .tobj-aire,
  .tobj[data-mode='avisos'] .tobj-cuenco {
    display: block;
  }

  /* El calor y el vapor empiezan apagados; el JS los sube con opacity */
  .tobj-heat,
  .tobj-steam,
  .tobj-onda {
    opacity: 0;
  }

  .tobj-onda {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Respiración: un anillo fijo y un disco que crece al inhalar */
  .tobj-aire-ring {
    border: 1px solid var(--divider-line);
  }

  .tobj-aire-core {
    background: radial-gradient(circle at 50% 45%, rgb(226 144 90 / 0.32), rgb(226 144 90 / 0.08) 70%);
    border: 1.5px solid var(--accent-warm);
    transform: scale(0.62);
    will-change: transform;
  }

  .tobj-aire-text {
    color: var(--text-primary);
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .tobj-floor {
    width: calc(var(--obj) * 0.7);
    height: calc(var(--obj) * 0.08);
    margin-top: calc(var(--obj) * 0.02);
    background: radial-gradient(ellipse at 50% 50%, rgb(0 0 0 / 0.8) 0%, rgb(0 0 0 / 0.35) 45%, rgb(0 0 0 / 0) 72%);
    will-change: transform, opacity;
  }

  .tobj[data-mode='impulso'] .tobj-floor {
    visibility: hidden;
  }
</style>
