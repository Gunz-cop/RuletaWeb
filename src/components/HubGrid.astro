---
interface Tool {
  id: string;
  name: string;
  desc: string;
  href: string;
  status: 'active' | 'coming-soon';
  icon: 'wheel' | 'coin' | 'dice' | 'rps' | 'secret-friend' | 'numbers' | 'teams' | 'oracle' | 'timer';
  /** Un color por herramienta, no un solo acento: mismo criterio de luminosidad
   * y saturación moderada (nada de neón), hue distinto por categoría. Codifica
   * "son actividades distintas", no decoración — ver DESIGN.md. */
  color: string;
}

interface Props {
  activeToolId?: string;
}

const { activeToolId } = Astro.props;

const tools: Tool[] = [
  {
    id: 'ruleta',
    name: 'Ruleta de Decisión Aleatoria',
    desc: 'Crea tu propia ruleta personalizada con opciones, gírala y deja que el azar elija por ti de forma divertida y rápida.',
    href: '/#ruleta',
    status: 'active',
    icon: 'wheel',
    color: '226,144,90',
  },
  {
    id: 'moneda',
    name: 'Lanzar Moneda',
    desc: 'Cara o cruz al instante con físicas en 3D. Elige entre moneda clásica, pirata o forajida con un agujero de bala real.',
    href: '/moneda',
    status: 'active',
    icon: 'coin',
    color: '212,165,63',
  },
  {
    id: 'dados',
    name: 'Lanzar Dados',
    desc: 'Lanza 1, 2 o 3 dados a la vez. Elige entre las temáticas Casino de Las Vegas, Calabozos y Dragones (D20) o Yu-Gi-Oh.',
    href: '/dados',
    status: 'active',
    icon: 'dice',
    color: '199,123,143',
  },
  {
    id: 'piedra-papel-tijera',
    name: 'Piedra, Papel o Tijera',
    desc: 'El clásico juego de manos contra la IA o un amigo. Animaciones dinámicas, contador de victorias y dos modos de juego.',
    href: '/piedra-papel-tijera',
    status: 'active',
    icon: 'rps',
    color: '127,176,163',
  },
  {
    id: 'amigo-secreto',
    name: 'Amigo Secreto Online',
    desc: 'Organiza tu sorteo de regalos sin papelitos y 100% privado. Genera enlaces instantáneos para compartir.',
    href: '/amigo-secreto',
    status: 'active',
    icon: 'secret-friend',
    color: '212,106,106',
  },
  {
    id: 'numeros',
    name: 'Generador de Números',
    desc: 'Genera uno o varios números aleatorios en un rango personalizado, con opción de evitar duplicados.',
    href: '/numeros',
    status: 'active',
    icon: 'numbers',
    color: '138,160,212',
  },
  {
    id: 'equipos',
    name: 'Generador de Equipos',
    desc: 'Divide una lista de nombres de manera equilibrada en múltiples equipos aleatorios de forma instantánea.',
    href: '/equipos',
    status: 'active',
    icon: 'teams',
    color: '111,184,138',
  },
  {
    id: 'si-o-no',
    name: 'Sí o No (Oráculo)',
    desc: 'Pregunta al oráculo místico y obtén una respuesta binaria directa acompañada de una animación de bola 8.',
    href: '/si-o-no',
    status: 'active',
    icon: 'oracle',
    color: '176,136,201',
  },
  {
    id: 'temporizador',
    name: 'Temporizador Aleatorio',
    desc: 'Establece un rango de tiempo y deja que termine en un segundo aleatorio. Ideal para juegos y retos.',
    href: '/temporizador',
    status: 'active',
    icon: 'timer',
    color: '91,163,176',
  }
];

// Reordering to put active one first or filtering out active if desired.
// Let's filter out the activeToolId from being showing if we want to show "related tools" only,
// or show all. For the hub grid on home, we show all.
---

<div class="hub-list">
  {tools.map((tool, index) => {
    const isCurrent = tool.id === activeToolId;
    const n = String(index + 1).padStart(2, '0');

    return (
      <a
        href={tool.status === 'active' ? tool.href : '#'}
        class={`hub-row reveal reveal-delay-${(index % 9) + 1} ${isCurrent ? 'current-active' : ''}`}
        id={`card-${tool.id}`}
        style={`--tool-rgb: ${tool.color};${tool.status !== 'active' ? ' cursor: not-allowed; opacity: 0.5;' : ''}`}
      >
        <span class="hub-row-index">{n}</span>
        <div class="hub-row-icon">
          {tool.icon === 'wheel' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2"/>
              <line x1="12" y1="2" x2="12" y2="22"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
            </svg>
          )}
          {tool.icon === 'coin' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <path d="M12 8a2.5 2.5 0 0 1 2 4.5 2.5 2.5 0 0 1-4.5-2.5A2.5 2.5 0 0 1 12 8z"/>
            </svg>
          )}
          {tool.icon === 'dice' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="3" ry="3"/>
              <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="8.5" cy="15.5" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="15.5" cy="15.5" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>
            </svg>
          )}
          {tool.icon === 'rps' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              <path d="M5 15a7 7 0 0 0 14 0v-3a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3z"/>
              <line x1="9" y1="12" x2="9" y2="16"/>
              <line x1="15" y1="12" x2="15" y2="16"/>
            </svg>
          )}
          {tool.icon === 'secret-friend' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 12 20 22 4 22 4 12"/>
              <rect x="2" y="7" width="20" height="5"/>
              <line x1="12" y1="22" x2="12" y2="7"/>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
            </svg>
          )}
          {tool.icon === 'numbers' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 22V4c0-.5.2-1 .6-1.4C5 2.2 5.5 2 6 2h12c.5 0 1 .2 1.4.6.4.4.6.9.6 1.4v18l-5-4-5 4-5-4-5 4z"/>
              <path d="M9 7h6M9 11h6"/>
            </svg>
          )}
          {tool.icon === 'teams' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          )}
          {tool.icon === 'oracle' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              <path d="M2 12h20"/>
            </svg>
          )}
          {tool.icon === 'timer' && (
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
              <path d="M12 2v2"/>
            </svg>
          )}
        </div>
        <div class="hub-row-text">
          <h3>{tool.name}</h3>
          <p>{tool.desc}</p>
        </div>
        <span class="hub-row-status">
          {isCurrent ? 'Estás aquí' : tool.status === 'active' ? 'Disponible' : 'Próximamente'}
        </span>
        <svg class="hub-row-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    );
  })}
</div>

<style>
  .hub-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-top: 1px solid var(--divider-line);
  }

  .hub-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--divider-line);
    text-decoration: none;
    transition: transform 160ms var(--ease-out);
  }

  /* Feedback de presión en toda la fila (es un link de ancho completo). */
  .hub-row:active {
    transform: scale(0.99);
  }

  .hub-row.current-active {
    pointer-events: none; /* No clickable if you are already on that page */
  }

  .hub-row-index {
    color: var(--text-tertiary);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    width: 1.6rem;
    flex-shrink: 0;
  }

  .hub-row-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--tool-rgb), 0.12);
    flex-shrink: 0;
  }

  .hub-row-icon svg {
    width: 22px; height: 22px;
    stroke: rgb(var(--tool-rgb));
    stroke-width: 1.8;
    fill: none;
  }

  .hub-row-text {
    flex: 1;
    min-width: 0;
  }

  .hub-row h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.2rem;
  }

  .hub-row p {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.4;
    margin: 0;
  }

  .hub-row-status {
    color: var(--text-tertiary);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex-shrink: 0;
    display: none;
  }

  .hub-row.current-active .hub-row-status {
    /* La fila activa no tiene flecha (no es clickable): en mobile, donde
       .hub-row-status se oculta por defecto, es la única señal de "estás
       aquí" que le queda a la fila. Sin esto, la ruleta se ve idéntica a
       cualquier otra herramienta en pantallas angostas. */
    display: block;
    color: rgb(var(--tool-rgb));
  }

  .hub-row-arrow {
    width: 18px; height: 18px;
    color: var(--text-tertiary);
    flex-shrink: 0;
    transition: transform 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hub-row:hover .hub-row-arrow {
      color: rgb(var(--tool-rgb));
      transform: translateX(3px);
    }
  }

  .hub-row.current-active .hub-row-arrow {
    display: none;
  }

  @media (min-width: 560px) {
    .hub-row-status { display: block; }
  }

  @media (max-width: 559px) {
    .hub-row-text p { display: none; }

    /* La fila activa es la única que muestra .hub-row-status en este ancho
       (ver arriba); sin la flecha compitiendo por espacio, más compacto
       aquí deja el nombre de la herramienta en menos líneas. */
    .hub-row.current-active .hub-row-status {
      font-size: 0.64rem;
      letter-spacing: 0.04em;
    }

    .hub-row {
      gap: 1rem;
    }
  }
</style>
