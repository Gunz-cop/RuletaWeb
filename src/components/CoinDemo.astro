---
// Demo animada de cómo se usa la moneda, para el artículo de moneda.astro.
// Solo CSS: sin JS, sin imágenes ni vídeo (unos 3 KB), porque el peso de
// página es requisito de producto. Es una ilustración, no UI: por eso el
// «botón» es un contorno y no compite con el único botón relleno de la
// página (DESIGN.md, "Anatomía de una página de herramienta").
---

<figure class="cdemo" aria-labelledby="cdemo-cap">
  <div class="cdemo-stage" aria-hidden="true">
    <div class="cdemo-fields">
      <div class="cdemo-field">
        <span class="cdemo-label">Cara</span>
        <span class="cdemo-input"><span class="cdemo-type cdemo-type-a">Pizza</span></span>
      </div>
      <span class="cdemo-vs">o</span>
      <div class="cdemo-field">
        <span class="cdemo-label">Sello</span>
        <span class="cdemo-input"><span class="cdemo-type cdemo-type-b">Sushi</span></span>
      </div>
    </div>

    <div class="cdemo-coin-wrap">
      <div class="cdemo-coin">
        <span class="cdemo-face cdemo-front">C</span>
        <span class="cdemo-face cdemo-back">S</span>
      </div>
    </div>

    <p class="cdemo-result">Pizza <small>Cara</small></p>
    <span class="cdemo-btn">Lanzar moneda</span>
  </div>
  <figcaption id="cdemo-cap">Escribe tus dos opciones, pulsa &laquo;Lanzar moneda&raquo; y listo.</figcaption>
</figure>

<style>
  /* Un único ciclo de 9s para todo: cada pieza usa su tramo de la línea de
     tiempo, así las partes nunca se desincronizan entre vueltas. */
  .cdemo {
    --t: 9s;
    --metal-hi: #f7dc9c;
    --metal: #dca656;
    --metal-lo: #8a5a1f;
    --metal-ink: #7a4f18;
    margin: 2rem auto;
    max-width: 22rem;
  }

  .cdemo-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--divider-line);
    border-radius: 16px;
    background: var(--bg-body);
  }

  .cdemo-fields {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 0.75rem;
    width: 100%;
  }

  .cdemo-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .cdemo-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .cdemo-input {
    display: block;
    height: 1.7rem;
    border-bottom: 1px solid var(--divider-line);
    color: var(--text-primary);
  }

  .cdemo-vs {
    font-family: 'Newsreader', Georgia, serif;
    font-style: italic;
    color: var(--text-tertiary);
    padding-bottom: 0.3rem;
  }

  /* Tecleo: el texto se destapa letra a letra con steps(5) */
  .cdemo-type {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    width: 0;
    border-right: 1px solid transparent;
  }

  .cdemo-type-a { animation: cdemo-type-a var(--t) infinite; }
  .cdemo-type-b { animation: cdemo-type-b var(--t) infinite; }

  @keyframes cdemo-type-a {
    0%, 8% { width: 0; border-color: var(--accent-warm); }
    20% { width: 5.2ch; border-color: var(--accent-warm); }
    21%, 94% { width: 5.2ch; border-color: transparent; }
    100% { width: 5.2ch; border-color: transparent; }
  }

  @keyframes cdemo-type-b {
    0%, 23% { width: 0; border-color: transparent; }
    24% { width: 0; border-color: var(--accent-warm); }
    36% { width: 5.2ch; border-color: var(--accent-warm); }
    37%, 100% { width: 5.2ch; border-color: transparent; }
  }

  .cdemo-type-a, .cdemo-type-b { animation-timing-function: steps(5, end); }

  /* Moneda: disco de latón con dos caras en 3D */
  .cdemo-coin-wrap {
    perspective: 500px;
    height: 5.5rem;
    display: flex;
    align-items: center;
  }

  .cdemo-coin {
    position: relative;
    width: 4.25rem;
    height: 4.25rem;
    transform-style: preserve-3d;
    animation: cdemo-flip var(--t) cubic-bezier(0.3, 0, 0.3, 1) infinite;
  }

  .cdemo-face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    backface-visibility: hidden;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--metal-ink);
    background:
      radial-gradient(circle at 35% 30%, var(--metal-hi), var(--metal) 55%, var(--metal-lo));
    box-shadow: inset 0 0 0 3px var(--metal-lo), inset 0 0 0 5px var(--metal-hi);
  }

  .cdemo-back { transform: rotateY(180deg); }

  /* Salta y gira 5 vueltas (1800deg) para caer de cara, en ~1,5s,
     dentro del rango de 1–2s que marca DESIGN.md */
  @keyframes cdemo-flip {
    0%, 44% { transform: translateY(0) rotateY(0); }
    52% { transform: translateY(-1.25rem) rotateY(900deg); }
    60%, 100% { transform: translateY(0) rotateY(1800deg); }
  }

  .cdemo-result {
    margin: 0;
    min-height: 2.2rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--text-primary);
    text-align: center;
    opacity: 0;
    animation: cdemo-result var(--t) infinite;
  }

  .cdemo-result small {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  @keyframes cdemo-result {
    0%, 61% { opacity: 0; transform: translateY(6px); }
    65%, 92% { opacity: 1; transform: none; }
    97%, 100% { opacity: 0; transform: none; }
  }

  /* El «botón» de la ilustración: contorno, y se hunde al pulsarlo */
  .cdemo-btn {
    padding: 0.55rem 1.4rem;
    border: 1px solid var(--accent-warm);
    border-radius: 999px;
    color: var(--accent-warm);
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    animation: cdemo-press var(--t) infinite;
  }

  @keyframes cdemo-press {
    0%, 40% { transform: none; background: transparent; color: var(--accent-warm); }
    42% { transform: scale(0.94); background: var(--accent-warm); color: #1a0e06; }
    45%, 100% { transform: none; background: transparent; color: var(--accent-warm); }
  }

  figcaption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* Sin movimiento: se muestra el estado final, quieto */
  @media (prefers-reduced-motion: reduce) {
    .cdemo *, .cdemo *::before { animation: none !important; }
    .cdemo-type { width: 5.2ch; }
    .cdemo-result { opacity: 1; }
  }
</style>
