---
interface Props {
  showHomeHeader?: boolean;
  /** Sonido y Modo Foco son controles de la ruleta, no del hub: solo
   * /ruleta los necesita entre las páginas con showHomeHeader=false. Ver
   * AGENTS.md/el encargo de mudanza de la ruleta -- roulette.js busca
   * #focus-toggle-btn y #sound-toggle-btn por id sin comprobar que
   * existan, así que la página que lo carga tiene que pasar esta prop en
   * true o el script revienta al cargar. */
  showRouletteControls?: boolean;
}

const { showHomeHeader = false, showRouletteControls = false } = Astro.props;
---

<header>
  <div class="wrap header-inner flex items-center justify-between">
    {showHomeHeader ? (
      <a href="/" class="logo-link" aria-label="Inicio de decídelo.app">
        <span class="logo-icon" aria-hidden="true">🎯</span>
        <span class="logo-text">decídelo.app</span>
      </a>
      <nav class="header-nav" aria-label="Navegación principal">
        <a href="/ruleta" class="nav-link">Ruleta</a>
        <a href="/#herramientas" class="nav-link">Herramientas</a>
        <a href="/blog" class="nav-link">Blog</a>
        <a href="/sobre" class="nav-link">Sobre</a>
        <button id="focus-toggle-btn" class="control-btn" title="Activar Modo Foco" aria-pressed="false">
          <span class="btn-icon" aria-hidden="true">🎯</span>
          <span class="btn-label">Foco</span>
        </button>
        <button id="sound-toggle-btn" class="control-btn" title="Activar/Desactivar sonido" aria-pressed="true">
          <span class="btn-icon" aria-hidden="true">🔊</span>
          <span class="btn-label">Sonido</span>
        </button>
      </nav>
    ) : (
      <a href="/" class="logo" id="header-logo">
        <span>decídelo.app</span>
      </a>
      <div class="tool-header-actions">
        {showRouletteControls && (
          <>
            <button id="focus-toggle-btn" class="control-btn" title="Activar Modo Foco" aria-pressed="false">
              <span class="btn-icon" aria-hidden="true">🎯</span>
              <span class="btn-label">Foco</span>
            </button>
            <button id="sound-toggle-btn" class="control-btn" title="Activar/Desactivar sonido" aria-pressed="true">
              <span class="btn-icon" aria-hidden="true">🔊</span>
              <span class="btn-label">Sonido</span>
            </button>
          </>
        )}
        <a href="/" class="btn-back" id="btn-back-hub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver al Hub
        </a>
      </div>
    )}
  </div>
</header>

<style>
  /* .logo-link y .header-nav se quedan en CSS: sus gaps (0.6rem y 0.35rem)
     no están en la escala de 0.25rem de Tailwind, y como utilidades
     arbitrarias añaden reglas nuevas a la hoja compartida que, medido en
     gzip, pesan más de lo que ahorran. Ver DESIGN.md, escala de espaciado. */
  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* header-inner sigue en el marcado aunque no tenga reglas propias: su
     layout lo dan utilidades, pero el modo foco de index.astro la usa como
     enganche con :global(). Quitarla dejaría esa regla apuntando a nada, y
     ningún test lo detectaría porque la regla se sigue emitiendo. */

  /* Home header styles */
  .logo-icon {
    font-size: 1.6rem;
    display: inline-block;
    animation: logo-float 3s ease-in-out infinite;
  }

  @keyframes logo-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-3px) rotate(8deg); }
  }

  .logo-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    transition: var(--transition);
    display: none;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255,255,255,0.05);
  }

  @media (min-width: 640px) {
    .nav-link { display: inline-flex; }
  }

  /* Sonido y Modo Foco: parte de la ruleta (ver DESIGN.md, la migración
     incluye estos dos botones) aunque el marcado viva en Header.astro, que
     solo se renderiza en la home con showHomeHeader=true — .control-btn no
     se usa en ninguna otra página, así que recolorearla no filtra el
     acento cálido a las herramientas sin migrar. min-height/min-width en
     44px es el objetivo táctil real: el padding visual se queda más
     angosto porque en mobile el botón es solo el ícono (.btn-label se
     oculta hasta 480px, ver abajo). */
  .control-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.45rem 0.65rem;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    transition: var(--transition);
  }

  @media (hover: hover) and (pointer: fine) {
    .control-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.14);
    }
  }

  .control-btn:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 2px;
  }

  /* Estado persistente (no depende de :hover): el acento cálido único del
     sistema editorial en vez del coral neón. */
  .control-btn.active {
    background: rgba(226, 144, 90, 0.14);
    border-color: rgba(226, 144, 90, 0.35);
    color: var(--accent-warm);
  }

  .control-btn .btn-label {
    display: none;
  }

  @media (min-width: 480px) {
    .control-btn .btn-label { display: inline; }
  }

  /* Tool page header styles */
  /* Agrupa Foco/Sonido (si vienen) con "Volver al Hub" para que
     justify-between de .header-inner los trate como un solo bloque a la
     derecha, igual que antes trataba solo al enlace. */
  .tool-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo {
    text-decoration: none;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .btn-back {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    transition: var(--transition);
  }

  .btn-back:hover {
    color: var(--accent-cyan);
    background: rgba(0, 229, 255, 0.06);
  }

  .btn-back svg {
    transition: transform 0.25s ease;
  }

  .btn-back:hover svg {
    transform: translateX(-3px);
  }

</style>
