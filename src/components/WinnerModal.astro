---
/**
 * Modal que anuncia el ganador de la ruleta.
 *
 * Migrado al sistema editorial (ver DESIGN.md): sin el glow cian en la
 * sombra de la tarjeta ni el texto en degradado del nombre ganador — un
 * solo acento cálido, plano. El botón "Aceptar" ya no usa el .primary-btn
 * compartido de global.css (degradado + texto negro): esa clase la siguen
 * usando dados/moneda/etc., que no están migradas, así que se define un
 * .winner-accept-btn propio en vez de tocar la definición global.
 *
 * El marcado y sus reglas viajan juntos, así que el scope de Astro sigue
 * aplicando igual. roulette.js lo maneja por id (#winner-modal,
 * #winner-display, #modal-close-btn) y le pone y quita la clase .active,
 * cosas que no cambian al vivir en un componente.
 */
---

<div id="winner-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="modal-winner-title">
  <div class="modal-card">
    <span class="celebration-emoji" aria-hidden="true">🎉</span>
    <h2 id="modal-winner-title" class="modal-title">¡Tenemos un ganador!</h2>
    <div class="winner-name-container">
      <p id="winner-display" class="winner-name-text">Resultado</p>
    </div>
    <button id="modal-close-btn" class="winner-accept-btn">Aceptar</button>
  </div>
</div>
<style>
  .modal-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background-color: rgba(6, 7, 10, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xl);
    padding: 2rem 1.5rem;
    max-width: 440px;
    width: 90%;
    text-align: center;
    box-shadow: var(--shadow-lg);
    transform: scale(0.9);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (min-width: 480px) {
    .modal-card {
      padding: 2.5rem 2rem;
    }
  }

  .modal-overlay.active .modal-card {
    transform: scale(1);
  }

  .celebration-emoji {
    font-size: 3.5rem;
    display: block;
    margin-bottom: 0.75rem;
    animation: emote-bounce 1s infinite alternate cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  @keyframes emote-bounce {
    from { transform: translateY(0) scale(1); }
    to { transform: translateY(-12px) scale(1.05); }
  }

  .modal-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .winner-name-container {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 1.25rem;
    margin: 1.5rem 0;
    overflow-wrap: break-word;
  }

  .winner-name-text {
    font-family: 'Outfit', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--accent-warm);
    overflow-wrap: break-word;
  }

  /* Botón "Aceptar": relleno sólido del acento cálido, mismo criterio que
     el botón GIRAR de la rueda — es la acción principal de un modal, no un
     link de contenido, así que no lleva el tratamiento de texto subrayado
     de .hero-cta. #1a1207 en vez de blanco: es el mismo cálculo de
     contraste que usa .spin-center-button (~8.4:1 sobre --accent-warm).
     Ancho completo y 48px de alto: es el único botón del modal y hay que
     poder tocarlo sin apuntar con precisión. */
  .winner-accept-btn {
    width: 100%;
    min-height: 48px;
    background: var(--accent-warm);
    color: #1a1207;
    border: none;
    border-radius: var(--radius-md);
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }

  .winner-accept-btn:active {
    transform: scale(0.97);
  }

  .winner-accept-btn:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 2px;
  }

  /*
   * El bloque de global.css solo cubre .reveal/.reveal-scale/.slide-up, que no
   * existen aquí: sin esto, el emoji rebota en bucle mientras el modal está
   * abierto y la tarjeta entra con un scale rebotado. Se queda la entrada por
   * opacidad del overlay, que sí ayuda a entender que algo apareció.
   */
  @media (prefers-reduced-motion: reduce) {
    .celebration-emoji {
      animation: none;
    }

    .modal-card,
    .modal-overlay.active .modal-card {
      transform: none;
      transition: none;
    }
  }
</style>
