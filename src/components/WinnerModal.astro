---
/**
 * Modal que anuncia el ganador de la ruleta.
 *
 * El marcado y sus reglas viajan juntos, así que el scope de Astro sigue
 * aplicando igual. roulette.js lo maneja por id (#winner-modal,
 * #winner-display, #modal-close-btn) y le pone y quita la clase .active,
 * cosas que no cambian al vivir en un componente.
 */
---

<div id="winner-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="modal-winner-title">
  <div class="modal-card">
    <span class="celebration-emoji" aria-hidden="true">🎉</span>
    <h2 id="modal-winner-title" class="modal-title">¡Tenemos un ganador!</h2>
    <div class="winner-name-container">
      <p id="winner-display" class="winner-name-text">Resultado</p>
    </div>
    <button id="modal-close-btn" class="primary-btn">Aceptar</button>
  </div>
</div>
<style>
  .modal-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background-color: rgba(6, 7, 10, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    max-width: 440px;
    width: 90%;
    text-align: center;
    box-shadow: var(--shadow-glow-cyan), 0 20px 40px rgba(0, 0, 0, 0.6);
    transform: scale(0.9);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .modal-overlay.active .modal-card {
    transform: scale(1);
  }

  .celebration-emoji {
    font-size: 3.5rem;
    display: block;
    margin-bottom: 0.75rem;
    animation: emote-bounce 1s infinite alternate cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  @keyframes emote-bounce {
    from { transform: translateY(0) scale(1); }
    to { transform: translateY(-12px) scale(1.05); }
  }

  .modal-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .winner-name-container {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 1.25rem;
    margin: 1.5rem 0;
    overflow-wrap: break-word;
  }

  .winner-name-text {
    font-family: 'Outfit', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 2px 8px rgba(0, 229, 255, 0.3));
  }
</style>
