---
// Bola 8 del oráculo. Solo marcado y apariencia: si-o-no.js la anima con la
// Web Animations API (entrada rodando, flotación, giro del 8 a la ventana,
// agitado, burbujas y el dado que emerge). Las clases de estado
// (.is-open, .is-asking, .is-revealed) las pone el JS sobre [data-oracle],
// por eso viven aquí como CSS propio y no como utilidades: Tailwind no
// rastrea src/scripts/ (ver tailwind.css).
//
// Es un objeto ilustrado, no UI: lleva degradados, relieve y sombras porque
// sin ellos la esfera se lee como un círculo plano (ver DESIGN.md,
// "Excepción: objetos ilustrados"). La ilusión de giro funciona porque la
// luz (.oracle-shade, .oracle-shine) está por encima de las caras y no se
// mueve: las caras se deslizan por debajo y se comprimen al llegar al borde,
// como una marca sobre una esfera que rota.
const BUBBLES = 7;
---

<div class="oracle-object relative flex flex-col items-center" data-oracle id="oracle-object">
  <div class="oracle-rig relative" id="oracle-rig">
    <div class="oracle-ball relative grid place-items-center overflow-hidden rounded-full cursor-pointer" id="oracle-ball" aria-hidden="true">

      {/* Cara del 8: lo que se ve mientras no hay respuesta */}
      <div class="oracle-eight absolute grid place-items-center rounded-full" id="oracle-eight">
        <span class="oracle-eight-num">8</span>
      </div>

      {/* Ventana con líquido y el dado de la respuesta */}
      <div class="oracle-window absolute grid place-items-center overflow-hidden rounded-full" id="oracle-window">
        {Array.from({ length: BUBBLES }, (_, i) => (
          <span class="oracle-bubble absolute rounded-full" style={`--b: ${i}`}></span>
        ))}
        <div class="oracle-die relative grid place-items-center" id="oracle-die">
          <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 100">
            <polygon class="oracle-die-face" points="50,6 95,88 5,88" />
            <polygon class="oracle-die-bevel" points="50,17 85,82 15,82" />
          </svg>
          <span class="oracle-die-text relative text-center" id="oracle-die-text"></span>
        </div>
        <span class="oracle-glass absolute inset-0 rounded-full pointer-events-none"></span>
      </div>

      {/* Luz fija por encima de las caras: sombreado esférico y reflejos */}
      <span class="oracle-shade absolute inset-0 rounded-full pointer-events-none"></span>
      <span class="oracle-shine absolute rounded-full pointer-events-none"></span>
      <span class="oracle-spec absolute rounded-full pointer-events-none"></span>
    </div>
  </div>
  <div class="oracle-floor relative pointer-events-none" id="oracle-floor" aria-hidden="true"></div>
</div>

<style>
  .oracle-object {
    /* Todo se deriva del diámetro: así la bola se compacta en pantallas
       bajas cambiando un solo valor. */
    --ball-size: 13rem;
    --ball-hi: #5a5c6b;
    --ball: #17181f;
    --ball-lo: #020203;
    --ivory-hi: #ffffff;
    --ivory: #eeece6;
    --ivory-lo: #c8c5bc;
    --liquid-hi: #1d2966;
    --liquid: #0b1034;
    --liquid-lo: #03051a;
    --die: #26337a;
    --die-edge: #4b5cb3;
    --die-ink: #eef0ff;
    /* Reflejo del acento del sitio en el borde de la bola, como si hubiera
       una lámpara terracota al lado: une el objeto con la paleta. */
    --rim: 226 144 90;
  }

  @media (min-width: 640px) {
    .oracle-object { --ball-size: 15rem; }
  }

  /* Tablet o plegable abierto con poca altura (Fold abierto, 673×760): una
     sola columna con la bola grande empuja el botón fuera de pantalla */
  @media (min-width: 640px) and (max-width: 1023px) and (max-height: 820px) {
    .oracle-object { --ball-size: 13rem; }
  }

  @media (min-width: 1024px) {
    .oracle-object { --ball-size: 16.5rem; }
  }

  /* Pantallas bajas (Android con Chrome, iPhone SE): la bola cede alto para
     que el botón de consultar quepa sin scroll. */
  @media (max-width: 639px) and (max-height: 620px) {
    .oracle-object { --ball-size: 10rem; }
  }

  .oracle-rig {
    will-change: transform;
  }

  .oracle-ball {
    width: var(--ball-size);
    height: var(--ball-size);
    background: radial-gradient(circle at 34% 28%, var(--ball-hi) 0%, var(--ball) 38%, var(--ball-lo) 100%);
    will-change: transform;
    -webkit-tap-highlight-color: transparent;
    /* Safari no recorta bien los hijos transformados con overflow + radius
       sin su propia capa de composición */
    isolation: isolate;
  }

  /* --- Cara del 8 ------------------------------------------------------ */
  .oracle-eight {
    width: 47%;
    height: 47%;
    background: radial-gradient(circle at 38% 30%, var(--ivory-hi) 0%, var(--ivory) 45%, var(--ivory-lo) 100%);
    box-shadow:
      inset 0 -0.2rem 0.5rem rgb(0 0 0 / 0.18),
      0 0 0 calc(var(--ball-size) * 0.008) rgb(0 0 0 / 0.35);
    will-change: transform, opacity;
  }

  .oracle-eight-num {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: calc(var(--ball-size) * 0.31);
    line-height: 1;
    color: #0b0b0f;
    /* El 8 del juguete está algo más arriba del centro óptico */
    transform: translateY(-3%);
  }

  /* --- Ventana ----------------------------------------------------------- */
  .oracle-window {
    width: 52%;
    height: 52%;
    background: radial-gradient(circle at 50% 38%, var(--liquid-hi) 0%, var(--liquid) 58%, var(--liquid-lo) 100%);
    box-shadow:
      0 0 0 calc(var(--ball-size) * 0.018) #0c0d12,
      0 0 0 calc(var(--ball-size) * 0.026) #2a2c38,
      inset 0 0.45rem 1rem rgb(0 0 0 / 0.85);
    will-change: transform, opacity;
    /* Oculta hasta que la bola gira: fuera, junto al borde izquierdo */
    opacity: 0;
    transform: translateX(calc(var(--ball-size) * -0.42)) scaleX(0.2);
  }

  .oracle-glass {
    background:
      radial-gradient(ellipse 55% 35% at 40% 18%, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0) 70%),
      radial-gradient(circle at 50% 50%, rgb(0 0 0 / 0) 62%, rgb(0 0 0 / 0.45) 100%);
  }

  .oracle-bubble {
    left: calc(18% + var(--b) * 10%);
    bottom: 0;
    width: calc(var(--ball-size) * 0.022);
    height: calc(var(--ball-size) * 0.022);
    background: radial-gradient(circle at 35% 30%, rgb(255 255 255 / 0.7), rgb(170 190 255 / 0.15) 70%);
    opacity: 0;
    pointer-events: none;
  }

  .oracle-bubble:nth-child(even) {
    width: calc(var(--ball-size) * 0.014);
    height: calc(var(--ball-size) * 0.014);
  }

  .oracle-die {
    width: 86%;
    height: 86%;
    opacity: 0;
    will-change: transform, opacity, filter;
  }

  .oracle-die-face {
    fill: var(--die);
    stroke: var(--die-edge);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .oracle-die-bevel {
    fill: none;
    stroke: rgb(255 255 255 / 0.12);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  /* El texto va en la mitad ancha del triángulo, como en el juguete */
  .oracle-die-text {
    max-width: 62%;
    margin-top: 26%;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: calc(var(--ball-size) * 0.034);
    line-height: 1.12;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--die-ink);
    text-shadow: 0 0 0.35rem rgb(120 140 255 / 0.35);
  }

  /* --- Luz ---------------------------------------------------------------- */
  .oracle-shade {
    z-index: 2;
    background: radial-gradient(circle at 36% 30%, rgb(0 0 0 / 0) 38%, rgb(0 0 0 / 0.5) 74%, rgb(0 0 0 / 0.88) 100%);
    box-shadow:
      inset calc(var(--ball-size) * -0.03) calc(var(--ball-size) * -0.035) calc(var(--ball-size) * 0.06) calc(var(--ball-size) * -0.02) rgb(var(--rim) / 0.28),
      inset 0 0 0 1px rgb(255 255 255 / 0.04);
  }

  .oracle-shine {
    z-index: 3;
    top: 6%;
    left: 16%;
    width: 44%;
    height: 26%;
    background: radial-gradient(ellipse at 50% 40%, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0) 70%);
    transform: rotate(-28deg);
  }

  .oracle-spec {
    z-index: 3;
    top: 15%;
    left: 27%;
    width: 7%;
    height: 4.5%;
    background: rgb(255 255 255 / 0.75);
    filter: blur(1.5px);
    transform: rotate(-30deg);
  }

  /* --- Suelo -------------------------------------------------------------- */
  .oracle-floor {
    width: calc(var(--ball-size) * 0.78);
    height: calc(var(--ball-size) * 0.09);
    margin-top: calc(var(--ball-size) * 0.03);
    background: radial-gradient(ellipse at 50% 50%, rgb(0 0 0 / 0.85) 0%, rgb(0 0 0 / 0.4) 45%, rgb(0 0 0 / 0) 72%);
    will-change: transform, opacity;
  }

  /* --- Estados que pone el JS -------------------------------------------- */
  [data-oracle].is-open .oracle-eight {
    opacity: 0;
    transform: translateX(calc(var(--ball-size) * 0.42)) scaleX(0.2);
  }

  [data-oracle].is-open .oracle-window {
    opacity: 1;
    transform: none;
  }

  [data-oracle].is-revealed .oracle-die {
    opacity: 1;
  }

  [data-oracle].is-asking .oracle-die {
    opacity: 0;
  }
</style>
