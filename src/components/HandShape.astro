---
// Un fotograma de mano de piedra, papel o tijera. Son imágenes propias
// generadas con ChatGPT y procesadas a mano (origen y procesado en
// src/assets/ppt/ORIGEN.md): dibujadas en SVG no se entendían. El amarillo
// neutro no asigna ningún tono de piel.
//
// Fotogramas: `piedra` (el puño, de donde salen las dos series),
// `papel-2`…`papel-6` y `tijera-2`…`tijera-6`; el 6 es la jugada final.
// Los usan el objeto (PptHands.astro, todos los fotogramas por mano) y los
// botones de jugada (solo los finales). Van por <Picture> en AVIF/WebP
// (AGENTS.md, regla 1), siempre `eager`: un fotograma oculto con
// display:none no se cargaría en modo lazy hasta mostrarse, y la animación
// enseñaría huecos.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  frame: string;
  class?: string;
  /** Ancho en CSS, para que el navegador elija la variante justa */
  sizes: string;
}
const { frame, class: className, sizes } = Astro.props;

const imagenes = import.meta.glob<{ default: ImageMetadata }>('../assets/ppt/*.png', { eager: true });
const img = imagenes[`../assets/ppt/${frame}.png`]?.default;
if (!img) throw new Error(`HandShape: no existe el fotograma "${frame}"`);
---

<Picture
  src={img}
  alt=""
  widths={[96, 192, 384]}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  loading="eager"
  draggable="false"
  pictureAttributes={{ class: className, 'data-frame': frame }}
/>
