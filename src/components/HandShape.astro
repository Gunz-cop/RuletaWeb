---
// Mano de piedra, papel o tijera. Son los emojis 3D de Fluent Emoji
// (Microsoft, licencia MIT, ver src/assets/ppt/LICENSE.txt): se probó a
// dibujarlas a mano en SVG y no se entendían. El amarillo neutro, además,
// no asigna ningún tono de piel a nadie.
//
// Las comparten el objeto (PptHands.astro, las tres formas por mano) y los
// botones de jugada. Van por <Picture> en AVIF/WebP (AGENTS.md, regla 1):
// el navegador descarga cada forma una sola vez aunque salga en tres sitios.
// Siempre `eager`: las formas ocultas con display:none no se cargarían en
// modo lazy hasta mostrarse, y la mano aparecería vacía al revelar.
import { Picture } from 'astro:assets';
import piedra from '../assets/ppt/piedra.png';
import papel from '../assets/ppt/papel.png';
import tijera from '../assets/ppt/tijera.png';

interface Props {
  forma: 'piedra' | 'papel' | 'tijera';
  class?: string;
  /** Ancho en CSS, para que el navegador elija la variante justa */
  sizes: string;
}
const { forma, class: className, sizes } = Astro.props;
const IMG = { piedra, papel, tijera };
---

<Picture
  src={IMG[forma]}
  alt=""
  widths={[96, 160, 256]}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  loading="eager"
  draggable="false"
  pictureAttributes={{ class: className, 'data-forma': forma }}
/>
