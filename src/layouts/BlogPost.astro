---
import Layout from './Layout.astro';
import HubGrid from '../components/HubGrid.astro';
import AdSlot from '../components/AdSlot.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import { getEditorialKit, getFallbackMistakes } from '../data/adsenseEditorial';
import { Picture, getImage } from 'astro:assets';
import { getHeroImage } from '../lib/heroImages';
import { buildBlogSchema } from '../lib/blogSchema';
import '../styles/blog-content.css';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags: string[];
  author: string;
  indexable?: boolean;
  readingTime?: number;
}

const { slug, title, description, pubDate, updatedDate, heroImage, tags, author, indexable = false, readingTime } = Astro.props;
const heroAsset = getHeroImage(heroImage);
// Variante fija para el structured data y redes sociales. Se genera con
// getImage en vez de usar heroAsset.src directamente: referenciar el
// original obligaría a Astro a emitir también el PNG sin comprimir, que
// ningún navegador llegaría a descargar.
const heroSocial = heroAsset
  ? await getImage({ src: heroAsset, format: 'webp', width: 1200 })
  : undefined;
const editorialKit = getEditorialKit(slug);
const fallbackMistakes = getFallbackMistakes();

const formattedDate = new Date(pubDate).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const postUrl = new URL(Astro.url.pathname, 'https://decidelo.app').href;

const schemaLD = buildBlogSchema({
  title, description, pubDate, updatedDate, author, postUrl,
  heroSocial, heroImage, editorialKit,
});
---

<Layout title={`${title} | Blog Decídelo.app`} description={description} robots={indexable ? 'index, follow' : 'noindex, follow'} schemaLD={schemaLD} showHomeHeader={false}>
  <main class="wrap">

    <!-- Breadcrumb -->
    <nav class="blog-breadcrumbs slide-up delay-1" aria-label="Breadcrumb">
      <a href="/">Inicio</a>
      <span class="separator">/</span>
      <a href="/blog">Blog</a>
      <span class="separator">/</span>
      <span class="current" aria-current="page">{title}</span>
    </nav>

    <!-- Post Article -->
    <article class="blog-post-card bg-surface border border-[var(--card-border)] rounded-lg p-10 max-[601px]:p-6 shadow-lg w-full max-w-[1120px] relative overflow-hidden slide-up delay-2">
      <header class="mb-8 max-[601px]:mb-6">
        <div class="flex gap-2 mb-[0.8rem] flex-wrap">
          {tags.map(tag => (
            <span class="tag-badge">#{tag}</span>
          ))}
        </div>
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <span class="post-author">Por <strong class="text-ink-primary">{author}</strong></span>
          <span class="text-ink-tertiary">•</span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {readingTime && (
            <>
              <span class="text-ink-tertiary">•</span>
              <span class="post-reading-time">⏱️ {readingTime} min de lectura</span>
            </>
          )}
          {updatedDate && (
            <>
              <span class="text-ink-tertiary">•</span>
              <span class="post-updated">Actualizado: {new Date(updatedDate).toLocaleDateString('es-ES')}</span>
            </>
          )}
        </div>
      </header>

      <AdSlot position="top" />

      <div class="grid grid-cols-1 min-[960px]:grid-cols-[1fr_280px] gap-12 mt-8">
        <!-- Columna Izquierda: Lectura -->
        <div class="min-w-0">
          {heroAsset ? (
            <div class="w-full max-h-[380px] rounded-md overflow-hidden mb-10 border border-[var(--card-border)]">
              <Picture
                src={heroAsset}
                alt={title}
                widths={[480, 800, 1200]}
                sizes="(max-width: 768px) 100vw, 800px"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </div>
          ) : heroImage ? (
            <div class="w-full max-h-[380px] rounded-md overflow-hidden mb-10 border border-[var(--card-border)]">
              <img src={heroImage} alt={title} loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          ) : null}

          <!-- Markdown Rendered Content -->
          <section class="post-content">
            <slot />
          </section>

          {editorialKit ? (
            <section class="field-guide" aria-labelledby="field-guide-title">
              <p class="field-label">Probado con Decídelo.app</p>
              <h2 id="field-guide-title">Guía práctica para aplicar esta idea</h2>
              <p>{editorialKit.testedUseCase}</p>

              <h3>Pasos recomendados</h3>
              <ol>
                {editorialKit.steps.map((step) => <li>{step}</li>)}
              </ol>

              <div class="my-5 p-5 border border-[rgba(255,255,255,0.08)] rounded-sm bg-[rgba(0,0,0,0.2)]">
                <h3>{editorialKit.templateTitle}</h3>
                <ul>
                  {editorialKit.templateItems.map((item) => <li>{item}</li>)}
                </ul>
                <a class="tool-cta" href={editorialKit.toolUrl}>Abrir {editorialKit.toolName}</a>
              </div>

              <h3>Errores comunes</h3>
              <ul>
                {editorialKit.mistakes.map((mistake) => <li>{mistake}</li>)}
              </ul>

              <h3>Preguntas frecuentes</h3>
              {editorialKit.faqs.map((faq) => (
                <details class="border-t border-[rgba(255,255,255,0.08)] py-3">
                  <summary class="cursor-pointer text-white font-bold">{faq.question}</summary>
                  <p class="mt-3 mb-0">{faq.answer}</p>
                </details>
              ))}

              <div class="related-links">
                <h3>Lecturas relacionadas</h3>
                {editorialKit.related.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
            </section>
          ) : (
            <section class="field-guide compact" aria-label="Nota editorial">
              <p class="field-label">Artículo en revisión editorial</p>
              <p>Esta guía sigue disponible para lectores directos, pero estamos reforzando el blog con casos prácticos, plantillas y ejemplos propios antes de volver a solicitar la revisión de AdSense.</p>
              <h3>Mientras tanto, evita estos errores</h3>
              <ul>
                {fallbackMistakes.map((mistake) => <li>{mistake}</li>)}
              </ul>
            </section>
          )}

          <footer class="mt-14 pt-6 border-t border-[rgba(255,255,255,0.06)]">
            <div class="post-footer-nav">
              <a href="/blog" class="btn-back-blog">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="19" y1="12" x2="5" y2="12"></line>
                  <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Volver al listado de artículos
              </a>
            </div>
          </footer>
        </div>

        <!-- Columna Derecha: Sidebar de Conversión -->
        <BlogSidebar />
      </div>
    </article>

    <AdSlot position="bottom" />

    <!-- Related tools section -->
    <section class="hub-section wrap">
      <div class="section-header reveal">
        <div class="section-tag">🎯 Toma una decisión</div>
        <h2 class="section-heading">Prueba nuestras herramientas gratuitas</h2>
      </div>
      <HubGrid />
    </section>

  </main>
</Layout>

<style>
  /* El selector de elemento "main" scopeado por Astro tiene más
     especificidad que la clase .wrap (atributo + tipo vs. solo clase), así
     que esta regla anula a propósito el padding horizontal de .wrap y dejа
     que sea el padding interno de .blog-post-card el que marque el margen.
     Migrarla a una utilidad (p. ej. py-8) rompe ese empate de especificidad
     a favor de .wrap y estrecha la columna de lectura: se queda en CSS. */
  main {
    padding: 2rem 0;
  }

  /* Breadcrumbs: fuera de la escala de Tailwind (0.8rem/250px), regla
     entera se queda en CSS para no partirla entre <style> y clases. */
  .blog-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    width: 100%;
    max-width: 820px;
    margin-bottom: 1.5rem;
  }

  .blog-breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition);
  }

  .blog-breadcrumbs a:hover {
    color: var(--accent-mint);
  }

  .blog-breadcrumbs .separator {
    color: var(--text-tertiary);
  }

  .blog-breadcrumbs .current {
    color: var(--text-primary);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 250px;
  }

  /* Barra superior en gradiente de la tarjeta del post. Pseudo-elemento con
     fondo en gradiente (--accent-gradient): no migra a utilidad. */
  .blog-post-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: var(--accent-gradient);
  }

  .tag-badge {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-mint);
    background: rgba(0, 242, 254, 0.06);
    border: 1px solid rgba(0, 242, 254, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    flex-wrap: wrap;
  }

  /* Tipografía fina: clamp() no tiene equivalente directo como utilidad. */
  .post-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .post-content {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  /* La tipografía del contenido Markdown vive en src/styles/blog-content.css:
     no está scopeada (viene del Markdown), así que no pinta nada aquí. */

  .field-guide {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid rgba(0, 242, 254, 0.18);
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(0, 242, 254, 0.05), rgba(179, 102, 255, 0.05));
    color: var(--text-secondary);
  }

  .field-guide.compact {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }

  .field-label {
    margin: 0 0 0.5rem;
    color: var(--accent-mint);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .field-guide h2,
  .field-guide h3 {
    font-family: 'Outfit', sans-serif;
    color: #ffffff;
  }

  .field-guide h2 {
    font-size: 1.45rem;
    margin-bottom: 0.85rem;
  }

  .field-guide h3 {
    font-size: 1.05rem;
    margin-top: 1.35rem;
    margin-bottom: 0.65rem;
  }

  /* p y li de field-guide vienen de varios .map() distintos (steps,
     mistakes, faqs, related): mover un solo line-height a seis puntos
     de marcado no vale la pena frente al riesgo de dejar uno sin tocar. */
  .field-guide p,
  .field-guide li {
    line-height: 1.7;
  }

  /* tool-cta: fondo en gradiente (--accent-gradient), se queda en CSS. */
  .tool-cta {
    display: inline-flex;
    margin-top: 0.75rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--accent-gradient);
    color: #050506;
    font-weight: 800;
    text-decoration: none;
  }

  .related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .related-links h3 {
    flex-basis: 100%;
    margin-bottom: 0;
  }

  .related-links a {
    color: var(--accent-mint);
    text-decoration: none;
    border-bottom: 1px dashed rgba(0, 242, 254, 0.45);
  }

  .btn-back-blog {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: var(--transition);
  }

  .btn-back-blog:hover {
    color: var(--accent-mint);
  }

  .btn-back-blog svg {
    transition: transform 0.2s ease;
  }

  .btn-back-blog:hover svg {
    transform: translateX(-3px);
  }

  /* Mismo caso que "main": el selector de clase scopeado por Astro
     (.hub-section + atributo) tiene más especificidad que .wrap y anula a
     propósito su padding horizontal. Una utilidad (pt-12/pb-4) pierde ese
     empate y deja pasar el padding de .wrap, estrechando el HubGrid. */
  .hub-section {
    padding: 3rem 0 1rem;
  }
</style>
