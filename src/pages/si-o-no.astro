---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import HubGrid from '../components/HubGrid.astro';
import SeoArticle from '../components/SeoArticle.astro';
import OracleBall from '../components/OracleBall.astro';
import { getSocialImageUrl } from '../lib/heroImages';

const title = 'Oráculo Sí o No Online — Tomar Decisiones Rápidas | Decídelo.app';
const description = 'Haz tu pregunta al oráculo místico de Sí o No. Escribe tu duda, presiona consultar y deja que la bola mágica tome una decisión por ti al instante.';
const keywords = 'oraculo si o no, bola magica si o no, bola 8 magica online, tomar decisiones gratis, decidir al azar, suerte, oraculo virtual';

// La imagen vive en src/assets y la optimiza Astro; el JSON-LD necesita
// su URL absoluta ya generada, no la ruta pública que tenía antes.
const socialImage = await getSocialImageUrl('/blog/si-o-no.png');

// Botón de texto: acción secundaria, subrayada, nunca rellena. Se repite en
// varios botones y así la lista de utilidades vive en un solo sitio.
const textBtn = 'bg-transparent border-0 border-b border-(--divider-line) rounded-none px-0 py-1 font-sans text-base text-ink-primary cursor-pointer hover:text-warm hover:border-current focus-visible:text-warm focus-visible:border-current focus-visible:outline-none aria-pressed:text-warm aria-pressed:border-current';

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://decidelo.app/si-o-no#webapp",
      "name": "Oráculo Sí o No Online — Decídelo.app",
      "description": "Oráculo interactivo virtual inspirado en la clásica bola 8 para resolver preguntas binarias (sí o no) con respuestas animadas y místicas.",
      "url": "https://decidelo.app/si-o-no",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript",
      "softwareVersion": "2.0.0",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "image": socialImage,
      "screenshot": socialImage,
      "publisher": {
        "@type": "Organization",
        "@id": "https://decidelo.app/#organization",
        "name": "Decídelo.app",
        "url": "https://decidelo.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://decidelo.app/favicon.svg"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://decidelo.app/si-o-no#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://decidelo.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Oráculo Sí o No",
          "item": "https://decidelo.app/si-o-no"
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} schemaLD={schemaLD} showHomeHeader={false}>
  <Fragment slot="head">
    {/* Newsreader itálica: acento del sistema editorial (ver DESIGN.md) */}
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  {/* El orden del HTML es el de móvil. Desde 1024px, dos columnas: a la
      izquierda lo que se escribe, a la derecha la bola y el botón; así en
      un portátil de 720px el botón no queda fuera de pantalla. */}
  <main class="wrap max-w-2xl lg:max-w-5xl pt-5 pb-8 sm:pt-8 lg:grid lg:grid-cols-2 lg:grid-rows-[auto_auto_1fr] lg:gap-x-16 lg:items-start">

    <div class="w-full text-center lg:text-left mb-4 sm:mb-6 lg:col-start-1 lg:row-start-1">
      <h1 class="m-0 mb-2 sm:mb-4 font-display text-[1.7rem] sm:text-5xl lg:text-[2.75rem] leading-tight tracking-tight">Oráculo <em class="font-[Newsreader,Georgia,serif] italic font-normal text-warm">sí o no</em></h1>
      {/* En pantallas bajas la entradilla cede su sitio al botón */}
      <p class="m-0 mx-auto lg:mx-0 max-w-lg text-sm sm:text-base text-ink-secondary max-sm:[@media(max-height:620px)]:hidden">Escribe una pregunta que se responda con sí o no y consulta a la bola 8. En el móvil también puedes agitarlo.</p>
    </div>

    <label class="flex flex-col gap-1.5 w-full mb-3 sm:mb-6 lg:mt-4 lg:col-start-1 lg:row-start-2">
      <span class="text-xs font-semibold tracking-widest uppercase text-ink-tertiary">Tu pregunta</span>
      <input id="oracle-question" type="text" maxlength="120" enterkeyhint="go" placeholder="¿Pido pizza esta noche?" autocomplete="off" class="w-full min-w-0 bg-transparent border-0 border-b border-(--divider-line) rounded-none px-0 py-1.5 font-sans text-lg text-ink-primary placeholder:text-ink-tertiary focus:outline-none focus:border-warm">
    </label>

    <section class="w-full flex flex-col items-center lg:col-start-2 lg:row-start-1 lg:row-span-3 lg:pt-8" aria-label="Consultar al oráculo">
      <OracleBall />

      <p class="oracle-result w-full text-center min-h-14 sm:min-h-18 mt-1 mb-2 sm:mt-3 sm:mb-4" id="oracle-result" aria-live="polite">
        <span class="block font-display font-bold text-[1.7rem] sm:text-4xl leading-tight text-ink-primary [overflow-wrap:anywhere]" id="oracle-result-main"></span>
        <span class="block mt-0.5 sm:mt-1.5 text-xs tracking-widest uppercase text-ink-tertiary" id="oracle-result-side"></span>
      </p>

      <button id="btn-ask" type="button" class="px-9 py-3.5 border-0 rounded-full bg-warm text-[#1a0e06] font-display font-bold text-lg cursor-pointer transition-transform duration-150 active:scale-95 disabled:opacity-55 disabled:cursor-default focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-warm">Consultar al oráculo</button>

      {/* Después de la respuesta: la prueba del alivio y compartir */}
      <div id="oracle-after" class="flex flex-col items-center gap-3 mt-6 w-full" hidden>
        <div id="oracle-gut" class="flex flex-col items-center gap-2">
          <p class="m-0 text-sm text-ink-secondary">¿Qué sentiste al leerlo?</p>
          <div class="flex gap-6">
            <button class={textBtn} id="gut-relief" type="button">Alivio</button>
            <button class={textBtn} id="gut-disappoint" type="button">Decepción</button>
          </div>
          <p class="oracle-gut-msg m-0 max-w-sm text-center text-ink-primary" id="gut-msg" aria-live="polite"></p>
          <button class="bg-transparent border-0 p-1 font-sans text-xs text-ink-tertiary cursor-pointer hover:text-warm" id="gut-off" type="button">No preguntar más</button>
        </div>
        <button class={textBtn} id="btn-share" type="button">Compartir esta pregunta</button>
      </div>

      {/* Solo en móviles con sensor de movimiento; el JS lo muestra */}
      <div id="oracle-shake" class="flex flex-col items-center gap-1 mt-6 w-full" hidden>
        <button class={textBtn} id="btn-shake" type="button" aria-pressed="false">Agitar el móvil para consultar</button>
        <p class="m-0 max-w-xs text-center text-xs text-ink-tertiary" id="shake-msg" aria-live="polite"></p>
      </div>
    </section>

    <section class="w-full mt-12 sm:mt-16 lg:mt-10 lg:col-start-1 lg:row-start-3" aria-label="Historial de consultas al oráculo">
      <div class="flex flex-wrap items-baseline gap-4 pb-3 border-0 border-b border-(--divider-line)">
        <h2 class="m-0 font-display text-lg">Últimas consultas</h2>
        <span class="flex-1 text-sm text-ink-tertiary tabular-nums" id="history-count"></span>
        <button class="bg-transparent border-0 border-b border-current rounded-none p-0 font-sans text-sm text-ink-secondary cursor-pointer hover:text-warm" id="btn-clear" type="button">Borrar</button>
      </div>
      <ol class="oracle-history list-none m-0 p-0" id="history-list">
        <li class="history-empty">Sin consultas aún</li>
      </ol>
    </section>

  </main>

  <AdSlot position="top" />

  <SeoArticle title="Oráculo Sí o No: ¿Cómo utilizarlo para destrabar tus decisiones cotidianas?">
    <p>A lo largo de la historia, la humanidad ha buscado métodos para reducir la incertidumbre del porvenir y facilitar la toma de decisiones difíciles. Desde el milenario oráculo de Delfos en Grecia, las lecturas del I Ching en Oriente, hasta los juegos lúdicos modernos como la clásica <strong>Bola 8 Mágica</strong> (Magic 8-Ball) patentada en los años 50 en Estados Unidos. El deseo de obtener una respuesta clara y binaria (Sí o No) es un reflejo de nuestra necesidad de superar la procrastinación y la parálisis decisional.</p>
    
    <p>Nuestra versión del <strong>Oráculo de Sí o No Virtual</strong> fusiona la psicología de la toma de decisiones con una experiencia visual inmersiva. No pretendemos predecir el futuro de manera mística, sino proporcionarte un espejo cognitivo e interactivo.</p>

    <h2>La Psicología del Oráculo: Descubriendo tu Verdadera Preferencia</h2>
    <p>¿Funciona realmente el oráculo para tomar una decisión seria? Curiosamente, los psicólogos señalan que las herramientas de azar actúan como catalizadores de nuestra <strong>intuición inconsciente</strong>. Cuando delegas una decisión importante en un elemento externo y el oráculo te responde con un rotundo "No", tu cerebro procesa instantáneamente una reacción afectiva:</p>
    <ul>
      <li><strong>Alivio:</strong> Si sientes tranquilidad al ver el resultado negativo, confirmas que esa era la opción adecuada.</li>
      <li><strong>Decepción/Frustración:</strong> Si al leer un "No" sientes un deseo inmediato de volver a consultar o te enojas con la respuesta, tu mente te está indicando con absoluta certeza que <strong>en realidad querías un Sí</strong>.</li>
    </ul>
    <p>De este modo, forzar una respuesta aleatoria binaria desbloquea lo que tus emociones ya sabían, pero tu razonamiento analítico bloqueaba por exceso de dudas.</p>

    <h2>Cómo funciona este oráculo</h2>
    <p>La bola se agita y el dado emerge con una de las <strong>15 respuestas clásicas de la bola 8</strong>: cinco afirmativas, cinco negativas y cinco que no se comprometen. Cada respuesta sale del generador aleatorio criptográfico del navegador (<code>crypto.getRandomValues</code>), así que ninguna es más probable que otra y ninguna depende de la anterior. En el móvil puedes activar &laquo;Agitar para consultar&raquo; y preguntar sacudiendo el teléfono, como con la bola de verdad.</p>
    <p>Cuando la respuesta es un sí o un no, el oráculo te pregunta qué sentiste al leerla: alivio o decepción. Esa reacción es la pista de lo que ya preferías. Tu pregunta y el historial se quedan solo en tu navegador.</p>
  </SeoArticle>

  <AdSlot position="bottom" />

  <section class="hub-section wrap">
    <div class="section-header reveal">
      <div class="section-tag">🧰 Caja de Herramientas</div>
      <h2 class="section-heading">Prueba otras herramientas de decisión</h2>
    </div>
    <HubGrid activeToolId="si-o-no" />
  </section>

  <script src="../scripts/si-o-no.js"></script>
</Layout>

<style>
  /* Solo queda aquí lo que no puede ser utilidad: los estados que pone el
     JS y las filas que crea (Tailwind no rastrea src/scripts/). El resto
     de la página va en utilidades en el propio marcado. */

  /* El sitio no carga el preflight de Tailwind, así que nada gana a `.flex`
     cuando el JS pone `hidden`: sin esto, los bloques ocultos se verían */
  [hidden] {
    display: none !important;
  }

  /* La respuesta se enfoca al aparecer, como el dado dentro de la bola */
  .oracle-result {
    opacity: 0;
    transform: translateY(8px);
    filter: blur(6px);
    transition: opacity 0.35s ease-out, transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), filter 0.35s ease-out;
  }

  .oracle-result.is-shown {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .oracle-gut-msg:empty {
    display: none;
  }

  .oracle-gut-msg :global(em) {
    font-family: 'Newsreader', Georgia, serif;
    font-style: italic;
    color: var(--accent-warm);
  }

  /* Historial: lista dividida por líneas de 1px. En móvil la respuesta va
     debajo de la pregunta; desde 640px, en su columna. */
  .oracle-history :global(.history-row) {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 0.75rem;
    row-gap: 0.2rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--divider-line);
  }

  .oracle-history :global(.history-num) {
    grid-row: span 2;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
  }

  .oracle-history :global(.history-label) {
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .oracle-history :global(.history-side) {
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }

  .oracle-history :global(.history-row.is-new) {
    animation: oracle-row-in 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  @keyframes oracle-row-in {
    from { opacity: 0; transform: translateY(-6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .oracle-result { transform: none; filter: none; }
    .oracle-history :global(.history-row.is-new) { animation: none; }
  }

  .oracle-history :global(.history-empty) {
    padding: 0.8rem 0;
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  @media (min-width: 640px) {
    .oracle-history :global(.history-row) {
      grid-template-columns: 2.5rem 1fr auto;
      column-gap: 1rem;
    }

    .oracle-history :global(.history-num) {
      grid-row: auto;
    }

    .oracle-history :global(.history-side) {
      text-align: right;
    }
  }

  .hub-section {
    padding: 3rem 0;
  }
</style>
