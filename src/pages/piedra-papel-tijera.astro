---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import HubGrid from '../components/HubGrid.astro';
import SeoArticle from '../components/SeoArticle.astro';
import PptHands from '../components/PptHands.astro';
import HandShape from '../components/HandShape.astro';
import { getSocialImageUrl } from '../lib/heroImages';

const title = 'Piedra, Papel o Tijera Online — Juego Gratis PvP y vs IA | Decídelo.app';
const description = 'Juega Piedra, Papel o Tijera online gratis contra la IA o en modo 2 jugadores local. Sin registro y sin distracciones: resuelve disputas al instante.';
const keywords = 'piedra papel tijera, piedra papel o tijera online, juego ppt, rps online, decidir al azar, juego gratis, pvp local, vs ia, decidelo';

// La imagen vive en src/assets y la optimiza Astro; el JSON-LD necesita
// su URL absoluta ya generada, no la ruta pública que tenía antes.
const socialImage = await getSocialImageUrl('/blog/piedra-papel-tijera.png');

// Botón de texto: acción secundaria, subrayada, nunca rellena (igual que
// en si-o-no.astro).
const textBtn = 'bg-transparent border-0 border-b border-(--divider-line) rounded-none px-0 py-1 font-sans text-base text-ink-secondary cursor-pointer hover:text-warm hover:border-current focus-visible:text-warm focus-visible:border-current focus-visible:outline-none aria-pressed:text-ink-primary aria-pressed:border-warm';

const ELECCIONES = [
  { forma: 'piedra', nombre: 'Piedra' },
  { forma: 'papel', nombre: 'Papel' },
  { forma: 'tijera', nombre: 'Tijera' },
] as const;

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://decidelo.app/piedra-papel-tijera#webapp",
      "name": "Piedra, Papel o Tijera Online — Decídelo.app",
      "description": "Juego interactivo de Piedra, Papel o Tijera con modo 1 jugador contra IA y modo 2 jugadores local. Las jugadas se ocultan hasta que ambos eligen.",
      "url": "https://decidelo.app/piedra-papel-tijera",
      "applicationCategory": "GameApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript and CSS3 Animations",
      "softwareVersion": "2.0.0",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "image": socialImage,
      "screenshot": socialImage,
      "publisher": {
        "@type": "Organization",
        "@id": "https://decidelo.app/#organization",
        "name": "Decídelo.app",
        "url": "https://decidelo.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://decidelo.app/favicon.svg"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://decidelo.app/piedra-papel-tijera#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://decidelo.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Piedra, Papel o Tijera",
          "item": "https://decidelo.app/piedra-papel-tijera"
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} schemaLD={schemaLD} showHomeHeader={false}>
  <Fragment slot="head">
    {/* Newsreader itálica: acento del sistema editorial (ver DESIGN.md) */}
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  {/* El orden del HTML es el de móvil: manos, resultado y las tres jugadas
      arriba; modo y nombres debajo. Desde 1024px, dos columnas: a la
      izquierda el título, los ajustes y el historial; a la derecha el
      juego, así en un portátil de 720px las jugadas no quedan fuera. */}
  <main class="wrap max-w-2xl lg:max-w-5xl pt-5 pb-8 sm:pt-8 lg:grid lg:grid-cols-2 lg:grid-rows-[auto_auto_1fr] lg:gap-x-16 lg:items-start">

    <div class="w-full text-center lg:text-left mb-4 sm:mb-6 lg:col-start-1 lg:row-start-1">
      <h1 class="m-0 mb-2 sm:mb-4 font-display text-[1.7rem] sm:text-5xl lg:text-[2.75rem] leading-tight tracking-tight">Piedra, papel <em class="font-[Newsreader,Georgia,serif] italic font-normal text-warm">o tijera</em></h1>
      {/* En pantallas bajas la entradilla cede su sitio a las jugadas */}
      <p class="m-0 mx-auto lg:mx-0 max-w-lg text-sm sm:text-base text-ink-secondary max-sm:[@media(max-height:620px)]:hidden">Juega contra la máquina, con alguien en el mismo móvil o a distancia por WhatsApp. Y si hay algo que decidir, que lo pague quien pierda.</p>
    </div>

    <section class="w-full flex flex-col items-center lg:col-start-2 lg:row-start-1 lg:row-span-3 lg:pt-8" aria-label="Jugar a piedra, papel o tijera">
      <PptHands />

      <p class="ppt-result w-full text-center min-h-14 sm:min-h-18 mt-2 mb-2 sm:mt-3 sm:mb-4" id="ppt-result" aria-live="polite">
        <span class="block font-display font-bold text-[1.7rem] sm:text-4xl leading-tight text-ink-primary [overflow-wrap:anywhere]" id="ppt-result-main"></span>
        {/* Lo que se decidía, en palabras del usuario: «Luis: lava los platos» */}
        <span class="ppt-result-stake block mt-1 text-base sm:text-lg text-ink-primary [overflow-wrap:anywhere]" id="ppt-result-stake"></span>
        <span class="block mt-0.5 sm:mt-1.5 text-xs tracking-widest uppercase text-ink-tertiary" id="ppt-result-side"></span>
      </p>

      {/* Con dos jugadores: qué se decide. Junto a la acción, no en un
          formulario aparte, igual que los nombres bajo las manos */}
      <label class="ppt-stake flex items-baseline justify-center gap-2 w-full max-w-sm mb-3" id="ppt-stake" hidden>
        <span class="shrink-0 text-sm text-ink-secondary">Quien pierda</span>
        <input class="ppt-stake-input" id="ppt-stake-input" type="text" maxlength="60" placeholder="lava los platos" autocomplete="off" enterkeyhint="done">
      </label>

      <p class="m-0 mb-2 text-sm text-ink-secondary text-center [overflow-wrap:anywhere]" id="ppt-turn" aria-live="polite">Elige tu jugada</p>

      {/* Acción principal: una de tres jugadas. Tres botones iguales en vez
          de una píldora rellena (ver DESIGN.md, "Acción principal de
          varias opciones") */}
      <div class="grid grid-cols-3 gap-2 sm:gap-3 w-full max-w-sm" id="ppt-choices" role="group" aria-label="Tu jugada">
        {ELECCIONES.map(({ forma, nombre }) => (
          <button type="button" class="ppt-choice" data-choice={forma}>
            <HandShape frame={forma === 'piedra' ? forma : `${forma}-6`} class="ppt-choice-icon" sizes="2.75rem" />
            <span>{nombre}</span>
          </button>
        ))}
      </div>

      {/* Dos jugadores: entre turno y turno las jugadas se ocultan, para
          que al pasar el móvil no quede ningún rastro de la del primero */}
      <div class="ppt-handoff flex flex-col items-center justify-center w-full max-w-sm" id="ppt-handoff" hidden>
        <button type="button" class="ppt-pass" id="btn-pass">Elegir</button>
      </div>

      {/* A distancia: enviar el reto o devolver el resultado por WhatsApp */}
      <div class="ppt-handoff flex flex-col items-center justify-center gap-3 w-full max-w-sm" id="ppt-share" hidden>
        <button type="button" class="ppt-pass" id="btn-share">Enviar por WhatsApp</button>
        <div class="flex gap-6">
          <button class={textBtn} type="button" id="btn-copy">Copiar enlace</button>
          <button class={textBtn} type="button" id="btn-new">Nuevo reto</button>
        </div>
        <p class="m-0 text-xs text-ink-tertiary text-center" id="ppt-share-msg" aria-live="polite"></p>
      </div>
    </section>

    <div class="w-full flex flex-col items-center lg:items-start gap-4 mt-8 lg:mt-4 lg:col-start-1 lg:row-start-2">
      <div class="flex flex-wrap justify-center lg:justify-start gap-x-6 gap-y-2" role="group" aria-label="Modo de juego">
        <button class={textBtn} type="button" data-mode="maquina" aria-pressed="true">Contra la máquina</button>
        <button class={textBtn} type="button" data-mode="dos" aria-pressed="false">En el mismo móvil</button>
        <button class={textBtn} type="button" data-mode="distancia" aria-pressed="false">A distancia</button>
      </div>
    </div>

    <section class="w-full mt-12 sm:mt-16 lg:mt-10 lg:col-start-1 lg:row-start-3" aria-label="Historial de rondas">
      <div class="flex flex-wrap items-baseline gap-4 pb-3 border-0 border-b border-(--divider-line)">
        <h2 class="m-0 font-display text-lg">Últimas rondas</h2>
        <span class="flex-1 text-sm text-ink-tertiary tabular-nums" id="history-count"></span>
        <button class="bg-transparent border-0 border-b border-current rounded-none p-0 font-sans text-sm text-ink-secondary cursor-pointer hover:text-warm" id="btn-clear" type="button">Borrar</button>
      </div>
      <ol class="ppt-history list-none m-0 p-0" id="history-list">
        <li class="history-empty">Sin rondas aún</li>
      </ol>
    </section>

  </main>

  <AdSlot position="top" />

  <SeoArticle title="¿Cómo se juega Piedra, Papel o Tijera? Reglas, Estrategia y Psicología">
    <p><strong>Piedra, Papel o Tijera</strong> (también conocido como <em>cachipún</em>, <em>jan-ken-pon</em> o <em>roshambo</em>) es uno de los juegos de mano más universales del planeta. Utilizado desde hace siglos para resolver disputas rápidas, asignar turnos o simplemente divertirse, este juego de suma cero ha fascinado tanto a matemáticos como a psicólogos por su aparente simplicidad y su sorprendente profundidad estratégica.</p>

    <h2>Reglas Fundamentales del Juego</h2>
    <p>Las reglas son elegantemente simples y se aprenden en segundos:</p>
    <ul>
      <li><strong>Piedra</strong> (puño cerrado) aplasta a <strong>Tijera</strong>.</li>
      <li><strong>Tijera</strong> (gesto en V) corta a <strong>Papel</strong>.</li>
      <li><strong>Papel</strong> (mano abierta) envuelve a <strong>Piedra</strong>.</li>
      <li>Si ambos jugadores eligen lo mismo, es un <strong>empate</strong> y se repite la ronda.</li>
    </ul>
    <p>Cada opción vence a exactamente una de las otras y pierde contra la restante, creando un ciclo perfecto de dominancia sin jerarquía absoluta. Matemáticamente, esto se modela como un <strong>juego no transitivo</strong>.</p>

    <h2>Historia y Orígenes</h2>
    <p>Aunque muchos creen que el juego es de origen japonés (<em>jan-ken</em>), sus raíces se remontan a la <strong>dinastía Han</strong> en China (aproximadamente 200 a.C.), donde se le conocía como <em>shǒushìlìng</em> (juego de gestos con la mano). Llegó a Japón en el siglo XVII y desde allí se extendió globalmente durante el siglo XX, convirtiéndose en un fenómeno cultural universal.</p>
    <p>Hoy en día existen <strong>torneos profesionales internacionales</strong> con premios en efectivo, como el Campeonato Mundial de la World RPS Society, lo que demuestra que incluso un juego aparentemente simple puede alcanzar niveles competitivos serios.</p>

    <h2>Estrategias Psicológicas Avanzadas</h2>
    <p>Aunque en teoría la estrategia óptima es elegir de forma completamente aleatoria (distribución uniforme 1/3 para cada opción), los humanos somos <strong>terriblemente malos generando aleatoriedad</strong>. Estudios de la Universidad de Zhejiang analizaron más de 300 rondas por participante y descubrieron patrones predecibles:</p>
    <ul>
      <li><strong>Efecto "ganador repite":</strong> Los jugadores que ganan una ronda tienden a repetir la misma elección en la siguiente con una frecuencia significativamente superior al 33%.</li>
      <li><strong>Efecto "perdedor escala":</strong> Quienes pierden tienden a cambiar a la siguiente opción en el ciclo (de Piedra pasan a Papel, de Papel a Tijera, etc.).</li>
      <li><strong>Sesgo inicial hacia Piedra:</strong> En la primera ronda, los jugadores inexpertos eligen Piedra con mayor frecuencia (~36%), posiblemente por la asociación instintiva del puño con la fuerza.</li>
    </ul>
    <p>Conocer estos sesgos te permite anticipar la jugada de tu oponente y elegir estratégicamente en consecuencia. Por ejemplo: si tu oponente acaba de perder con Tijera, probablemente elegirá Piedra en la siguiente ronda, así que tú deberías elegir Papel.</p>

    <h2>¿Por qué usar la versión digital?</h2>
    <p>Nuestra herramienta de <strong>Piedra, Papel o Tijera online</strong> resuelve varios problemas comunes del juego presencial:</p>
    <ul>
      <li><strong>Eliminación de trampas:</strong> En el modo 2 jugadores, cada jugador elige por turnos en el mismo móvil y su jugada no se ve hasta que los dos han elegido, así que nadie puede reaccionar a la del otro.</li>
      <li><strong>Una máquina de verdad aleatoria:</strong> En el modo contra la máquina, su jugada sale del generador criptográfico del navegador (<code>crypto.getRandomValues</code>), con la misma probabilidad para piedra, papel y tijera y sin los sesgos humanos de arriba.</li>
      <li><strong>Registro de puntuación:</strong> El marcador se guarda automáticamente en tu navegador, permitiéndote llevar un historial de tu rendimiento sin necesidad de papel ni memoria.</li>
      <li><strong>Accesibilidad universal:</strong> Funciona en cualquier dispositivo con navegador, sin instalaciones y sin registro.</li>
    </ul>
  </SeoArticle>

  <AdSlot position="bottom" />

  <section class="hub-section wrap">
    <div class="section-header reveal">
      <div class="section-tag">🧰 Caja de Herramientas</div>
      <h2 class="section-heading">Prueba otras herramientas de decisión</h2>
    </div>
    <HubGrid activeToolId="piedra-papel-tijera" />
  </section>

  <script src="../scripts/piedra-papel-tijera.js"></script>
</Layout>

<style>
  /* Solo queda aquí lo que no puede ser utilidad: los botones de jugada
     (estados y color literal en una sola regla), los estados que pone el JS
     y las filas que crea (Tailwind no rastrea src/scripts/). */

  /* El sitio no carga el preflight de Tailwind: sin esto, `.grid` ganaría
     a `hidden` */
  [hidden] {
    display: none !important;
  }

  .ppt-choice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.6rem 0.25rem 0.7rem;
    border: 1px solid var(--divider-line);
    border-radius: 999px;
    background: transparent;
    color: var(--text-primary);
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s, transform 0.15s;
  }

  /* Solo con ratón: en un móvil el :hover de un toque se queda pegado y,
     con dos jugadores, delataría la jugada del primero */
  @media (hover: hover) {
    .ppt-choice:hover {
      color: var(--accent-warm);
      border-color: var(--accent-warm);
    }
  }

  .ppt-choice:focus-visible {
    color: var(--accent-warm);
    border-color: var(--accent-warm);
    outline: none;
  }

  .ppt-choice:active {
    transform: scale(0.95);
  }

  /* La jugada elegida se rellena del acento mientras dura la ronda */
  .ppt-choice[aria-pressed="true"] {
    background: var(--accent-warm);
    border-color: var(--accent-warm);
    color: #1a0e06;
  }

  .ppt-result-stake:empty,
  #ppt-share-msg:empty {
    display: none;
  }

  /* Campo en línea, subrayado, 16px para que Safari no haga zoom */
  .ppt-stake-input {
    flex: 1;
    min-width: 0;
    padding: 0.1rem 0;
    border: 0;
    border-bottom: 1px solid var(--text-tertiary);
    border-radius: 0;
    background: transparent;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 1rem;
  }

  .ppt-stake-input::placeholder {
    color: var(--text-tertiary);
  }

  .ppt-stake-input:focus {
    outline: none;
    border-bottom-color: var(--accent-warm);
  }

  /* Mismo alto que la fila de jugadas: al alternar no salta la página */
  .ppt-handoff {
    min-height: 5.6rem;
  }

  .ppt-pass {
    padding: 0.9rem 2.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent-warm);
    color: #1a0e06;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.125rem;
    cursor: pointer;
    transition: transform 0.15s;
  }

  .ppt-pass:active {
    transform: scale(0.95);
  }

  .ppt-pass:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 3px;
  }

  .ppt-choice:disabled {
    cursor: default;
  }

  /* Solo se apaga el texto: con opacidad sobre el fondo oscuro la mano
     parecería de otro tono de piel */
  .ppt-choice:disabled:not([aria-pressed="true"]) {
    color: var(--text-tertiary);
  }

  /* El <picture> lo pinta HandShape.astro, fuera del alcance de esta página */
  .ppt-choice :global(.ppt-choice-icon),
  .ppt-choice :global(.ppt-choice-icon img) {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
  }

  /* El resultado se enfoca al aparecer, cuando las manos ya se ven */
  .ppt-result {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease-out, transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .ppt-result.is-shown {
    opacity: 1;
    transform: none;
  }

  /* Historial: lista dividida por líneas de 1px. En móvil el ganador va
     debajo de la jugada; desde 640px, en su columna. */
  .ppt-history :global(.history-row) {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: 0.75rem;
    row-gap: 0.2rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--divider-line);
  }

  .ppt-history :global(.history-num) {
    grid-row: span 2;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
  }

  .ppt-history :global(.history-label) {
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .ppt-history :global(.history-side) {
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }

  .ppt-history :global(.history-row.is-new) {
    animation: ppt-row-in 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  @keyframes ppt-row-in {
    from { opacity: 0; transform: translateY(-6px); }
  }

  .ppt-history :global(.history-empty) {
    padding: 0.8rem 0;
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ppt-result { transform: none; }
    .ppt-history :global(.history-row.is-new) { animation: none; }
  }

  @media (min-width: 640px) {
    .ppt-history :global(.history-row) {
      grid-template-columns: 2.5rem 1fr auto;
      column-gap: 1rem;
    }

    .ppt-history :global(.history-num) {
      grid-row: auto;
    }

    .ppt-history :global(.history-side) {
      text-align: right;
    }
  }

  .hub-section {
    padding: 3rem 0;
  }
</style>
