---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import HubGrid from '../components/HubGrid.astro';
import SeoArticle from '../components/SeoArticle.astro';
import PptHands from '../components/PptHands.astro';
import HandShape from '../components/HandShape.astro';
import PptModoDemo from '../components/PptModoDemo.astro';
import { getSocialImageUrl } from '../lib/heroImages';

const title = 'Piedra, Papel o Tijera Online: Juega Gratis y Sin Registro';
const description = '¿Quién lava los platos? Juega piedra, papel o tijera online contra la máquina, en el mismo móvil o a distancia por WhatsApp. Gratis y sin registro.';
const keywords = 'piedra papel o tijera, piedra papel o tijera online, jugar piedra papel o tijera, piedra papel tijera 2 jugadores, piedra papel o tijera contra la máquina, cachipún, yan ken po, jankenpon';

// La imagen vive en src/assets y la optimiza Astro; el JSON-LD necesita
// su URL absoluta ya generada, no la ruta pública que tenía antes.
const socialImage = await getSocialImageUrl('/blog/piedra-papel-tijera.png');

// Botón de texto: acción secundaria, subrayada, nunca rellena (igual que
// en si-o-no.astro).
const textBtn = 'bg-transparent border-0 border-b border-(--divider-line) rounded-none px-0 py-1 font-sans text-base text-ink-secondary cursor-pointer hover:text-warm hover:border-current focus-visible:text-warm focus-visible:border-current focus-visible:outline-none aria-pressed:text-ink-primary aria-pressed:border-warm';

const ELECCIONES = [
  { forma: 'piedra', nombre: 'Piedra' },
  { forma: 'papel', nombre: 'Papel' },
  { forma: 'tijera', nombre: 'Tijera' },
] as const;

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://decidelo.app/piedra-papel-tijera#webapp",
      "name": "Piedra, Papel o Tijera Online — Decídelo.app",
      "description": "Juego interactivo de Piedra, Papel o Tijera con modo 1 jugador contra IA y modo 2 jugadores local. Las jugadas se ocultan hasta que ambos eligen.",
      "url": "https://decidelo.app/piedra-papel-tijera",
      "applicationCategory": "GameApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript and CSS3 Animations",
      "softwareVersion": "2.0.0",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "image": socialImage,
      "screenshot": socialImage,
      "publisher": {
        "@type": "Organization",
        "@id": "https://decidelo.app/#organization",
        "name": "Decídelo.app",
        "url": "https://decidelo.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://decidelo.app/favicon.svg"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://decidelo.app/piedra-papel-tijera#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://decidelo.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Piedra, Papel o Tijera",
          "item": "https://decidelo.app/piedra-papel-tijera"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://decidelo.app/piedra-papel-tijera#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo se juega a piedra, papel o tijera?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cada jugador elige a la vez piedra, papel o tijera. La piedra gana a la tijera, la tijera gana al papel y el papel gana a la piedra. Si los dos eligen lo mismo, es empate y se repite la ronda."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo jugar piedra, papel o tijera con otra persona en el mismo móvil?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Elige el modo «Mismo móvil»: primero elige un jugador, pasa el móvil y elige el otro. Las jugadas se ocultan entre turno y turno y solo se muestran cuando los dos han elegido."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo juego a distancia con un amigo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Elige el modo «A distancia», escribe tu nombre y el de tu amigo, elige tu jugada y pulsa «Enviar reto por WhatsApp». Tu amigo abre el enlace, elige su jugada y te puede devolver el resultado por el mismo camino."
          }
        },
        {
          "@type": "Question",
          "name": "¿La máquina hace trampa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La máquina elige con el generador aleatorio del navegador, crypto.getRandomValues, y no mira tu jugada: piedra, papel y tijera tienen la misma probabilidad en cada ronda."
          }
        },
        {
          "@type": "Question",
          "name": "¿Existe una estrategia para ganar siempre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Contra alguien que elige al azar, no: ninguna jugada es mejor que otra. Contra personas sí hay tendencias, como repetir la jugada después de ganar y cambiar después de perder, según un experimento de la Universidad de Zhejiang con 360 estudiantes."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se llama este juego en otros países?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende del país: cachipún en Chile, yan ken po en Perú, jankenpon en Paraguay y janken en Japón."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} schemaLD={schemaLD} showHomeHeader={false}>
  <Fragment slot="head">
    {/* Newsreader itálica: acento del sistema editorial (ver DESIGN.md) */}
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  {/* El orden del HTML es el de móvil: título y modo, manos, resultado y
      las tres jugadas. Desde 1024px, dos columnas: a la
      izquierda el título, los ajustes y el historial; a la derecha el
      juego, así en un portátil de 720px las jugadas no quedan fuera. */}
  <main class="wrap max-w-2xl lg:max-w-5xl pt-5 pb-8 sm:pt-8 lg:grid lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-x-16 lg:items-start">

    <div class="w-full text-center lg:text-left mb-4 sm:mb-6 lg:col-start-1 lg:row-start-1">
      <h1 class="m-0 mb-2 sm:mb-4 font-display text-[1.7rem] sm:text-5xl lg:text-[2.75rem] leading-tight tracking-tight">Piedra, papel <em class="font-[Newsreader,Georgia,serif] italic font-normal text-warm">o tijera</em></h1>
      {/* En pantallas bajas la entradilla cede su sitio a las jugadas */}
      <p class="m-0 mx-auto lg:mx-0 max-w-lg text-sm sm:text-base text-ink-secondary max-sm:[@media(max-height:620px)]:hidden">Para jugar, o para decidir quién hace qué.</p>
      {/* El modo es lo primero que se decide: arriba, en una sola pieza */}
      <div class="ppt-modes mt-4" role="group" aria-label="Modo de juego">
        <button type="button" data-mode="maquina" aria-pressed="true">Máquina</button>
        <button type="button" data-mode="dos" aria-pressed="false">Mismo móvil</button>
        <button type="button" data-mode="distancia" aria-pressed="false">A distancia</button>
      </div>
    </div>

    <section id="jugar" class="w-full flex flex-col items-center lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:pt-8" aria-label="Jugar a piedra, papel o tijera">
      <PptHands />

      <p class="ppt-result w-full text-center mt-2 mb-1 sm:mt-3 sm:mb-2" id="ppt-result" aria-live="polite">
        <span class="block font-display font-bold text-[1.7rem] sm:text-4xl leading-tight text-ink-primary [overflow-wrap:anywhere]" id="ppt-result-main"></span>
        {/* Lo que se decidía, en palabras del usuario: «Luis: lava los platos» */}
        <span class="ppt-result-stake block mt-1 text-base sm:text-lg text-ink-primary [overflow-wrap:anywhere]" id="ppt-result-stake"></span>
        <span class="block mt-0.5 sm:mt-1.5 text-xs tracking-widest uppercase text-ink-tertiary" id="ppt-result-side"></span>
      </p>

      {/* Con dos jugadores: qué se decide. Junto a la acción, no en un
          formulario aparte, igual que los nombres bajo las manos */}
      <button type="button" class="ppt-stake-open" id="btn-stake" hidden>+ ¿Qué se decide?</button>
      <label class="ppt-stake flex items-baseline justify-center gap-2 w-full max-w-sm mt-4 mb-3" id="ppt-stake" hidden>
        <span class="shrink-0 text-sm text-ink-secondary">Quien pierda</span>
        <input class="ppt-stake-input" id="ppt-stake-input" type="text" maxlength="60" placeholder="lava los platos" autocomplete="off" enterkeyhint="done">
      </label>

      <p class="m-0 mb-2 text-sm text-ink-secondary text-center [overflow-wrap:anywhere]" id="ppt-turn" aria-live="polite">Elige tu jugada</p>

      {/* Acción principal: una de tres jugadas. Tres botones iguales en vez
          de una píldora rellena (ver DESIGN.md, "Acción principal de
          varias opciones") */}
      <div class="grid grid-cols-3 gap-2 sm:gap-3 w-full max-w-sm" id="ppt-choices" role="group" aria-label="Tu jugada">
        {ELECCIONES.map(({ forma, nombre }) => (
          <button type="button" class="ppt-choice" data-choice={forma}>
            <HandShape frame={forma === 'piedra' ? forma : `${forma}-6`} class="ppt-choice-icon" sizes="2.75rem" />
            <span>{nombre}</span>
          </button>
        ))}
      </div>

      {/* Dos jugadores: entre turno y turno las jugadas se ocultan, para
          que al pasar el móvil no quede ningún rastro de la del primero */}
      <div class="ppt-handoff flex flex-col items-center justify-center w-full max-w-sm" id="ppt-handoff" hidden>
        <button type="button" class="ppt-pass" id="btn-pass">Elegir</button>
      </div>

      {/* A distancia: enviar el reto o devolver el resultado por WhatsApp */}
      <div class="ppt-handoff flex flex-col items-center justify-center gap-3 w-full max-w-sm" id="ppt-share" hidden>
        <button type="button" class="ppt-pass" id="btn-share">Enviar por WhatsApp</button>
        <div class="flex gap-6">
          <button class={textBtn} type="button" id="btn-copy">Copiar enlace</button>
          <button class={textBtn} type="button" id="btn-new">Nuevo reto</button>
        </div>
        <p class="m-0 text-xs text-ink-tertiary text-center" id="ppt-share-msg" aria-live="polite"></p>
      </div>
    </section>

    <section class="w-full mt-12 sm:mt-16 lg:mt-10 lg:col-start-1 lg:row-start-2" aria-label="Historial de rondas">
      <div class="flex flex-wrap items-baseline gap-4 pb-3 border-0 border-b border-(--divider-line)">
        <h2 class="m-0 font-display text-lg">Últimas rondas</h2>
        <span class="flex-1 text-sm text-ink-tertiary tabular-nums" id="history-count"></span>
        <button class="bg-transparent border-0 border-b border-current rounded-none p-0 font-sans text-sm text-ink-secondary cursor-pointer hover:text-warm" id="btn-clear" type="button">Borrar</button>
      </div>
      <ol class="ppt-history list-none m-0 p-0" id="history-list">
        <li class="history-empty">Sin rondas aún</li>
      </ol>
    </section>

  </main>

  <AdSlot position="top" />

  <SeoArticle title="Piedra, papel o tijera online: reglas, modos y trucos">
    <p><strong>¿Quién elige la película, quién saca la basura o quién empieza la partida? Piedra, papel o tijera lo resuelve en tres segundos, y aquí puedes jugarlo aunque tu rival esté en otra ciudad.</strong> Es el juego de manos más conocido del mundo: dos personas, tres gestos y una regla que se aprende a la primera. Esta versión online añade lo que la mano no puede: una máquina que no se deja leer, turnos ocultos en el mismo móvil y retos por WhatsApp.</p>

    <h2>Cómo jugar en Decídelo.app</h2>
    <ol>
      <li>Elige el modo arriba del juego: <strong>Máquina</strong>, <strong>Mismo móvil</strong> o <strong>A distancia</strong>.</li>
      <li>Si juegan dos personas, escriban sus nombres bajo las manos. Con <strong>+ ¿Qué se decide?</strong> pueden anotar lo que le toca a quien pierda, por ejemplo «lava los platos».</li>
      <li>Pulsa <strong>Piedra</strong>, <strong>Papel</strong> o <strong>Tijera</strong>. Las manos se mueven y aparece el resultado.</li>
      <li>Cada ronda queda en <strong>Últimas rondas</strong>, y el marcador se guarda en tu navegador. Con <strong>Borrar</strong> empiezas de cero.</li>
    </ol>
    <p>No hace falta cuenta ni descarga: <a href="#jugar">empieza una ronda ahora</a>.</p>

    <h2>Las reglas de piedra, papel o tijera</h2>
    <p>Los dos jugadores muestran su gesto a la vez. Cada jugada gana a una y pierde contra otra<sup><a href="#fuente-1">[1]</a></sup>:</p>
    <table>
      <thead><tr><th>Jugada</th><th>Gana a</th><th>Pierde contra</th></tr></thead>
      <tbody>
        <tr><td>Piedra (puño cerrado)</td><td>Tijera: la rompe</td><td>Papel</td></tr>
        <tr><td>Papel (mano abierta)</td><td>Piedra: la envuelve</td><td>Tijera</td></tr>
        <tr><td>Tijera (dos dedos en V)</td><td>Papel: lo corta</td><td>Piedra</td></tr>
      </tbody>
    </table>
    <p>Si los dos eligen lo mismo, es <strong>empate</strong> y se juega otra ronda. Como ninguna jugada es mejor que las demás, el juego es justo: nadie empieza con ventaja.</p>

    <h2>Tres modos de juego</h2>
    <h3>Contra la máquina</h3>
    <p>Para pasar el rato o practicar. La máquina elige con <code>crypto.getRandomValues</code>, el generador aleatorio del navegador<sup><a href="#fuente-4">[4]</a></sup>, y no ve tu jugada antes de elegir. Piedra, papel y tijera tienen la misma probabilidad en cada ronda, así que no tiene rachas ni manías que puedas aprender.</p>
    <PptModoDemo modo="maquina" />

    <h3>Dos jugadores en el mismo móvil</h3>
    <p>Elige el primero, pulsa <strong>Elegir</strong> para pasar el móvil y elige el segundo. Entre un turno y otro las jugadas se ocultan, así que nadie ve la del otro ni puede cambiar la suya en el último momento. Es la forma más limpia de acabar con el clásico «¡has sacado tarde!».</p>
    <PptModoDemo modo="dos" />

    <h3>A distancia por WhatsApp</h3>
    <p>Escribe tu nombre y el de tu rival, elige tu jugada y pulsa <strong>Enviar reto por WhatsApp</strong> (o <strong>Copiar enlace</strong>). Tu amigo abre el enlace, elige la suya y ve el resultado; luego te lo puede devolver. Sirve para decidir con la familia o con amigos que no están en la misma casa.</p>
    <PptModoDemo modo="distancia" />

    <h2>Ideas para usarlo</h2>
    <table>
      <thead><tr><th>Situación</th><th>Qué se decide</th><th>Modo</th></tr></thead>
      <tbody>
        <tr><td>Después de cenar</td><td>Quién lava los platos</td><td>Mismo móvil</td></tr>
        <tr><td>Noche de películas</td><td>Quién elige qué ver</td><td>Mismo móvil</td></tr>
        <tr><td>Partida de videojuego o de mesa</td><td>Quién empieza</td><td>Mismo móvil</td></tr>
        <tr><td>Grupo de WhatsApp</td><td>Quién organiza el plan</td><td>A distancia</td></tr>
        <tr><td>Rato libre o espera</td><td>Nada: jugar por jugar</td><td>Máquina</td></tr>
      </tbody>
    </table>
    <p>Si en tu grupo son más de dos, es mejor usar la <a href="/ruleta">ruleta de nombres</a>: elige a una persona entre todas de una vez.</p>

    <h2>Trucos para ganar a personas (no a la máquina)</h2>
    <p>La teoría de juegos dice que, si tu rival elige al azar, lo mejor que puedes hacer es elegir también al azar, con un tercio de probabilidad para cada jugada<sup><a href="#fuente-1">[1]</a></sup>. Pero las personas no somos buenas eligiendo al azar. En un experimento de la Universidad de Zhejiang, 360 estudiantes jugaron 300 rondas cada uno, y sus decisiones dependían de lo que había pasado en la ronda anterior<sup><a href="#fuente-2">[2]</a></sup>.</p>
    <h3>1. Quien gana suele repetir</h3>
    <p>El estudio encontró una tendencia a mantener la jugada después de ganar, una variante de la estrategia «si ganas, repite; si pierdes, cambia»<sup><a href="#fuente-2">[2]</a></sup>. Si tu rival acaba de ganar con piedra, el papel tiene sentido.</p>
    <h3>2. Quien pierde suele cambiar</h3>
    <p>Después de perder, lo más habitual es cambiar de jugada<sup><a href="#fuente-2">[2]</a></sup>. Si tu rival perdió con tijera, lo probable es que no la repita: descarta la tijera y elige entre las otras dos.</p>
    <h3>3. No seas predecible tú</h3>
    <p>Lo mismo vale para ti. Si sabes que tiendes a repetir cuando ganas, rompe el patrón de vez en cuando. Contra la máquina estos trucos no sirven: ella no mira el historial, y cada ronda es nueva.</p>
    <p>Si quieres más detalle, lee <a href="/blog/piedra-papel-tijera/como-ganar-piedra-papel-o-tijera">cómo ganar a piedra, papel o tijera</a>. Y luego <a href="#jugar">pruébalo en una ronda</a>.</p>

    <h2>¿Qué herramienta usar?</h2>
    <table>
      <thead><tr><th>Si necesitas…</th><th>Usa</th></tr></thead>
      <tbody>
        <tr><td>Elegir entre dos opciones con nombre</td><td><a href="/moneda">Cara o sello</a></td></tr>
        <tr><td>Responder una pregunta de sí o no</td><td><a href="/si-o-no">Pregunta sí o no</a></td></tr>
        <tr><td>Elegir entre tres o más opciones o personas</td><td><a href="/ruleta">Ruleta</a></td></tr>
        <tr><td>Un número al azar en un rango</td><td><a href="/numeros">Números aleatorios</a></td></tr>
        <tr><td>Tirar dados para un juego de mesa</td><td><a href="/dados">Dados</a></td></tr>
        <tr><td>Dividir un grupo en equipos</td><td><a href="/equipos">Equipos</a></td></tr>
        <tr><td>Organizar un intercambio de regalos</td><td><a href="/amigo-secreto">Amigo secreto</a></td></tr>
        <tr><td>Medir turnos con tiempo</td><td><a href="/temporizador">Temporizador</a></td></tr>
      </tbody>
    </table>

    <h2>De dónde viene y cómo se llama en cada país</h2>
    <p>La primera mención escrita conocida del juego está en un libro chino de hacia 1600, del escritor Xie Zhaozhe, que lo llama <em>shoushiling</em> y dice que viene de la época de la dinastía Han (206 a. C. – 220 d. C.). En Japón, la versión más conocida es el <em>janken</em>, una variante de los juegos chinos que llegaron en el siglo XVII<sup><a href="#fuente-1">[1]</a></sup>.</p>
    <p>En español cambia el nombre según el país. En Chile es <strong>cachipún</strong><sup><a href="#fuente-5">[5]</a></sup>, en Perú <strong>yan ken po</strong><sup><a href="#fuente-6">[6]</a></sup> y en Paraguay <strong>jankenpon</strong><sup><a href="#fuente-7">[7]</a></sup>. El juego y las reglas son los mismos: solo cambia el nombre.</p>
    <p>También hay versiones con más gestos. La más famosa, «piedra, papel, tijera, lagarto, Spock», la inventaron Sam Kass y Karen Bryla y en 2008 apareció en un episodio de la serie <em>The Big Bang Theory</em><sup><a href="#fuente-1">[1]</a></sup><sup><a href="#fuente-3">[3]</a></sup>. Te lo contamos en <a href="/blog/piedra-papel-tijera/reglas-variantes-lagarto-spock">las variantes del juego</a>.</p>

    <h2>Juega ahora</h2>
    <p>Elige un modo, pon qué se decide y <a href="#jugar">saca tu jugada</a>. Para decisiones médicas, legales o de dinero, mejor habla con alguien que sepa del tema; para quién lava los platos, esto basta.</p>

    <h2>Preguntas frecuentes</h2>
    <h3>¿Cómo se juega a piedra, papel o tijera?</h3>
    <p>Cada jugador elige a la vez piedra, papel o tijera. La piedra gana a la tijera, la tijera gana al papel y el papel gana a la piedra. Si los dos eligen lo mismo, es empate y se repite la ronda.</p>
    <h3>¿Puedo jugar piedra, papel o tijera con otra persona en el mismo móvil?</h3>
    <p>Sí. Elige el modo «Mismo móvil»: primero elige un jugador, pasa el móvil y elige el otro. Las jugadas se ocultan entre turno y turno y solo se muestran cuando los dos han elegido.</p>
    <h3>¿Cómo juego a distancia con un amigo?</h3>
    <p>Elige el modo «A distancia», escribe tu nombre y el de tu amigo, elige tu jugada y pulsa «Enviar reto por WhatsApp». Tu amigo abre el enlace, elige su jugada y te puede devolver el resultado por el mismo camino.</p>
    <h3>¿La máquina hace trampa?</h3>
    <p>No. La máquina elige con el generador aleatorio del navegador, crypto.getRandomValues, y no mira tu jugada: piedra, papel y tijera tienen la misma probabilidad en cada ronda.</p>
    <h3>¿Existe una estrategia para ganar siempre?</h3>
    <p>Contra alguien que elige al azar, no: ninguna jugada es mejor que otra. Contra personas sí hay tendencias, como repetir la jugada después de ganar y cambiar después de perder, según un experimento de la Universidad de Zhejiang con 360 estudiantes.</p>
    <h3>¿Cómo se llama este juego en otros países?</h3>
    <p>Depende del país: cachipún en Chile, yan ken po en Perú, jankenpon en Paraguay y janken en Japón.</p>

    <h2>Guías relacionadas</h2>
    <ul>
      <li><a href="/blog/piedra-papel-tijera/como-ganar-piedra-papel-o-tijera">Cómo ganar a piedra, papel o tijera: estrategias con base científica</a></li>
      <li><a href="/blog/piedra-papel-tijera/teoria-de-juegos-y-psicologia">La teoría de juegos detrás de piedra, papel o tijera</a></li>
