---
// Amigo secreto (SDD de amigo secreto, docs/sdd-amigo-secreto.md).
// Dos pantallas en la misma URL: organizar (por defecto) y abrir el sobre
// (cuando la dirección trae un enlace #revelar= o #v=2). Todo el marcado que
// el JS repite (fichas, filas de enlaces, filas de la verificación, nombres
// del modo presencial) vive aquí en <template>: así Tailwind ve sus clases y
// el JS solo clona y rellena con textContent.
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import HubGrid from '../components/HubGrid.astro';
import Envelope from '../components/Envelope.astro';
import AmigoSecretoArticulo from '../components/AmigoSecretoArticulo.astro';
import { title, description, keywords, schemaLD } from '../data/amigo-secreto-seo.js';
import { getSocialImageUrl } from '../lib/heroImages';

const socialImage = await getSocialImageUrl('/blog/amigo-secreto.png');

const campo = 'w-full min-w-0 rounded-md border border-white/10 bg-(--as-campo) px-3.5 py-3 text-base text-ink-primary placeholder:text-ink-tertiary focus:border-(--as-oro) focus:outline-none focus-visible:ring-2 focus-visible:ring-(--as-oro)/40';
const etiqueta = 'text-[0.8rem] font-semibold uppercase tracking-[0.12em] text-ink-secondary';
const plegable = 'group rounded-lg border border-white/10 bg-white/[0.03] open:bg-white/[0.05]';
const resumen = 'flex cursor-pointer list-none items-center gap-3 px-4 py-3.5 text-[0.95rem] font-semibold text-ink-primary [&::-webkit-details-marker]:hidden';
const botonSec = 'inline-flex items-center justify-center gap-2 rounded-full border border-white/15 bg-transparent px-4 py-2.5 text-sm font-semibold text-ink-primary cursor-pointer hover:border-(--as-oro) hover:text-(--as-oro) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--as-oro) disabled:opacity-40 disabled:cursor-not-allowed';
const botonPri = 'inline-flex items-center justify-center gap-2 rounded-full border-0 bg-(--as-lacre) px-6 py-3 text-base font-bold text-white cursor-pointer shadow-[0_6px_24px_-6px_var(--as-lacre)] hover:brightness-110 active:scale-[0.98] transition focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-(--as-oro) disabled:opacity-40 disabled:shadow-none disabled:cursor-not-allowed';
---

<Layout title={title} description={description} keywords={keywords} schemaLD={schemaLD(socialImage)} showHomeHeader={false}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  <main id="as-app" class="as-page w-full overflow-x-clip pt-4 pb-10 sm:pt-8" data-modo="organizar">
    <div class="as-luces pointer-events-none absolute inset-x-0 top-0 -z-0 h-[420px]" aria-hidden="true"></div>

    <!-- ============ ORGANIZAR ============ -->
    <section id="organizer-screen" class="wrap relative max-w-2xl lg:max-w-6xl" data-solo="organizar" aria-label="Organizar el sorteo">
      <header class="mb-4 text-center sm:mb-5 lg:mb-8 lg:text-left">
        <p class="mb-2 hidden items-center gap-2 rounded-full sm:inline-flex bg-(--as-lacre)/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-(--as-oro)">Gratis · sin registro · por WhatsApp</p>
        <h1 class="as-h1 m-0 font-display text-[clamp(2rem,8vw,3.4rem)] font-bold leading-[1.05] text-ink-primary">Amigo secreto, <em>sin papelitos</em></h1>
        <p class="mx-auto mt-2 mb-0 max-w-xl text-[0.95rem] text-ink-secondary sm:mt-3 sm:text-base lg:mx-0">Escribe los nombres, sortea y reparte por enlace o pasando el teléfono.<span class="hidden sm:inline"> Nadie se toca a sí mismo y el sorteo se hace en tu navegador.</span></p>
      </header>

      <div id="saved-draw" class="mb-5 flex flex-col gap-3 rounded-lg border border-(--as-oro)/40 bg-(--as-oro)/10 p-4 sm:flex-row sm:items-center" role="region" aria-label="Sorteo guardado" hidden>
        <p class="m-0 flex-1 text-sm text-ink-primary" data-saved-info></p>
        <div class="flex gap-2">
          <button type="button" class={botonPri + ' !px-4 !py-2 !text-sm'} data-saved-restore>Recuperar</button>
          <button type="button" class={botonSec} data-saved-clear>Borrar</button>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-start lg:gap-10">
        <!-- Entradas -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-2">
            <div class="flex items-baseline justify-between gap-3">
              <label for="participants-textarea" class={etiqueta}>Participantes</label>
              <span id="participants-count" class="text-sm tabular-nums text-ink-tertiary" aria-live="polite">0 personas</span>
            </div>
            <textarea id="participants-textarea" rows="4" class={campo + ' as-lista min-h-[6.5rem] resize-y font-[inherit] leading-relaxed'} placeholder={'Una persona por línea\nAna\nBruno, 3001234567\nCarla, carla@correo.com | le gusta el café'} spellcheck="false" autocomplete="off"></textarea>
            <ul id="participants-tags-container" class="m-0 flex list-none flex-wrap gap-2 p-0" aria-label="Lista de participantes"></ul>
          </div>

          <p id="draw-warning" class="m-0 rounded-md border border-(--as-oro)/30 bg-(--as-oro)/10 px-4 py-3 text-sm leading-relaxed text-ink-primary" role="status" aria-live="polite" hidden></p>

          <button type="button" id="btn-draw" class={botonPri + ' w-full !py-4 !text-lg sm:w-auto sm:self-start sm:!px-10'} disabled>
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5" /><path d="M4 20 21 3" /><path d="M21 16v5h-5" /><path d="M15 15l6 6" /><path d="M4 4l5 5" /></svg>
            Sortear
          </button>

          <div class="flex flex-wrap items-center gap-2">
              <label class={botonSec + ' relative'}>
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="M17 8l-5-5-5 5" /><path d="M12 3v12" /></svg>
                Importar CSV o Excel
                <input id="csv-file-input" type="file" accept=".csv,.txt,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="absolute inset-0 cursor-pointer opacity-0">
              </label>
              <button type="button" id="as-contactos" class={botonSec} hidden>
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></svg>
                Desde mis contactos
              </button>
            </div>

          <details id="exclusions-details" class={plegable}>
            <summary class={resumen}>
              <span class="grid size-7 place-items-center rounded-full bg-(--as-pino)/30 text-(--as-pino-claro)" aria-hidden="true">≠</span>
              <span class="flex-1">¿Quiénes no deben tocarse?</span>
              <span id="as-excl-cuenta" class="text-xs font-normal text-ink-tertiary"></span>
              <span class="text-ink-tertiary transition group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="flex flex-col gap-3 px-4 pb-4">
              <p class="m-0 text-sm text-ink-secondary">Una pareja o grupo por línea, separados por coma: nadie de la línea le regala a otro de la misma. Para un solo sentido usa «&gt;»: <em>Ana &gt; Luis</em> (Ana no le regala a Luis).</p>
              <textarea id="exclusions-textarea" rows="3" class={campo + ' resize-y font-[inherit]'} placeholder={'Ana, Luis\nCarlos, María, Pedro\nSofía > Diego'} spellcheck="false" autocomplete="off" aria-label="Exclusiones"></textarea>
              <button type="button" id="as-emparejar" class={botonSec + ' self-start aria-pressed:border-(--as-oro) aria-pressed:text-(--as-oro)'} aria-pressed="false">Emparejar tocando dos nombres</button>
            </div>
          </details>

          <details id="as-detalles" class={plegable}>
            <summary class={resumen}>
              <span class="grid size-7 place-items-center rounded-full bg-(--as-oro)/20 text-(--as-oro)" aria-hidden="true">$</span>
              <span class="flex-1">Presupuesto, fecha y lugar</span>
              <span class="text-xs font-normal text-ink-tertiary">opcional</span>
              <span class="text-ink-tertiary transition group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="grid grid-cols-2 gap-3 px-4 pb-4">
              <label class="col-span-2 flex flex-col gap-1.5"><span class={etiqueta}>Nombre del grupo</span><input id="as-grupo" class={campo} maxlength="60" placeholder="Oficina, familia Gómez…" autocomplete="off"></label>
              <label class="flex flex-col gap-1.5"><span class={etiqueta}>Presupuesto</span><input id="as-presupuesto" class={campo} inputmode="numeric" maxlength="12" placeholder="50.000" autocomplete="off"></label>
              <label class="flex flex-col gap-1.5"><span class={etiqueta}>Fecha</span><input id="as-fecha" type="date" class={campo + ' [color-scheme:dark]'}></label>
              <label class="col-span-2 flex flex-col gap-1.5"><span class={etiqueta}>Lugar</span><input id="as-lugar" class={campo} maxlength="80" placeholder="Casa de Ana" autocomplete="off"></label>
              <label class="col-span-2 flex flex-col gap-1.5"><span class={etiqueta}>Mensaje para todos</span><input id="as-mensaje" class={campo} maxlength="140" placeholder="Nada de medias, por favor" autocomplete="off"></label>
              <p class="col-span-2 m-0 text-xs text-ink-tertiary">Cada persona los verá al abrir su sobre, con un botón para añadir la fecha a su calendario.</p>
            </div>
          </details>

        </div>

        <!-- Resultado -->
        <section id="results-section" class="flex flex-col gap-4 rounded-xl border border-white/10 bg-(--as-panel) p-4 sm:p-6 lg:sticky lg:top-6" aria-labelledby="as-res-titulo" hidden>
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 id="as-res-titulo" class="m-0 font-display text-xl text-ink-primary">¡Sorteo hecho!</h2>
              <p id="as-res-sub" class="m-0 mt-1 text-sm text-ink-secondary"></p>
            </div>
            <button type="button" id="as-nuevo" class={botonSec + ' !py-1.5 shrink-0'}>Nuevo</button>
          </div>

          <div class="grid grid-cols-2 gap-1 rounded-full bg-black/30 p-1" role="tablist" aria-label="Cómo repartir">
            <button type="button" role="tab" id="as-tab-enlaces" aria-controls="as-panel-enlaces" aria-selected="true" class="rounded-full border-0 bg-transparent px-3 py-2 text-sm font-semibold text-ink-secondary cursor-pointer aria-selected:bg-(--as-papel) aria-selected:text-(--as-tinta)">Por enlace</button>
            <button type="button" role="tab" id="as-tab-telefono" aria-controls="as-panel-telefono" aria-selected="false" tabindex="-1" class="rounded-full border-0 bg-transparent px-3 py-2 text-sm font-semibold text-ink-secondary cursor-pointer aria-selected:bg-(--as-papel) aria-selected:text-(--as-tinta)">Pasa el teléfono</button>
          </div>

          <div id="as-panel-enlaces" role="tabpanel" aria-labelledby="as-tab-enlaces" class="flex flex-col gap-3">
            <p class="m-0 text-sm text-ink-secondary">Envía a cada quien su enlace. Si alguien lo pierde, reenvíalo desde aquí: el sorteo no cambia.</p>
            <ul id="links-list-container" class="m-0 flex list-none flex-col divide-y divide-white/10 p-0"></ul>
            <p id="as-enviados" class="m-0 text-xs tabular-nums text-ink-tertiary"></p>
          </div>

          <div id="as-panel-telefono" role="tabpanel" aria-labelledby="as-tab-telefono" class="flex flex-col items-start gap-3" hidden>
            <p class="m-0 text-sm text-ink-secondary">Un solo celular para todos: cada persona toca su nombre, abre su sobre en privado y lo cierra antes de pasarlo. Quien organiza no ve nada.</p>
            <button type="button" id="as-empezar-telefono" class={botonPri}>Empezar</button>
          </div>

          <details id="validation-section" class={plegable}>
            <summary class={resumen + ' !text-sm'}>
              <span class="flex-1">Verificación anónima del sorteo</span>
              <span class="text-ink-tertiary transition group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="px-4 pb-4">
              <p id="as-metodo" class="m-0 mb-3 text-xs text-ink-secondary"></p>
              <table class="w-full border-collapse text-sm">
                <thead><tr class="text-left text-xs text-ink-tertiary"><th class="py-1 font-semibold">Regala</th><th></th><th class="py-1 font-semibold">Recibe</th></tr></thead>
                <tbody id="matrix-tbody"></tbody>
              </table>
            </div>
          </details>
        </section>
      </div>
    </section>

    <!-- ============ ABRIR EL SOBRE ============ -->
    <section id="reveal-screen" class="wrap relative flex max-w-md flex-col items-center text-center" data-solo="abrir" aria-labelledby="as-abrir-titulo" hidden>
      <p id="as-abrir-grupo" class="m-0 mb-1 text-xs font-semibold uppercase tracking-[0.16em] text-(--as-oro)" hidden></p>
      <h1 id="as-abrir-titulo" class="as-h1 m-0 font-display text-[clamp(1.8rem,7vw,2.6rem)] font-bold leading-tight text-ink-primary">Tu <em>amigo secreto</em></h1>
      <p id="as-abrir-intro" class="m-0 mt-2 text-ink-secondary">Asegúrate de que nadie mira tu pantalla.</p>

      <div id="as-sobre-zona" class="w-full pb-10">
        <Envelope id="gift-container" nameId="revealed-name" />
      </div>

      <dl id="as-abrir-detalles" class="m-0 grid w-full grid-cols-2 gap-3 text-left" hidden>
        <div data-campo="presupuesto" class="rounded-lg bg-white/[0.04] p-3" hidden><dt class={etiqueta}>Presupuesto</dt><dd class="m-0 mt-1 font-display text-lg text-ink-primary"></dd></div>
        <div data-campo="fecha" class="rounded-lg bg-white/[0.04] p-3" hidden><dt class={etiqueta}>Fecha</dt><dd class="m-0 mt-1 font-display text-lg text-ink-primary first-letter:uppercase"></dd></div>
        <div data-campo="lugar" class="col-span-2 rounded-lg bg-white/[0.04] p-3" hidden><dt class={etiqueta}>Lugar</dt><dd class="m-0 mt-1 text-ink-primary"></dd></div>
        <div data-campo="pista" class="col-span-2 rounded-lg border border-(--as-oro)/30 bg-(--as-oro)/10 p-3" hidden><dt class={etiqueta}>Pista</dt><dd class="m-0 mt-1 text-ink-primary"></dd></div>
        <div data-campo="mensaje" class="col-span-2 rounded-lg bg-white/[0.04] p-3" hidden><dt class={etiqueta}>Mensaje del grupo</dt><dd class="m-0 mt-1 italic text-ink-primary"></dd></div>
      </dl>

      <div class="mt-5 flex flex-wrap justify-center gap-2">
        <button type="button" id="as-calendario" class={botonSec} hidden>
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
          Añadir al calendario
        </button>
        <a href="/amigo-secreto" class={botonSec + ' no-underline'}>Organizar mi propio sorteo</a>
      </div>
    </section>

    <!-- ============ PASA EL TELÉFONO ============ -->
    <dialog id="as-telefono" class="as-dialogo m-0 h-dvh max-h-none w-full max-w-none border-0 bg-(--as-noche) p-0 text-ink-primary backdrop:bg-black/80" aria-labelledby="as-tel-titulo">
      <div class="mx-auto flex min-h-full max-w-md flex-col px-5 py-6">
        <div class="flex items-center justify-between gap-3">
          <h2 id="as-tel-titulo" class="m-0 font-display text-xl">Pasa el teléfono</h2>
          <button type="button" id="as-tel-salir" class={botonSec + ' !py-1.5'}>Terminar</button>
        </div>

        <div id="as-tel-lista-zona" class="mt-4 flex flex-col gap-3">
          <p class="m-0 text-sm text-ink-secondary">Toca tu nombre. <span id="as-tel-faltan" class="tabular-nums"></span></p>
          <ul id="as-tel-lista" class="m-0 grid list-none grid-cols-2 gap-2 p-0"></ul>
        </div>

        <div id="as-tel-confirmar" class="mt-10 flex flex-col items-center gap-4 text-center" hidden>
          <p class="m-0 text-lg">¿Eres <strong id="as-tel-quien" class="text-(--as-oro)"></strong>?</p>
          <p class="m-0 text-sm text-ink-secondary">Que nadie más mire la pantalla.</p>
          <div class="flex gap-2">
            <button type="button" id="as-tel-si" class={botonPri}>Sí, abrir mi sobre</button>
            <button type="button" id="as-tel-no" class={botonSec}>No soy yo</button>
          </div>
        </div>

        <div id="as-tel-sobre" class="flex flex-col items-center pb-6" hidden>
          <Envelope id="as-tel-env" nameId="as-tel-nombre" />
          <p id="as-tel-pista" class="m-0 mt-12 max-w-xs text-sm text-ink-secondary" hidden></p>
          <button type="button" id="as-tel-listo" class={botonPri + ' mt-6'} hidden>Listo, cerrar y pasar</button>
        </div>
      </div>
    </dialog>

    <!-- ============ CONFIRMAR ============ -->
    <dialog id="as-confirmar" class="as-dialogo m-auto w-[min(92vw,26rem)] rounded-xl border border-white/10 bg-(--as-panel) p-5 text-ink-primary shadow-lg backdrop:bg-black/70" aria-labelledby="as-conf-texto">
      <form method="dialog" class="flex flex-col gap-4">
        <p id="as-conf-texto" class="m-0 text-[0.95rem] leading-relaxed"></p>
        <div class="flex justify-end gap-2">
          <button value="no" class={botonSec}>Cancelar</button>
          <button value="si" id="as-conf-si" class={botonPri + ' !px-5 !py-2.5 !text-sm'}>Sí</button>
        </div>
      </form>
    </dialog>

    <div id="toast-message" popover="manual" class="as-toast fixed inset-x-0 bottom-6 top-auto mx-auto w-max max-w-[90vw] rounded-full border-0 bg-(--as-papel) px-5 py-2.5 text-sm font-semibold text-(--as-tinta) shadow-lg data-[visible=true]:block" role="status" aria-live="polite"></div>

    <!-- ============ PLANTILLAS ============ -->
    <template id="tpl-ficha">
      <li class="participant-tag inline-flex items-center gap-1 rounded-full bg-white/[0.07] py-1 pl-3 pr-1 text-sm text-ink-primary data-[elegida=true]:bg-(--as-oro) data-[elegida=true]:text-(--as-tinta) data-[aviso=true]:ring-1 data-[aviso=true]:ring-(--as-oro)">
        <button type="button" data-ficha-nombre class="border-0 bg-transparent p-0 text-inherit font-[inherit] cursor-default data-[tocable=true]:cursor-pointer"></button>
        <button type="button" data-ficha-quitar class="grid size-6 place-items-center rounded-full border-0 bg-transparent p-0 text-base leading-none text-ink-tertiary cursor-pointer hover:bg-white/10 hover:text-ink-primary" aria-label="Quitar">×</button>
      </li>
    </template>

    <template id="tpl-enlace">
      <li class="link-row group flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:gap-3" data-enviado="false">
        <div class="min-w-0 flex-1">
          <p class="row-name m-0 flex items-center gap-2 font-semibold text-ink-primary">
            <span data-nombre class="truncate"></span>
            <span data-estado class="hidden shrink-0 rounded-full bg-(--as-pino)/30 px-2 py-0.5 text-[0.7rem] font-semibold text-(--as-pino-claro) group-data-[enviado=true]:inline">Enviado</span>
          </p>
          <p data-contacto class="m-0 truncate text-xs text-ink-tertiary"></p>
        </div>
        <div class="row-actions flex gap-2">
          <button type="button" data-enviar class={botonPri + ' flex-1 !px-4 !py-2 !text-sm !shadow-none sm:flex-none group-data-[enviado=true]:!bg-white/10'}>Enviar</button>
          <button type="button" data-whatsapp class={botonSec + ' flex-1 !py-2 sm:flex-none'} hidden>WhatsApp</button>
          <button type="button" data-copiar class={botonSec + ' flex-1 !py-2 sm:flex-none'}>Copiar</button>
        </div>
      </li>
    </template>

    <template id="tpl-matriz">
      <tr class="border-t border-white/5"><td data-da class="py-1.5 font-semibold tabular-nums"></td><td class="px-2 text-center text-ink-tertiary" aria-hidden="true">→</td><td data-recibe class="py-1.5 font-semibold tabular-nums"></td></tr>
    </template>

    <template id="tpl-tel-nombre">
      <li>
        <button type="button" class="w-full truncate rounded-lg border border-white/10 bg-white/[0.05] px-3 py-4 text-base font-semibold text-ink-primary cursor-pointer hover:border-(--as-oro) disabled:cursor-default disabled:border-transparent disabled:bg-transparent disabled:text-ink-tertiary disabled:line-through"></button>
      </li>
    </template>
  </main>

  <div data-solo="organizar">
    <AmigoSecretoArticulo />
    <AdSlot position="bottom" />
    <section class="hub-section wrap">
      <div class="section-header reveal">
        <h2 class="section-heading">Prueba otras herramientas de decisión</h2>
      </div>
      <HubGrid activeToolId="amigo-secreto" />
    </section>
  </div>

  <script src="../scripts/amigo-secreto.js"></script>

  {/* Respaldo para navegadores por debajo del mínimo (SDD §0.4): si el
      módulo no arrancó (sin soporte de módulos o de ?. y ??), un enlace v1
      repartido en años anteriores se sigue abriendo. ES5 a propósito. */}
  <script is:inline>
    (function () {
      function respaldo() {
        var app = document.getElementById('as-app');
        if (!app || app.getAttribute('data-ready')) return;
        var m = /[#?&]revelar=([^&]*)/.exec(location.hash + '&' + location.search);
        if (!m) return;
        var nombre = null;
        try {
          var b64 = decodeURIComponent(decodeURIComponent(m[1]).replace(/ /g, '+'));
          var x = atob(b64), k = 'decidelo', s = '';
          for (var i = 0; i < x.length; i++) s += String.fromCharCode(x.charCodeAt(i) ^ k.charCodeAt(i % k.length));
          nombre = decodeURIComponent(escape(s));
        } catch (e) { nombre = null; }
        app.setAttribute('data-ready', 'respaldo');
        document.body.setAttribute('data-as-modo', 'abrir');
        var org = document.getElementById('organizer-screen');
        var rev = document.getElementById('reveal-screen');
        if (org) { org.hidden = true; org.style.display = 'none'; }
        if (rev) { rev.hidden = false; rev.style.display = 'block'; }
        var sobre = document.getElementById('gift-container');
        var nom = document.getElementById('revealed-name');
        if (nombre && sobre && nom) {
          nom.textContent = nombre;
          sobre.setAttribute('data-state', 'abierto');
          sobre.setAttribute('aria-label', 'Te toca regalarle a ' + nombre);
        } else {
          var t = document.getElementById('as-abrir-titulo');
          if (t) t.textContent = 'Este enlace no funciona';
          if (sobre) sobre.style.display = 'none';
        }
      }
      if (window.addEventListener) window.addEventListener('load', function () { setTimeout(respaldo, 1500); });
    })();
  </script>
</Layout>

