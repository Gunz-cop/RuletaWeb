---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import HubGrid from '../components/HubGrid.astro';
import SeoArticle from '../components/SeoArticle.astro';
import Dice from '../components/Dice.astro';
import { getSocialImageUrl } from '../lib/heroImages';

const title = 'Lanzar Dados Online — Tirar Dados Virtuales 3D Gratis | Decídelo.app';
const description = 'Lanza de 1 a 6 dados virtuales en 3D gratis y al instante: ruedan sobre la mesa, ves la suma y cada dado, y queda un historial. Sin descargas ni registro.';
const keywords = 'lanzar dados, tirar dados, dados virtuales, dados online, dados 3d, dado de 6 caras, tirar dos dados, tomar decisiones, azar';

// La imagen vive en src/assets y la optimiza Astro; el JSON-LD necesita
// su URL absoluta ya generada, no la ruta pública que tenía antes.
const socialImage = await getSocialImageUrl('/blog/dados.png');

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://decidelo.app/dados#webapp",
      "name": "Lanzar Dados Online — Decídelo.app",
      "description": "Herramienta online para lanzar de 1 a 6 dados virtuales de seis caras en 3D, con la suma, el valor de cada dado y un historial de tiradas.",
      "url": "https://decidelo.app/dados",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript and HTML5 3D Transforms",
      "softwareVersion": "3.0.0",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "image": socialImage,
      "screenshot": socialImage,
      "publisher": {
        "@type": "Organization",
        "@id": "https://decidelo.app/#organization",
        "name": "Decídelo.app",
        "url": "https://decidelo.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://decidelo.app/favicon.svg"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://decidelo.app/dados#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://decidelo.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Lanzar Dados",
          "item": "https://decidelo.app/dados"
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} schemaLD={schemaLD} showHomeHeader={false}>
  <Fragment slot="head">
    {/* Newsreader itálica: acento del sistema editorial (ver DESIGN.md) */}
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  <main class="wrap max-w-2xl pt-5 pb-8 sm:pt-8">

    <div class="w-full text-center mb-2 sm:mb-5">
      <h1 class="m-0 mb-2 sm:mb-4 font-display text-[1.7rem] sm:text-5xl leading-tight tracking-tight">Lanzar <em class="font-[Newsreader,Georgia,serif] italic font-normal text-warm">dados</em> online</h1>
      {/* En pantallas bajas la entradilla cede su sitio al botón (también en
          portátiles de 720px de alto y tablets en horizontal) */}
      <p class="m-0 mb-2 sm:mb-0 mx-auto max-w-lg text-sm sm:text-base text-ink-secondary max-sm:[@media(max-height:620px)]:hidden sm:[@media(max-height:760px)]:hidden">Elige cuántos dados y lánzalos. Ruedan sobre la mesa y debajo ves la suma y lo que sacó cada uno.</p>
    </div>

    <div class="w-full max-w-sm mx-auto">
      <span class="block mb-2 text-center text-xs font-semibold tracking-widest uppercase text-ink-tertiary" id="dice-count-label">Cuántos dados</span>
      <div class="grid grid-cols-6 gap-1.5" role="group" aria-labelledby="dice-count-label">
        {[1, 2, 3, 4, 5, 6].map((n) => (
          <button type="button" data-dice-count={n} aria-pressed={n === 2 ? 'true' : 'false'} class="py-2 bg-transparent border border-(--divider-line) rounded-full font-display font-semibold text-base text-ink-secondary tabular-nums cursor-pointer aria-pressed:text-ink-primary aria-pressed:border-warm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warm hover:text-ink-primary hover:border-warm">{n}</button>
        ))}
      </div>
    </div>

    <section class="w-full flex flex-col items-center" aria-label="Lanzar dados">
      <Dice />

      <p class="dice-result w-full text-center min-h-14 sm:min-h-18 m-0 mb-3 sm:mb-4" id="dice-result" aria-live="polite">
        <span class="block font-display font-extrabold text-[2.2rem] sm:text-5xl leading-none text-ink-primary tabular-nums" id="dice-result-main"></span>
        <span class="block mt-1 sm:mt-1.5 text-sm text-ink-tertiary tabular-nums" id="dice-result-side"></span>
      </p>

      <button id="btn-roll" type="button" class="px-9 py-3.5 border-0 rounded-full bg-warm text-[#1a0e06] font-display font-bold text-lg cursor-pointer transition-transform duration-150 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-warm">Lanzar dados</button>

      {/* El tipo va debajo de la acción: encima empujaba el botón fuera de
          la primera pantalla en los móviles bajos (DESIGN.md, "Controles
          secundarios debajo de la acción principal") */}
      <div class="w-full max-w-sm mx-auto mt-6">
        <span class="block mb-2 text-center text-xs font-semibold tracking-widest uppercase text-ink-tertiary" id="dice-type-label">Tipo de dado</span>
        <div class="grid grid-cols-6 gap-1.5" role="group" aria-labelledby="dice-type-label">
          {[4, 6, 8, 10, 12, 20].map((n) => (
            <button type="button" data-dice-type={n} aria-pressed={n === 6 ? 'true' : 'false'} class="py-2 bg-transparent border border-(--divider-line) rounded-full font-display font-semibold text-base text-ink-secondary tabular-nums cursor-pointer aria-pressed:text-ink-primary aria-pressed:border-warm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warm hover:text-ink-primary hover:border-warm">D{n}</button>
          ))}
        </div>
      </div>

      {/* Solo en móviles con sensor de movimiento; el JS lo muestra */}
      <div id="dice-shake" class="flex flex-col items-center gap-1 mt-6 w-full" hidden>
        <button class="bg-transparent border-0 border-b border-(--divider-line) rounded-none px-0 py-1 font-sans text-base text-ink-primary cursor-pointer hover:text-warm hover:border-current focus-visible:text-warm focus-visible:border-current focus-visible:outline-none aria-pressed:text-warm aria-pressed:border-current" id="btn-shake" type="button" aria-pressed="false">Agitar el móvil para lanzar</button>
        <p class="m-0 max-w-xs text-center text-xs text-ink-tertiary" id="shake-msg" aria-live="polite"></p>
      </div>
    </section>

    {/* Modo rol: debajo de la acción principal, para que sus controles no
        empujen el botón fuera de la pantalla en el móvil */}
    <section class="w-full mt-12 sm:mt-16" aria-labelledby="rol-titulo">
      <div class="pb-3 border-0 border-b border-(--divider-line)">
        <h2 class="m-0 font-display text-lg" id="rol-titulo">Tiradas de rol</h2>
        <p class="m-0 mt-1 text-sm text-ink-secondary">Para juegos de rol como Dungeons &amp; Dragons: escribe la tirada como en tu hoja de personaje.</p>
      </div>

      <form class="mt-5" id="rol-form" novalidate>
        <label class="block text-xs font-semibold tracking-widest uppercase text-ink-tertiary" for="rol-tirada">Tirada</label>
        <div class="flex items-end gap-4">
          <input class="w-full min-w-0 bg-transparent border-0 border-b border-(--divider-line) rounded-none px-0 py-2 font-sans text-base text-ink-primary placeholder:text-ink-tertiary focus:outline-none focus:border-warm font-display tabular-nums" id="rol-tirada" name="tirada" type="text" inputmode="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="1d20+5" maxlength="40" aria-describedby="rol-ayuda rol-error">
          <button class="shrink-0 bg-transparent border-0 border-b border-current rounded-none px-0 py-1 font-sans text-base text-ink-primary cursor-pointer hover:text-warm focus-visible:text-warm focus-visible:outline-none" id="btn-rol-tirar" type="submit">Tirar</button>
        </div>
        <p class="m-0 mt-2 text-xs text-ink-tertiary" id="rol-ayuda">Dados de d4 a d20, hasta 6 a la vez: 2d6+3, 3d8-1, 1d8+1d6.</p>
        <p class="rol-error m-0 mt-1 text-sm text-warm" id="rol-error" aria-live="polite"></p>
      </form>

      <div class="grid grid-cols-3 gap-1.5 mt-5" role="group" aria-label="Tiradas especiales">
        <button type="button" id="btn-ventaja" class="py-2 bg-transparent border border-(--divider-line) rounded-full font-display font-semibold text-base text-ink-secondary tabular-nums cursor-pointer aria-pressed:text-ink-primary aria-pressed:border-warm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warm hover:text-ink-primary hover:border-warm px-1 text-sm">Ventaja</button>
        <button type="button" id="btn-desventaja" class="py-2 bg-transparent border border-(--divider-line) rounded-full font-display font-semibold text-base text-ink-secondary tabular-nums cursor-pointer aria-pressed:text-ink-primary aria-pressed:border-warm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warm hover:text-ink-primary hover:border-warm px-1 text-sm">Desventaja</button>
        <button type="button" id="btn-personaje" class="py-2 bg-transparent border border-(--divider-line) rounded-full font-display font-semibold text-base text-ink-secondary tabular-nums cursor-pointer aria-pressed:text-ink-primary aria-pressed:border-warm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warm hover:text-ink-primary hover:border-warm px-1 text-sm">Personaje</button>
      </div>
      <p class="m-0 mt-2 text-xs text-ink-tertiary">Ventaja y desventaja: 2d20 y vale el mayor o el menor (con el modificador de la tirada si es 1d20+algo). Personaje: 4d6 sin el menor, seis veces.</p>

      <ol class="dice-personaje list-none m-0 mt-4 p-0" id="rol-personaje" aria-live="polite" hidden></ol>

      <h3 class="m-0 mt-8 font-display text-base">Tiradas guardadas</h3>
      <ul class="dice-guardadas list-none m-0 mt-2 p-0 border-0 border-t border-(--divider-line)" id="rol-guardadas">
        <li class="guardada-vacia">Guarda las que repites, como «Ataque espada: 1d20+5».</li>
      </ul>
      <form class="mt-4" id="rol-guardar" novalidate>
        <label class="block text-xs font-semibold tracking-widest uppercase text-ink-tertiary" for="rol-nombre">Nombre</label>
        <div class="flex items-end gap-4">
          <input class="w-full min-w-0 bg-transparent border-0 border-b border-(--divider-line) rounded-none px-0 py-2 font-sans text-base text-ink-primary placeholder:text-ink-tertiary focus:outline-none focus:border-warm" id="rol-nombre" name="nombre" type="text" autocomplete="off" placeholder="Ataque espada" maxlength="30">
          <button class="shrink-0 bg-transparent border-0 border-b border-current rounded-none px-0 py-1 font-sans text-base text-ink-primary cursor-pointer hover:text-warm focus-visible:text-warm focus-visible:outline-none" id="btn-rol-guardar" type="submit">Guardar tirada</button>
        </div>
        <p class="m-0 mt-2 text-xs text-ink-tertiary">Guarda la tirada escrita arriba con este nombre. Se queda en este navegador.</p>
      </form>
    </section>

    <section class="w-full mt-12 sm:mt-16" aria-label="Historial de tiradas">
      <div class="flex flex-wrap items-baseline gap-4 pb-3 border-0 border-b border-(--divider-line)">
        <h2 class="m-0 font-display text-lg">Últimas tiradas</h2>
        <span class="flex-1 text-sm text-ink-tertiary tabular-nums" id="history-count"></span>
        <button class="bg-transparent border-0 border-b border-current rounded-none p-0 font-sans text-sm text-ink-secondary cursor-pointer hover:text-warm" id="btn-clear" type="button">Borrar</button>
      </div>
      <ol class="dice-history list-none m-0 p-0" id="history-list">
        <li class="history-empty">Sin tiradas aún</li>
      </ol>
    </section>

  </main>

  <AdSlot position="top" />

  {/* Texto provisional: solo se quitó lo que dejó de ser cierto (temas,
      sonido). La reescritura orientada a CTR es la fase de textos, con la
      skill decidelo-textos. */}
  <SeoArticle title="¿Cómo funciona el lanzamiento de dados virtual y por qué usarlo?">
    <p>Lanzar dados es una de las formas más antiguas de jugar y de decidir al azar. No siempre hay un par de dados a mano: esta herramienta para <strong>lanzar dados online</strong> te deja tirar de uno a seis dados de seis caras desde el móvil o el ordenador, gratis y sin registro.</p>

    <h2>Cómo tirar los dados</h2>
    <ol>
      <li><strong>Elige cuántos dados</strong> quieres lanzar, de 1 a 6. La herramienta lo recuerda para la próxima vez.</li>
      <li><strong>Pulsa &laquo;Lanzar dados&raquo;</strong>. Los dados vuelan, rebotan y ruedan sobre la mesa hasta quedarse quietos.</li>
      <li><strong>Lee el resultado</strong>: la suma en grande y, debajo, lo que sacó cada dado, en el mismo orden en que los ves.</li>
    </ol>
    <p>Las últimas diez tiradas quedan en el historial, guardado solo en tu navegador. Lo borras con &laquo;Borrar&raquo;.</p>

    <h2>Agitar el móvil para lanzar</h2>
    <p>En móviles con sensor de movimiento aparece el botón &laquo;Agitar el móvil para lanzar&raquo;. Actívalo y sacude el teléfono como si fuera un cubilete. Un golpe suelto, como dejar el móvil en la mesa, no cuenta: hace falta una sacudida clara.</p>

    <h2>¿Los dados virtuales son justos?</h2>
    <p>Sí. Cada valor sale del generador de números aleatorios criptográfico del navegador (<code>crypto.getRandomValues</code>), y las seis caras tienen exactamente la misma probabilidad. El resultado se decide antes de la animación: el giro y los botes solo lo enseñan. Cada tirada es independiente de la anterior.</p>

    <h2>Usar un dado para decidir</h2>
    <p>Un dado también sirve para salir de una duda con varias opciones: asigna un número a cada una (1 leer, 2 ordenar la habitación, 3 salir a caminar…) y lanza. Si tienes opciones con nombre, la <a href="/ruleta">ruleta de decisiones</a> es más cómoda; para dos opciones, lanza una <a href="/moneda">moneda</a>.</p>
  </SeoArticle>

  <AdSlot position="bottom" />

  <section class="hub-section wrap">
    <div class="section-header reveal">
      <div class="section-tag">🧰 Caja de Herramientas</div>
      <h2 class="section-heading">Prueba otras herramientas de decisión</h2>
    </div>
    <HubGrid activeToolId="dados" />
  </section>

  <script src="../scripts/dados.js"></script>
</Layout>

<style>
  /* Solo queda aquí lo que no puede ser utilidad: los estados que pone el
     JS y las filas que crea (Tailwind no rastrea src/scripts/). El resto
     de la página va en utilidades en el propio marcado; el dado, en
     Dice.astro. */

  /* El sitio no carga el preflight de Tailwind, así que nada gana a `.flex`
     cuando el JS pone `hidden`: sin esto, los bloques ocultos se verían */
  [hidden] {
    display: none !important;
  }

  .dice-result {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease-out, transform 0.25s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .dice-result.is-shown {
    opacity: 1;
    transform: none;
  }

  /* Historial: lista dividida por líneas de 1px, como el oráculo */
  .dice-history :global(.history-row) {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    column-gap: 0.75rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--divider-line);
  }

  .dice-history :global(.history-num) {
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
  }

  .dice-history :global(.history-label) {
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .dice-history :global(.history-side) {
    color: var(--text-tertiary);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .dice-history :global(.history-row.is-new) {
    animation: dice-row-in 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  @keyframes dice-row-in {
    from { opacity: 0; transform: translateY(-6px); }
  }

  /* Resultado largo (los seis valores de un personaje): más pequeño para
     que quepa en una línea a 344px */
  .dice-result.is-largo :global(#dice-result-main) {
    font-size: 1.3rem;
    line-height: 1.7;
  }

  @media (min-width: 640px) {
    .dice-result.is-largo :global(#dice-result-main) {
      font-size: 2rem;
      line-height: 1.5;
    }
  }

  .rol-error:empty {
    display: none;
  }

  /* Personaje y tiradas guardadas: filas que crea dados.js, divididas por
     líneas de 1px como el historial */
  .dice-personaje :global(.personaje-row),
  .dice-guardadas :global(.guardada-row) {
    display: grid;
    grid-template-columns: 2rem 2.5rem 1fr;
    column-gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--divider-line);
    font-variant-numeric: tabular-nums;
  }

  .dice-personaje :global(.personaje-num) {
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }

  .dice-personaje :global(.personaje-valor) {
    font-family: 'Outfit', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .dice-personaje :global(.personaje-dados) {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .dice-personaje :global(s) {
    color: var(--text-tertiary);
  }

  .dice-guardadas :global(.guardada-row) {
    grid-template-columns: 1fr auto;
    padding: 0;
  }

  .dice-guardadas :global(.guardada-tirar) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    min-width: 0;
    padding: 0.8rem 0;
    background: transparent;
    border: 0;
    text-align: left;
    font: inherit;
    color: var(--text-primary);
    cursor: pointer;
  }

  .dice-guardadas :global(.guardada-tirar:hover),
  .dice-guardadas :global(.guardada-tirar:focus-visible) {
    color: var(--accent-warm);
    outline: none;
  }

  .dice-guardadas :global(.guardada-expr) {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .dice-guardadas :global(.guardada-quitar) {
    padding: 0.8rem 0 0.8rem 0.75rem;
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 0.85rem;
    color: var(--text-tertiary);
    text-decoration: underline;
    cursor: pointer;
  }

  .dice-guardadas :global(.guardada-quitar:hover) {
    color: var(--accent-warm);
  }

  .dice-guardadas :global(.guardada-vacia) {
    padding: 0.8rem 0;
    color: var(--text-tertiary);
    font-size: 0.9rem;
    border-bottom: 1px solid var(--divider-line);
  }

  .dice-history :global(.history-empty) {
    padding: 0.8rem 0;
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  @media (min-width: 640px) {
    .dice-history :global(.history-row) {
      grid-template-columns: 2.5rem 1fr auto;
      column-gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dice-result { transform: none; }
    .dice-history :global(.history-row.is-new) { animation: none; }
  }

  .hub-section {
    padding: 3rem 0;
  }
</style>
