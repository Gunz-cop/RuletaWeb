---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import Coin from '../components/Coin.astro';
import { NOMBRES } from '../scripts/moneda-serie.js';
import HubGrid from '../components/HubGrid.astro';
import SeoArticle from '../components/SeoArticle.astro';
import { getSocialImageUrl } from '../lib/heroImages';

const title = 'Cara o Sello Online: Lanza la Moneda y Decide en 1 Segundo';
const description = '¿No te decides? Escribe tus dos opciones y deja que la moneda elija por ti. Cara o sello, cara o cruz o volado águila o sol. 50/50 real, gratis y sin registro.';
const keywords = 'cara o sello, cara o sello online, cara o cruz, cara o cruz online, lanzar moneda, tirar moneda, moneda online, volado, volado online, águila o sol, volado águila o sol, mejor de 3 moneda, lanzar varias monedas, escudo o corona, cara o ceca, cara ou coroa';

// La imagen vive en src/assets y la optimiza Astro; el JSON-LD necesita
// su URL absoluta ya generada, no la ruta pública que tenía antes.
const socialImage = await getSocialImageUrl('/blog/moneda.png');

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://decidelo.app/moneda#webapp",
      "name": "Cara o sello online — Decídelo.app",
      "description": "Moneda online para decidir entre dos opciones: cara o sello, cara o cruz o volado águila o sol. Una moneda, mejor de 3, mejor de 5 o varias a la vez. Gratis, sin registro y con historial local.",
      "url": "https://decidelo.app/moneda",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript and HTML5 3D Transforms",
      "softwareVersion": "2.0.0",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "image": socialImage,
      "screenshot": socialImage,
      "publisher": {
        "@type": "Organization",
        "@id": "https://decidelo.app/#organization",
        "name": "Decídelo.app",
        "url": "https://decidelo.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://decidelo.app/favicon.svg"
        }
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://decidelo.app/moneda#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo lanzar una moneda online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Escribe una opción para cada lado de la moneda, pulsa «Lanzar moneda» y espera a que caiga. El resultado aparece debajo y queda guardado en el historial de tu navegador."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cara o sello es lo mismo que cara o cruz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Es el mismo juego con otro nombre: cara o sello en Colombia, Chile, Perú y Ecuador; águila o sol (volado) en México; cara o ceca en Argentina; cara o cruz en España. Siempre hay dos resultados con la misma probabilidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es un volado águila o sol?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es el nombre que se usa en México para lanzar una moneda: «echar un volado». En la herramienta eliges «Águila o sol» en «Cómo se dice»."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo lanzar al mejor de 3 o varias monedas a la vez?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En «Modo» eliges una moneda, mejor de 3, mejor de 5 o varias monedas (de 2 a 5). En las series la moneda se lanza sola hasta que una opción consigue la mayoría."
          }
        },
        {
          "@type": "Question",
          "name": "¿La moneda online es realmente 50/50?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Cada lanzamiento usa el generador aleatorio criptográfico del navegador (crypto.getRandomValues), así que cara y sello tienen la misma probabilidad y ningún resultado depende del anterior."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se guardan mis resultados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solo un historial breve en tu propio navegador, que puedes borrar cuando quieras. No hace falta cuenta y tus opciones no se envían a ningún servidor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se decide quién saca en el fútbol con una moneda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según las Reglas de Juego de la IFAB, el árbitro lanza una moneda y el equipo que gana el sorteo decide hacia qué portería atacará en el primer tiempo o si hace el saque inicial. Aquí puedes hacer lo mismo: escribe el nombre de cada equipo en un lado y lanza."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo lanzar una moneda con alguien que está lejos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Escribe las dos opciones, lanza y pulsa «Compartir esta decisión». La otra persona recibe un enlace con la misma moneda y las mismas opciones para lanzarla ella también."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://decidelo.app/moneda#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://decidelo.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Lanzar Moneda",
          "item": "https://decidelo.app/moneda"
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} schemaLD={schemaLD} showHomeHeader={false}>
  <Fragment slot="head">
    {/* Newsreader itálica: acento del sistema editorial (ver DESIGN.md) */}
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  <main class="coin-layout wrap max-w-2xl lg:max-w-5xl pt-5 pb-8 sm:pt-8">

    <header class="coin-hero coin-area-hero text-center lg:text-left mb-5 sm:mb-6">
      <h1>Cara o cruz, <em>sin darle más vueltas</em></h1>
      <p class="coin-intro my-0 mx-auto lg:mx-0 max-w-lg text-sm sm:text-base text-ink-secondary">Escribe tus dos opciones y lanza la moneda. Cara o sello, volado águila o sol, cara o ceca: como se diga donde vives.</p>
    </header>

    <div class="coin-area-options grid grid-cols-[1fr_auto_1fr] items-end gap-4 w-full mb-4 sm:mb-8">
        <label class="coin-option flex flex-col gap-1.5 min-w-0">
          <span data-name-label="heads">Cara</span>
          <input id="option-heads" type="text" maxlength="40" placeholder="Pizza" autocomplete="off">
        </label>
        <span class="coin-options-vs" aria-hidden="true">o</span>
        <label class="coin-option flex flex-col gap-1.5 min-w-0">
          <span data-name-label="tails">Cruz</span>
          <input id="option-tails" type="text" maxlength="40" placeholder="Sushi" autocomplete="off">
        </label>
      </div>

    <section class="coin-area-stage flex flex-col items-center" aria-label="Lanzar moneda">
      <div id="coin-single">
        <Coin />
      </div>
      <div id="coin-multi" class="flex justify-center gap-2" hidden>
        {[1, 2, 3, 4, 5].map((i) => <Coin size="sm" uid={`m${i}`} />)}
      </div>

      <p class="coin-result" id="coin-result" aria-live="polite">
        <span class="coin-result-main" id="coin-result-main"></span>
        <span class="coin-result-side" id="coin-result-side"></span>
      </p>

      <button class="coin-flip-btn" id="btn-flip" type="button">Lanzar moneda</button>

      {/* Después del resultado: la pregunta de intuición y compartir */}
      <div id="coin-after" class="flex flex-col items-center gap-3 mt-6 w-full" hidden>
        <div id="coin-gut" class="flex flex-col items-center gap-2">
          <p class="coin-gut-q">¿Qué sentiste al verlo?</p>
          <div class="flex gap-6">
            <button class="coin-text-btn" id="gut-relief" type="button">Alivio</button>
            <button class="coin-text-btn" id="gut-disappoint" type="button">Decepción</button>
          </div>
          <p class="coin-gut-msg" id="gut-msg" aria-live="polite"></p>
          <button class="coin-mini-btn" id="gut-off" type="button">No preguntar más</button>
        </div>
        <button class="coin-text-btn" id="btn-share" type="button">Compartir esta decisión</button>
      </div>

    </section>

    <div class="coin-area-settings w-full">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 w-full mt-10 lg:mt-2">
        <label class="coin-field flex flex-col gap-1.5 min-w-0">
          <span>Modo</span>
          <select id="coin-mode">
            <option value="una">Una moneda</option>
            <option value="mejor3">Mejor de 3</option>
            <option value="mejor5">Mejor de 5</option>
            <option value="varias">Varias monedas</option>
          </select>
        </label>
        <label class="coin-field flex flex-col gap-1.5 min-w-0">
          <span>Cómo se dice</span>
          <select id="coin-names">
            {Object.entries(NOMBRES).map(([clave, n]) => <option value={clave}>{n.etiqueta}</option>)}
          </select>
        </label>
        <label class="coin-field flex flex-col gap-1.5 min-w-0" id="coin-count-field" hidden>
          <span>Monedas</span>
          <select id="coin-count">
            {[2, 3, 4, 5].map((n) => <option value={n}>{n}</option>)}
          </select>
        </label>
      </div>
      <p class="text-sm text-ink-tertiary mt-4 mb-0 w-full" id="coin-chapas" hidden>
        Con dos monedas también se juega a las <a href="/blog/moneda/juego-chapas">chapas</a>.
      </p>
    </div>

    <section class="coin-area-history mt-16" aria-label="Historial de lanzamientos">
      <div class="coin-history-head">
        <h2 class="m-0 font-display text-lg">Últimos lanzamientos</h2>
        <span class="flex-1 text-sm text-ink-tertiary tabular-nums" id="history-count"></span>
        <button class="coin-clear-btn" id="btn-clear" type="button">Borrar</button>
      </div>
      <ol class="history-list" id="history-list">
        <li class="history-empty">Sin lanzamientos aún</li>
      </ol>
    </section>

  </main>

  <AdSlot position="top" />

  <!-- Sección de Artículo SEO -->
  <SeoArticle title="Cara o sello online: cuando las dos opciones te valen, que decida la moneda">
    <p><strong>¿Llevas cinco minutos dudando entre dos opciones?</strong> Lanzar una moneda es la forma más rápida de decidir entre dos opciones que te valen igual. Según el país se dice <strong>cara o sello</strong>, <strong>cara o cruz</strong>, <strong>volado águila o sol</strong> o <strong>cara o ceca</strong>, pero el juego es el mismo: dos lados, un 50 % cada uno. Esta moneda online funciona en el móvil y en el ordenador, sin instalar nada y sin registro.</p>

    <p>Úsala para lo cotidiano (y <a href="#coin-single">pruébala ahora, está justo arriba</a>): quién empieza la partida, qué comer, qué equipo saca, qué tarea haces primero o cómo romper un empate entre amigos. No la uses para apuestas ni para decisiones médicas, legales o de dinero.</p>

    <h2>Cómo tirar una moneda online</h2>
    <ol>
      <li><strong>Escribe tus dos opciones:</strong> por ejemplo, cara = pizza y sello = sushi.</li>
      <li><strong>Elige el modo:</strong> una moneda, mejor de 3, mejor de 5 o varias monedas a la vez.</li>
      <li><strong>Pulsa &laquo;Lanzar moneda&raquo;:</strong> la moneda gira, cae y muestra qué opción ganó.</li>
      <li><strong>Fíjate en lo que sientes:</strong> si el resultado te da alivio o decepción, ya sabías qué preferías.</li>
    </ol>

    <h2>Cara o sello, cara o cruz, águila o sol: cómo se dice en cada país</h2>
    <p>Nombres según la tabla de Wikipedia<sup><a href="#fuente-1">[1]</a></sup>. La herramienta usa el nombre de tu país automáticamente y puedes cambiarlo en &laquo;Cómo se dice&raquo;.</p>
    <table>
      <thead>
        <tr><th>País</th><th>Cómo se dice</th></tr>
      </thead>
      <tbody>
        <tr><td>Colombia, Chile, Perú, Ecuador, Panamá</td><td>Cara o sello</td></tr>
        <tr><td>México</td><td>Volado: águila o sol</td></tr>
        <tr><td>Argentina</td><td>Cara o ceca</td></tr>
        <tr><td>Costa Rica</td><td>Escudo o corona</td></tr>
        <tr><td>Guatemala, Honduras, Bolivia</td><td>Cara o escudo</td></tr>
        <tr><td>España</td><td>Cara o cruz</td></tr>
        <tr><td>Brasil</td><td>Cara ou coroa</td></tr>
      </tbody>
    </table>

    <h2>Mejor de 3, mejor de 5 y varias monedas</h2>
    <p>Un solo lanzamiento es rápido, pero a veces el perdedor pide revancha. Para eso existen las series.</p>
    <h3>Mejor de 3</h3>
    <p>La moneda se lanza sola hasta que una opción gana dos veces. Es el formato ideal para discusiones entre dos personas: nadie puede quejarse de mala suerte en un único tiro.</p>
    <h3>Mejor de 5</h3>
    <p>Gana quien llega primero a tres. Úsalo para decisiones que importan un poco más, como el plan del fin de semana o quién elige la película durante un mes.</p>
    <h3>Varias monedas a la vez</h3>
    <p>Lanza de 2 a 5 monedas de golpe y verás cuántas caras y cuántos sellos salen. Sirve para juegos como las <a href="/blog/moneda/juego-chapas">chapas</a>, para clases de probabilidad o simplemente para ver el azar en acción. El marcador de cada serie queda guardado en el historial.</p>

    <h2>¿Es una moneda justa? El 50/50 explicado</h2>
    <p>Una moneda física no es perfecta. Diaconis, Holmes y Montgomery calcularon que una moneda lanzada con la mano cae del mismo lado con que empezó cerca del 51 % de las veces<sup><a href="#fuente-2">[2]</a></sup>, y un experimento de 2023 con <strong>350.757 lanzamientos reales</strong> lo confirmó: 50,8 %<sup><a href="#fuente-3">[3]</a></sup>. Aquí no pasa: cada resultado sale del generador de valores aleatorios criptográficamente fuertes del navegador (<code>crypto.getRandomValues</code>)<sup><a href="#fuente-4">[4]</a></sup>, con la <strong>misma probabilidad para cada lado</strong>. La animación solo muestra ese resultado; no lo decide. Y que haya salido sello tres veces seguidas no cambia la siguiente tirada: creer lo contrario es la llamada falacia del apostador<sup><a href="#fuente-5">[5]</a></sup>.</p>

    <h2>Por qué lanzar una moneda ayuda a decidir</h2>
    <p>Cuando dos opciones pesan lo mismo, una pregunta tan simple como &laquo;¿empiezo por la tarea A o por la B?&raquo; puede bloquearte un buen rato. La ciencia dice que la moneda ayuda más de lo que parece: en un estudio publicado en <em>PLOS ONE</em>, quienes lanzaban una moneda sentían con más fuerza qué opción preferían, incluso sin obedecerla<sup><a href="#fuente-6">[6]</a></sup>. Y en un experimento del economista Steven Levitt con miles de personas, quienes hicieron el cambio que les indicó la moneda se declaraban más felices seis meses después<sup><a href="#fuente-7">[7]</a></sup>. La moneda corta ese bucle:</p>
    <ul>
      <li><strong>Te saca del bloqueo:</strong> convierte la duda en un paso concreto en un segundo.</li>
      <li><strong>Te muestra lo que ya querías:</strong> mientras la moneda gira, sueles desear que salga un lado. Ese deseo es la respuesta, salga lo que salga.</li>
      <li><strong>Se comparte fácil:</strong> &laquo;Compartir esta decisión&raquo; crea un enlace con tus dos opciones para que otra persona lance la misma moneda.</li>
    </ul>

    <h2>Ideas para lanzar una moneda hoy mismo</h2>
    <p>¿No sabes para qué usarla? Estas son las decisiones que más se resuelven con un volado. Cópialas en la moneda de arriba y <a href="#coin-single">lánzala ahora</a>.</p>
    <table>
      <thead>
        <tr><th>Situación</th><th>Cara</th><th>Sello</th><th>Modo recomendado</th></tr>
      </thead>
      <tbody>
        <tr><td>¿Qué pedimos de comer?</td><td>Pizza</td><td>Hamburguesa</td><td>Una moneda</td></tr>
        <tr><td>¿Quién saca en el partido?</td><td>Equipo A</td><td>Equipo B</td><td>Una moneda</td></tr>
        <tr><td>¿Quién lava los platos?</td><td>Yo</td><td>Tú</td><td>Mejor de 3</td></tr>
        <tr><td>Plan del fin de semana</td><td>Playa</td><td>Montaña</td><td>Mejor de 5</td></tr>
        <tr><td>¿Qué serie vemos?</td><td>Comedia</td><td>Suspenso</td><td>Una moneda</td></tr>
        <tr><td>¿Qué tarea hago primero?</td><td>Correos</td><td>Informe</td><td>Una moneda</td></tr>
        <tr><td>Juego de chapas</td><td>Caras</td><td>Sellos</td><td>Varias monedas</td></tr>
      </tbody>
    </table>

    <h2>Trucos para decidir mejor con una moneda</h2>
    <h3>1. Pon solo opciones que aceptarías</h3>
    <p>La moneda es perfecta cuando las dos salidas te parecen bien. Si una opción te daría rabia, no la pongas: el azar no arregla una opción mala.</p>
    <h3>2. Escribe las opciones, no te las guardes en la cabeza</h3>
    <p>Poner nombre a cada lado evita el clásico &laquo;¿cara era la pizza o el sushi?&raquo;. En la herramienta el resultado aparece con tu opción escrita, así que nadie puede discutirlo.</p>
    <h3>3. Usa la prueba del alivio</h3>
    <p>Justo al ver el resultado, la herramienta te pregunta qué sentiste. Si sientes decepción, ya sabes que preferías la otra opción: puedes elegirla sin culpa. Si sientes alivio, adelante. Está comprobado: lanzar la moneda intensifica esa reacción y te ayuda a ver lo que querías<sup><a href="#fuente-6">[6]</a></sup>.</p>
    <h3>4. Para decisiones de grupo, comparte el enlace</h3>
    <p>Con &laquo;Compartir esta decisión&raquo; mandas la misma moneda por WhatsApp. Todos ven las mismas opciones y nadie puede decir que hiciste trampa.</p>
    <h3>5. Si hay más de dos opciones, cambia de herramienta</h3>
    <p>La moneda solo tiene dos lados. Para tres o más opciones usa la <a href="/ruleta">ruleta de decisiones</a>, que admite tantas como quieras.</p>

    <h2>¿Moneda, ruleta, dados o sí o no? Elige la herramienta correcta</h2>
    <p>Decídelo.app tiene una herramienta para cada tipo de duda. Todas son gratis, funcionan en el móvil y no piden registro.</p>
    <table>
      <thead>
        <tr><th>Si necesitas…</th><th>Usa</th></tr>
      </thead>
      <tbody>
        <tr><td>Elegir entre dos opciones</td><td>Esta moneda: cara o sello</td></tr>
        <tr><td>Elegir entre tres o más opciones o nombres</td><td><a href="/ruleta">Ruleta aleatoria</a></td></tr>
        <tr><td>Una respuesta rápida a una pregunta</td><td><a href="/si-o-no">Sí o no</a></td></tr>
        <tr><td>Tirar dados para un juego de mesa</td><td><a href="/dados">Dados online</a></td></tr>
        <tr><td>Un número al azar para un sorteo</td><td><a href="/numeros">Número aleatorio</a></td></tr>
        <tr><td>Armar equipos parejos</td><td><a href="/equipos">Generador de equipos</a></td></tr>
        <tr><td>Resolver un empate jugando</td><td><a href="/piedra-papel-tijera">Piedra, papel o tijera</a></td></tr>
        <tr><td>Organizar el intercambio de regalos</td><td><a href="/amigo-secreto">Amigo secreto online</a></td></tr>
        <tr><td>Medir tiempo por turnos</td><td><a href="/temporizador">Temporizador</a></td></tr>
      </tbody>
    </table>

    <h2>¿Por qué se dice cara o sello?</h2>
    <p>Lanzar una moneda para decidir es un juego muy antiguo. El escritor romano Macrobio cuenta en las <em>Saturnales</em> que los niños lanzaban monedas al aire gritando <em>capita aut navia</em>, &laquo;cabezas o barco&raquo;, porque las monedas antiguas tenían una cabeza de Jano en un lado y un barco en el otro<sup><a href="#fuente-8">[8]</a></sup>. Hoy cada país tiene su propio nombre para el mismo juego: <strong>cara o sello</strong> en Colombia, <strong>cara o cruz</strong> en España, <strong>águila o sol</strong> en México<sup><a href="#fuente-1">[1]</a></sup>. Cambia el nombre, pero la regla es idéntica en todas partes: dos lados, la misma oportunidad.</p>

    <h2>Deja de dudar: lanza la moneda ahora</h2>
    <p>Llevas leyendo un buen rato y la decisión sigue ahí esperando. Sube a la <a href="#coin-single">moneda online</a>, escribe tus dos opciones y pulsa &laquo;Lanzar moneda&raquo;. En un segundo tendrás tu respuesta y, con la prueba del alivio, sabrás si de verdad era la que querías. Y si la duda tiene más de dos caminos, gira la <a href="/ruleta">ruleta</a> o pregunta al <a href="/si-o-no">oráculo de sí o no</a>.</p>

    <h2>Preguntas frecuentes</h2>
    <h3>¿Cómo lanzar una moneda online?</h3>
    <p>Escribe una opción para cada lado de la moneda, pulsa &laquo;Lanzar moneda&raquo; y espera a que caiga. El resultado aparece debajo y queda guardado en el historial de tu navegador.</p>

    <h3>¿Cara o sello es lo mismo que cara o cruz?</h3>
    <p>Sí. Es el mismo juego con otro nombre: cara o sello en Colombia, Chile, Perú y Ecuador; águila o sol (volado) en México; cara o ceca en Argentina; cara o cruz en España. Siempre hay dos resultados con la misma probabilidad.</p>

    <h3>¿Qué es un volado águila o sol?</h3>
    <p>Es el nombre que se usa en México para lanzar una moneda: &laquo;echar un volado&raquo;. En la herramienta eliges &laquo;Águila o sol&raquo; en &laquo;Cómo se dice&raquo;.</p>

    <h3>¿Puedo lanzar al mejor de 3 o varias monedas a la vez?</h3>
    <p>Sí. En &laquo;Modo&raquo; eliges una moneda, mejor de 3, mejor de 5 o varias monedas (de 2 a 5). En las series la moneda se lanza sola hasta que una opción consigue la mayoría.</p>

    <h3>¿La moneda online es realmente 50/50?</h3>
    <p>Sí. Cada lanzamiento usa el generador aleatorio criptográfico del navegador (<code>crypto.getRandomValues</code>), así que cara y sello tienen la misma probabilidad y ningún resultado depende del anterior.</p>

    <h3>¿Se guardan mis resultados?</h3>
    <p>Solo un historial breve en tu propio navegador, que puedes borrar cuando quieras. No hace falta cuenta y tus opciones no se envían a ningún servidor.</p>

    <h3>¿Cómo se decide quién saca en el fútbol con una moneda?</h3>
    <p>Según las Reglas de Juego de la IFAB, el árbitro lanza una moneda y el equipo que gana el sorteo decide hacia qué portería atacará en el primer tiempo o si hace el saque inicial<sup><a href="#fuente-9">[9]</a></sup>. Aquí puedes hacer lo mismo: escribe el nombre de cada equipo en un lado y lanza.</p>

    <h3>¿Puedo lanzar una moneda con alguien que está lejos?</h3>
    <p>Sí. Escribe las dos opciones, lanza y pulsa &laquo;Compartir esta decisión&raquo;. La otra persona recibe un enlace con la misma moneda y las mismas opciones para lanzarla ella también.</p>

