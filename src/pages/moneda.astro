---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import Coin from '../components/Coin.astro';
import { NOMBRES } from '../scripts/moneda-serie.js';
import HubGrid from '../components/HubGrid.astro';
import SeoArticle from '../components/SeoArticle.astro';
import { getSocialImageUrl } from '../lib/heroImages';

const title = 'Cara o Cruz y Cara o Sello Online — Lanzar Moneda | Decídelo.app';
const description = 'Lanza una moneda online con tus dos opciones: cara o cruz, cara o sello, águila o sol. Una moneda, mejor de 3 o de 5, o varias a la vez. Gratis, sin registro y con enlace para compartir.';
const keywords = 'cara o cruz online, lanzar moneda, tirar moneda, tira una moneda, cara o sello, moneda online, moneda virtual, lanzar una moneda, volado online, mejor de 3 moneda, lanzar varias monedas, escudo o corona';

// La imagen vive en src/assets y la optimiza Astro; el JSON-LD necesita
// su URL absoluta ya generada, no la ruta pública que tenía antes.
const socialImage = await getSocialImageUrl('/blog/moneda.png');

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://decidelo.app/moneda#webapp",
      "name": "Lanzar Moneda Online — Decídelo.app",
      "description": "Herramienta online para lanzar una moneda y decidir entre cara o cruz, cara o sello o dos opciones equivalentes. Gratis, sin registro y con historial local.",
      "url": "https://decidelo.app/moneda",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript and HTML5 3D Transforms",
      "softwareVersion": "2.0.0",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "image": socialImage,
      "screenshot": socialImage,
      "publisher": {
        "@type": "Organization",
        "@id": "https://decidelo.app/#organization",
        "name": "Decídelo.app",
        "url": "https://decidelo.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://decidelo.app/favicon.svg"
        }
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://decidelo.app/moneda#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo lanzar cara o cruz online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Abre la herramienta, asigna una opción a cara y otra a cruz, pulsa Lanzar y espera el resultado. El historial local muestra los últimos lanzamientos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cara o sello es lo mismo que cara o cruz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En muchos países se dice cara o sello, águila o sol, volado o cara o cruz. La dinámica es la misma: dos resultados posibles con probabilidad equivalente."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo lanzar al mejor de 3 o varias monedas a la vez?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. En Modo puedes elegir una moneda, mejor de 3, mejor de 5 o varias monedas (de 2 a 5). En las series la moneda se lanza sola hasta que una opción consigue la mayoría."
          }
        },
        {
          "@type": "Question",
          "name": "¿La moneda online guarda mis resultados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solo se guarda un historial breve en tu navegador mediante almacenamiento local. No necesitas cuenta y tus decisiones no se envían a un servidor."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://decidelo.app/moneda#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://decidelo.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Lanzar Moneda",
          "item": "https://decidelo.app/moneda"
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} schemaLD={schemaLD} showHomeHeader={false}>
  <Fragment slot="head">
    {/* Newsreader itálica: acento del sistema editorial (ver DESIGN.md) */}
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  <main class="coin-layout wrap max-w-2xl lg:max-w-5xl pt-5 pb-8 sm:pt-8">

    <header class="coin-hero coin-area-hero text-center lg:text-left mb-5 sm:mb-6">
      <h1>Cara o cruz, <em>sin darle más vueltas</em></h1>
      <p class="coin-intro my-0 mx-auto lg:mx-0 max-w-lg text-sm sm:text-base text-ink-secondary">Escribe tus dos opciones y lanza. Cara o sello, águila o sol, escudo o corona: como se diga donde vives.</p>
    </header>

    <div class="coin-area-options grid grid-cols-[1fr_auto_1fr] items-end gap-4 w-full mb-4 sm:mb-8">
        <label class="coin-option flex flex-col gap-1.5 min-w-0">
          <span data-name-label="heads">Cara</span>
          <input id="option-heads" type="text" maxlength="40" placeholder="Pizza" autocomplete="off">
        </label>
        <span class="coin-options-vs" aria-hidden="true">o</span>
        <label class="coin-option flex flex-col gap-1.5 min-w-0">
          <span data-name-label="tails">Cruz</span>
          <input id="option-tails" type="text" maxlength="40" placeholder="Sushi" autocomplete="off">
        </label>
      </div>

    <section class="coin-area-stage flex flex-col items-center" aria-label="Lanzar moneda">
      <div id="coin-single">
        <Coin />
      </div>
      <div id="coin-multi" class="flex justify-center gap-2" hidden>
        {[1, 2, 3, 4, 5].map((i) => <Coin size="sm" uid={`m${i}`} />)}
      </div>

      <p class="coin-result" id="coin-result" aria-live="polite">
        <span class="coin-result-main" id="coin-result-main"></span>
        <span class="coin-result-side" id="coin-result-side"></span>
      </p>

      <button class="coin-flip-btn" id="btn-flip" type="button">Lanzar moneda</button>

      {/* Después del resultado: la pregunta de intuición y compartir */}
      <div id="coin-after" class="flex flex-col items-center gap-3 mt-6 w-full" hidden>
        <div id="coin-gut" class="flex flex-col items-center gap-2">
          <p class="coin-gut-q">¿Qué sentiste al verlo?</p>
          <div class="flex gap-6">
            <button class="coin-text-btn" id="gut-relief" type="button">Alivio</button>
            <button class="coin-text-btn" id="gut-disappoint" type="button">Decepción</button>
          </div>
          <p class="coin-gut-msg" id="gut-msg" aria-live="polite"></p>
          <button class="coin-mini-btn" id="gut-off" type="button">No preguntar más</button>
        </div>
        <button class="coin-text-btn" id="btn-share" type="button">Compartir esta decisión</button>
      </div>

    </section>

    <div class="coin-area-settings w-full">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 w-full mt-10 lg:mt-2">
        <label class="coin-field flex flex-col gap-1.5 min-w-0">
          <span>Modo</span>
          <select id="coin-mode">
            <option value="una">Una moneda</option>
            <option value="mejor3">Mejor de 3</option>
            <option value="mejor5">Mejor de 5</option>
            <option value="varias">Varias monedas</option>
          </select>
        </label>
        <label class="coin-field flex flex-col gap-1.5 min-w-0">
          <span>Cómo se dice</span>
          <select id="coin-names">
            {Object.entries(NOMBRES).map(([clave, n]) => <option value={clave}>{n.etiqueta}</option>)}
          </select>
        </label>
        <label class="coin-field flex flex-col gap-1.5 min-w-0" id="coin-count-field" hidden>
          <span>Monedas</span>
          <select id="coin-count">
            {[2, 3, 4, 5].map((n) => <option value={n}>{n}</option>)}
          </select>
        </label>
      </div>
      <p class="text-sm text-ink-tertiary mt-4 mb-0 w-full" id="coin-chapas" hidden>
        Con dos monedas también se juega a las <a href="/blog/moneda/juego-chapas">chapas</a>.
      </p>
    </div>

    <section class="coin-area-history mt-16" aria-label="Historial de lanzamientos">
      <div class="coin-history-head">
        <h2 class="m-0 font-display text-lg">Últimos lanzamientos</h2>
        <span class="flex-1 text-sm text-ink-tertiary tabular-nums" id="history-count"></span>
        <button class="coin-clear-btn" id="btn-clear" type="button">Borrar</button>
      </div>
      <ol class="history-list" id="history-list">
        <li class="history-empty">Sin lanzamientos aún</li>
      </ol>
    </section>

  </main>

  <AdSlot position="top" />

  <!-- Sección de Artículo SEO -->
  <SeoArticle title="¿Cómo funciona el Lanzamiento de Moneda Online y por qué usarlo?">
    <p>El lanzamiento de una moneda al aire, conocido como <strong>cara o cruz</strong>, <strong>cara o sello</strong>, <strong>águila o sol</strong> o <strong>volado</strong> según el país, es una de las formas más rápidas de decidir entre dos opciones equivalentes. En Decídelo.app puedes tirar una moneda online desde el móvil o el ordenador sin instalar nada.</p>
    
    <p>La herramienta sirve para decisiones de baja consecuencia: quién empieza, qué opción probar primero, qué turno sigue, qué actividad hacer o cómo romper un empate amistoso. No está pensada para apuestas, decisiones legales, médicas, financieras o situaciones donde haga falta criterio profesional.</p>

    <h2>Cómo usar cara o cruz online en 10 segundos</h2>
    <ol>
      <li><strong>Define las opciones:</strong> por ejemplo, Cara = pizza y Cruz = sushi.</li>
      <li><strong>Comprueba que ambas opciones son aceptables:</strong> si una opción no te sirve, no uses azar.</li>
      <li><strong>Pulsa Lanzar:</strong> la moneda girará y mostrará el resultado.</li>
      <li><strong>Respeta el resultado o escucha tu reacción:</strong> si sientes alivio o decepción, quizá ya sabías qué preferías.</li>
    </ol>

    <h2>Ideas rápidas para tirar una moneda</h2>
    <table>
      <thead>
        <tr>
          <th>Situación</th>
          <th>Cara</th>
          <th>Cruz</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Comida</td>
          <td>Pizza</td>
          <td>Sushi</td>
        </tr>
        <tr>
          <td>Turno inicial</td>
          <td>Empieza equipo A</td>
          <td>Empieza equipo B</td>
        </tr>
        <tr>
          <td>Tareas</td>
          <td>Responder correos</td>
          <td>Preparar presentación</td>
        </tr>
        <tr>
          <td>Casa</td>
          <td>Lavar platos</td>
          <td>Sacar basura</td>
        </tr>
      </tbody>
    </table>

    <h2>La ciencia detrás del 50/50 y la toma de decisiones</h2>
    <p>Desde un punto de vista matemático, una moneda ideal ofrece un <strong>50% de probabilidad</strong> de obtener cara y un 50% de obtener cruz. En una moneda física influyen el impulso, la superficie, el lado inicial y la forma de atraparla. En esta moneda online el resultado se decide con aleatoriedad del navegador mediante <code>crypto.getRandomValues</code> cuando está disponible, y la animación 3D representa visualmente el resultado.</p>

    <h2>Ventajas de lanzar una moneda para indecisión cotidiana</h2>
    <p>Para personas que sufren de fatiga por decisiones o con neurodivergencias como el <strong>TDAH</strong>, elegir entre dos opciones simples (¿debería empezar a estudiar ahora o tomar un vaso de agua?, ¿hago primero la tarea A o la tarea B?) puede provocar un bloqueo mental prolongado o parálisis por análisis. El lanzamiento de moneda actúa como un catalizador cognitivo:</p>
    <ul>
      <li><strong>Elimina el bloqueo inmediato:</strong> Reduce el abanico de infinitas opciones a un simple disparador binario externo.</li>
      <li><strong>Filtra tus verdaderos deseos:</strong> A menudo, mientras la moneda está girando en el aire, tu mente experimenta una respuesta emocional espontánea. Sientes el deseo secreto de que salga "cara". En ese preciso segundo, descubres qué es lo que realmente querías elegir en tu fuero interno, independientemente de lo que muestre el resultado final.</li>
      <li><strong>Historial breve:</strong> Puedes revisar los últimos resultados sin convertir la herramienta en una estadística complicada.</li>
    </ul>

    <h2>Preguntas frecuentes sobre cara o cruz online</h2>
    <h3>¿Cara o sello es lo mismo que cara o cruz?</h3>
    <p>Sí. La expresión cambia por país: cara o cruz, cara o sello, águila o sol, volado o tirar moneda. En todos los casos se trata de elegir entre dos resultados posibles.</p>

    <h3>¿Puedo lanzar al mejor de 3 o varias monedas a la vez?</h3>
    <p>Sí. En Modo puedes elegir una moneda, mejor de 3, mejor de 5 o varias monedas (de 2 a 5). En las series la moneda se lanza sola hasta que una opción consigue la mayoría, y el marcador queda en el historial.</p>

    <h3>¿Puedo compartir el resultado?</h3>
    <p>Sí. Después de lanzar, "Compartir esta decisión" genera un enlace con tus dos opciones ya escritas, para que otra persona lance la misma moneda. El enlace no incluye tu historial.</p>

    <h3>¿Puedo usarlo para sorteos importantes?</h3>
    <p>Para decisiones importantes conviene usar reglas más formales y documentadas. Esta herramienta está pensada para decisiones rápidas, juegos, turnos y dinámicas recreativas.</p>

    <h3>¿Dónde se guarda el historial?</h3>
    <p>El historial se guarda localmente en tu navegador y puedes borrarlo desde el botón de la herramienta. No necesitas crear cuenta.</p>

    <h2>Guías relacionadas</h2>
    <ul>
      <li><a href="/blog/moneda/decision-moneda">Cómo decidir con cara o cruz sin arrepentirte</a></li>
      <li><a href="/blog/moneda/cara-o-cruz-lanzamiento-probabilidad">Probabilidad al lanzar una moneda</a></li>
      <li><a href="/blog/moneda/cara-o-cruz-ciencia">La ciencia detrás de cara o cruz</a></li>
    </ul>

  </SeoArticle>

  <AdSlot position="bottom" />

  <section class="hub-section wrap">
    <div class="section-header reveal">
      <div class="section-tag">🧰 Caja de Herramientas</div>
      <h2 class="section-heading">Prueba otras herramientas de decisión</h2>
    </div>
    <HubGrid activeToolId="moneda" />
  </section>

  <script src="../scripts/moneda.js"></script>
</Layout>

<style>
  .coin-hero h1 {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .coin-hero em {
    font-family: 'Newsreader', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--accent-warm);
  }

  /* Opciones: dos campos subrayados, sin cajas */
  .coin-option span,
  .coin-field span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .coin-option input {
    width: 100%;
    padding: 0.4rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--divider-line);
    border-radius: 0;
    color: var(--text-primary);
    font: inherit;
    font-size: 1.15rem;
  }

  .coin-option input::placeholder {
    color: var(--text-tertiary);
  }

  .coin-option input:focus {
    outline: none;
    border-bottom-color: var(--accent-warm);
  }

  .coin-options-vs {
    font-family: 'Newsreader', Georgia, serif;
    font-style: italic;
    color: var(--text-tertiary);
    padding-bottom: 0.45rem;
  }

  /* El sitio no carga el preflight de Tailwind, así que nada gana a `.flex`
     cuando el JS pone `hidden`: sin esto, los bloques ocultos se verían */
  [hidden] {
    display: none !important;
  }

  /* Ajustes: selects nativos con el mismo subrayado que los campos */
  .coin-field select {
    width: 100%;
    padding: 0.4rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--divider-line);
    border-radius: 0;
    color: var(--text-primary);
    color-scheme: dark;
    font: inherit;
    font-size: 1rem;
  }

  .coin-field select:focus-visible {
    outline: none;
    border-bottom-color: var(--accent-warm);
  }

  /* Botones de texto: acción secundaria, subrayada, nunca rellena */
  .coin-text-btn,
  .coin-mini-btn {
    background: none;
    border: 0;
    padding: 0.25rem 0;
    color: var(--text-primary);
    font: inherit;
    border-bottom: 1px solid var(--divider-line);
    cursor: pointer;
  }

  .coin-text-btn:hover,
  .coin-text-btn:focus-visible,
  .coin-text-btn[aria-pressed="true"] {
    outline: none;
    color: var(--accent-warm);
    border-bottom-color: currentColor;
  }

  .coin-mini-btn {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    border-bottom: 0;
  }

  .coin-gut-q {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .coin-gut-msg {
    margin: 0;
    max-width: 30rem;
    text-align: center;
    color: var(--text-primary);
  }

  .coin-gut-msg:empty {
    display: none;
  }

  .coin-gut-msg :global(em) {
    font-family: 'Newsreader', Georgia, serif;
    font-style: italic;
    color: var(--accent-warm);
  }

  /* Resultado */
  .coin-result {
    min-height: 4.5rem;
    margin: 1.5rem 0 1rem;
    text-align: center;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
  }

  .coin-result.is-shown {
    opacity: 1;
    transform: none;
  }

  .coin-result-main {
    display: block;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 7vw, 3rem);
    line-height: 1.1;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .coin-result-side {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  /* Botón principal: acento liso, sin degradado ni glow */
  .coin-flip-btn {
    padding: 0.9rem 2.2rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent-warm);
    color: #1a0e06;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    cursor: pointer;
    transition: transform 0.15s ease-out, opacity 0.15s ease-out;
  }

  .coin-flip-btn:active {
    transform: scale(0.97);
  }

  .coin-flip-btn:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .coin-flip-btn:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 3px;
  }

  /* Historial: lista dividida por líneas de 1px */

  .coin-history-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--divider-line);
  }

  .coin-clear-btn {
    background: none;
    border: 0;
    padding: 0;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.85rem;
    border-bottom: 1px solid currentColor;
    cursor: pointer;
  }

  .coin-clear-btn:hover {
    color: var(--accent-warm);
  }

  .history-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .history-list :global(.history-row) {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--divider-line);
  }

  .history-list :global(.history-num) {
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
  }

  .history-list :global(.history-label) {
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .history-list :global(.history-side) {
    color: var(--text-tertiary);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .history-list :global(.history-empty) {
    padding: 0.8rem 0;
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .hub-section {
    padding: 3rem 0;
  }

  /* Móvil: el botón de lanzar debe quedar a la vista sin hacer scroll
     (unos 660px útiles en un iPhone con la barra de Safari) */
  /* Escritorio y tablet horizontal: dos columnas. A la izquierda lo que se
     escribe y se ajusta, a la derecha la moneda y el botón. En una sola
     columna la página medía ~900px y en un portátil de 720px de alto el
     botón quedaba fuera de pantalla. El orden del HTML sigue siendo el de
     móvil; las áreas solo recolocan. */
  @media (min-width: 1024px) {
    .coin-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "hero stage"
        "options stage"
        "settings stage"
        "history history";
      grid-template-rows: auto auto 1fr auto;
      column-gap: 4rem;
      align-items: start;
    }

    .coin-area-hero { grid-area: hero; }
    .coin-area-options { grid-area: options; }
    .coin-area-settings { grid-area: settings; }
    .coin-area-history { grid-area: history; }

    .coin-area-stage {
      grid-area: stage;
      padding-top: 4rem;
    }

    .coin-hero h1 {
      font-size: 2.75rem;
    }
  }

  /* Pantallas bajas (Android con barra de Chrome, iPhone SE): la entradilla
     cede su sitio para que el botón de lanzar quepa sin scroll */
  @media (max-width: 639px) and (max-height: 620px) {
    .coin-intro {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .coin-hero h1 {
      font-size: 1.7rem;
      margin-bottom: 0.5rem;
    }

    .coin-result {
      min-height: 3.25rem;
      margin: 0.25rem 0 0.5rem;
    }

    .coin-result-main {
      font-size: 1.75rem;
