        <tr><td>Elegir a una persona entre varias</td><td><a href="/ruleta">Ruleta de nombres</a></td></tr>
        <tr><td>Sacar un número en un rango</td><td><a href="/numeros">Número aleatorio</a></td></tr>
        <tr><td>Tirar dados para un juego de mesa</td><td><a href="/dados">Dados online</a></td></tr>
