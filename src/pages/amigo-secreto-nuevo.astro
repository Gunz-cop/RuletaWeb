---
// Amigo secreto, versión nueva en pruebas (SDD de amigo secreto).
// Se publica en /amigo-secreto-nuevo con noindex y fuera del sitemap para
// probarla en producción; /amigo-secreto sigue con la página de siempre.
//
// Sistema editorial de DESIGN.md: hero corto, campos subrayados, listas
// divididas por líneas, un solo botón relleno (Sortear) y el acento
// --accent-warm. El sobre es el objeto ilustrado (Envelope.astro).
//
// Dos pantallas en la misma URL: organizar (por defecto) y abrir el sobre
// (#revelar= o #v=2). El marcado que el JS repite vive aquí en <template>
// para que Tailwind vea sus clases; el JS solo clona y rellena.
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import HubGrid from '../components/HubGrid.astro';
import Envelope from '../components/Envelope.astro';
import AmigoSecretoArticulo from '../components/AmigoSecretoArticulo.astro';
import { title, description, keywords, schemaLD } from '../data/amigo-secreto-seo.js';
import { getSocialImageUrl } from '../lib/heroImages';

const socialImage = await getSocialImageUrl('/blog/amigo-secreto.png');

const etiqueta = 'text-xs font-semibold uppercase tracking-[0.12em] text-ink-tertiary';
const campo = 'as-campo w-full min-w-0 border-0 border-b bg-transparent px-0 py-2.5 text-base text-ink-primary placeholder:text-ink-tertiary focus:outline-none';
const textoBoton = 'as-enlace inline-flex items-center gap-1.5 border-0 bg-transparent p-0 text-sm font-semibold cursor-pointer';
const fila = 'group border-t first:border-t-0';
const resumen = 'flex cursor-pointer list-none items-baseline gap-3 py-4 text-base text-ink-primary [&::-webkit-details-marker]:hidden';
---

<Layout title={`${title} (versión nueva)`} description={description} keywords={keywords} schemaLD={schemaLD(socialImage)} robots="noindex, nofollow" canonical="https://decidelo.app/amigo-secreto" showHomeHeader={false}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  <main id="as-app" class="as-page wrap max-w-2xl lg:max-w-5xl pt-5 pb-10 sm:pt-8" data-modo="organizar">

    <!-- ============ ORGANIZAR ============ -->
    <section id="organizer-screen" class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-x-16" aria-label="Organizar el sorteo">
      <div>
        <div class="mb-5 text-center sm:mb-8 lg:text-left">
          <h1 class="as-h1 m-0">Amigo secreto, <em>sin papelitos</em></h1>
          <p class="as-intro mx-auto mt-2 mb-0 max-w-md text-sm text-ink-secondary sm:mt-3 sm:text-base lg:mx-0">Escribe quiénes participan y sortea. Luego cada uno recibe su enlace o abre su sobre en este mismo teléfono.</p>
        </div>

        <div id="saved-draw" class="as-linea mb-6 border-y py-4" role="region" aria-label="Sorteo guardado" hidden>
          <p class="m-0 text-sm text-ink-secondary" data-saved-info></p>
          <div class="mt-2 flex gap-5">
            <button type="button" class={textoBoton + ' text-warm'} data-saved-restore>Recuperar ese sorteo</button>
            <button type="button" class={textoBoton + ' text-ink-tertiary'} data-saved-clear>Borrarlo</button>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <div class="flex items-baseline justify-between gap-3">
            <label for="participants-textarea" class={etiqueta}>Quiénes participan</label>
            <span id="participants-count" class="text-sm tabular-nums text-ink-tertiary" aria-live="polite">0 personas</span>
          </div>
          <textarea id="participants-textarea" rows="2" class={campo + ' as-lista resize-none font-[inherit] leading-relaxed'} placeholder="Ana, Bruno, Carla, Diego…" spellcheck="false" autocomplete="off" aria-describedby="as-ayuda-lista"></textarea>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p id="as-ayuda-lista" class="m-0 text-xs text-ink-tertiary">Sepáralos con comas o uno por línea.</p>
            <div class="flex flex-wrap gap-x-4 gap-y-1">
              <label class={textoBoton + ' relative text-warm'}>
                Subir Excel o CSV
                <input id="csv-file-input" type="file" accept=".csv,.txt,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="absolute inset-0 cursor-pointer opacity-0" aria-label="Subir la lista en un archivo Excel o CSV">
              </label>
              <button type="button" id="as-contactos" class={textoBoton + ' text-warm'} hidden>De mis contactos</button>
            </div>
          </div>
          <ul id="participants-tags-container" class="m-0 mt-1 flex list-none flex-wrap gap-1.5 p-0" aria-label="Participantes"></ul>
          <!-- 2: visible justo bajo los nombres, en cuanto hay dos -->
          <button type="button" id="as-emparejar" class={textoBoton + ' self-start text-left text-ink-secondary aria-pressed:text-warm'} aria-pressed="false" hidden>¿Alguien no debe regalarle a alguien? Toca sus dos nombres</button>
        </div>

        <p id="draw-warning" class="m-0 mt-4 border-l-2 border-warm pl-3 text-sm leading-relaxed text-ink-secondary" role="status" aria-live="polite" hidden></p>

        <button type="button" id="btn-draw" class="as-boton mt-5 w-full sm:w-auto" disabled>Sortear</button>
        <p id="as-falta" class="m-0 mt-2 text-xs text-ink-tertiary">Hacen falta al menos 2 personas.</p>

        <!-- Opcional: plegado y señalado como tal -->
        <div class="mt-8">
          <p class="m-0 flex flex-wrap items-baseline gap-x-2">
            <span class="font-display text-lg font-semibold text-warm">Opcional</span>
            <span class="text-sm text-ink-secondary">Puedes sortear sin llenar nada de esto.</span>
          </p>
          <div class="as-linea mt-1 border-b">
            <details id="exclusions-details" class={'as-linea ' + fila}>
              <summary class={resumen}>
                <span class="flex-1">Quiénes no deben regalarse entre sí</span>
                <span id="as-excl-cuenta" class="text-sm text-warm"></span>
                <span class="text-ink-tertiary transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="flex flex-col gap-3 pb-5">
                <p class="m-0 text-sm text-ink-secondary">Por ejemplo, una pareja o dos hermanos: ninguno le regalará al otro. Toca sus nombres arriba o escríbelos aquí, una pareja por línea:</p>
                <textarea id="exclusions-textarea" rows="2" class={campo + ' resize-none font-[inherit]'} placeholder="Ana, Luis" spellcheck="false" autocomplete="off" aria-label="Quiénes no deben regalarse entre sí"></textarea>
                <p class="m-0 text-xs text-ink-tertiary">Para un solo sentido usa «&gt;»: <em>Ana &gt; Luis</em> quiere decir que Ana no le regala a Luis, pero Luis sí puede regalarle a Ana.</p>
              </div>
            </details>

            <details id="as-detalles" class={'as-linea ' + fila}>
              <summary class={resumen}>
                <span class="flex-1">Presupuesto, fecha y lugar</span>
                <span class="text-ink-tertiary transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="grid grid-cols-2 gap-x-5 gap-y-4 pb-5">
                <p class="col-span-2 m-0 text-sm text-ink-secondary">Cada persona lo verá al abrir su sobre.</p>
                <label class="col-span-2 flex flex-col"><span class={etiqueta}>Nombre del grupo</span><input id="as-grupo" class={campo} maxlength="60" placeholder="Oficina, familia…" autocomplete="off"></label>
                <label class="flex flex-col"><span class={etiqueta}>Presupuesto</span><input id="as-presupuesto" class={campo} inputmode="numeric" maxlength="12" placeholder="50.000" autocomplete="off"></label>
                <label class="flex flex-col"><span class={etiqueta}>Fecha</span><input id="as-fecha" type="date" class={campo + ' [color-scheme:dark]'}></label>
                <label class="col-span-2 flex flex-col"><span class={etiqueta}>Lugar</span><input id="as-lugar" class={campo} maxlength="80" placeholder="Casa de Ana" autocomplete="off"></label>
                <label class="col-span-2 flex flex-col"><span class={etiqueta}>Mensaje para todos</span><input id="as-mensaje" class={campo} maxlength="140" placeholder="Nada de medias, por favor" autocomplete="off"></label>
              </div>
            </details>

            <details id="as-mas" class={'as-linea ' + fila}>
              <summary class={resumen}>
                <span class="flex-1">Celulares y pistas</span>
                <span class="text-ink-tertiary transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="flex flex-col gap-2 pb-5 text-sm text-ink-secondary">
                <p class="m-0">Con el celular de cada uno, el botón de WhatsApp abre su chat directo. Escríbelo junto al nombre: <em>Ana 3001234567</em>.</p>
                <p class="m-0">Para dejar una pista a quien le regala, después de «|»: <em>Ana | le gusta el café</em>.</p>
              </div>
            </details>
          </div>
        </div>
      </div>

      <!-- Resultado -->
      <section id="results-section" class="mt-10 scroll-mt-24 lg:mt-0" aria-labelledby="as-res-titulo" hidden>
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="as-res-titulo" class="m-0 font-display text-2xl text-ink-primary">Sorteo hecho</h2>
          <button type="button" id="as-nuevo" class={textoBoton + ' text-warm'}>Sortear de nuevo</button>
        </div>
        <p id="as-res-sub" class="m-0 mt-1 text-sm text-ink-tertiary"></p>

        <div class="as-modos mt-5 grid grid-cols-2 rounded-full border p-1" role="tablist" aria-label="Cómo repartir">
          <button type="button" role="tab" id="as-tab-enlaces" aria-controls="as-panel-enlaces" aria-selected="true" class="as-modo rounded-full border-0 bg-transparent px-3 py-2 text-sm font-semibold text-ink-secondary cursor-pointer aria-selected:bg-surface-alt aria-selected:text-ink-primary">Por WhatsApp</button>
          <button type="button" role="tab" id="as-tab-telefono" aria-controls="as-panel-telefono" aria-selected="false" tabindex="-1" class="as-modo rounded-full border-0 bg-transparent px-3 py-2 text-sm font-semibold text-ink-secondary cursor-pointer aria-selected:bg-surface-alt aria-selected:text-ink-primary">En este teléfono</button>
        </div>

        <div id="as-panel-enlaces" role="tabpanel" aria-labelledby="as-tab-enlaces" class="mt-4">
          <p class="m-0 text-sm text-ink-secondary">Envía a cada quien su enlace. Si alguien lo pierde, vuelve a enviárselo desde aquí: el sorteo no cambia.</p>
          <ol id="links-list-container" class="as-linea m-0 mt-3 list-none border-b p-0"></ol>
          <p id="as-enviados" class="m-0 mt-2 text-xs tabular-nums text-ink-tertiary"></p>
        </div>

        <div id="as-panel-telefono" role="tabpanel" aria-labelledby="as-tab-telefono" class="mt-4" hidden>
          <p class="m-0 text-sm text-ink-secondary">Para cuando están juntos. Pasa el teléfono: cada persona toca su nombre, ve a quién le regala y lo cierra antes de pasarlo. Quien organiza no ve nada.</p>
          <button type="button" id="as-empezar-telefono" class="as-boton mt-4">Empezar a pasar el teléfono</button>
        </div>

        <details id="validation-section" class="group as-linea mt-6 border-y">
          <summary class={resumen}>
            <svg viewBox="0 0 24 24" class="size-5 shrink-0 self-center text-warm" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>
            <span class="flex-1">¿Cómo sé que el sorteo es justo?</span>
            <span class="text-ink-tertiary transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="pb-5">
            <p id="as-metodo" class="m-0 mb-3 text-sm text-ink-secondary"></p>
            <table class="w-full border-collapse text-sm tabular-nums">
              <thead><tr class="text-left"><th class={etiqueta + ' py-1'}>Regala</th><th></th><th class={etiqueta + ' py-1'}>Recibe</th></tr></thead>
              <tbody id="matrix-tbody"></tbody>
            </table>
          </div>
        </details>
      </section>
    </section>

    <!-- ============ ABRIR EL SOBRE ============ -->
    <section id="reveal-screen" class="mx-auto flex max-w-md flex-col items-center text-center" aria-labelledby="as-abrir-titulo" hidden>
      <p id="as-abrir-grupo" class={etiqueta + ' m-0 mb-2'} hidden></p>
      <h1 id="as-abrir-titulo" class="as-h1 m-0">Tu <em>amigo secreto</em></h1>
      <p id="as-abrir-intro" class="m-0 mt-2 text-sm text-ink-secondary sm:text-base">Que nadie más mire la pantalla. Toca el sobre para abrirlo.</p>

      <div id="as-sobre-zona" class="w-full pb-10">
        <Envelope id="gift-container" nameId="revealed-name" />
      </div>

      <dl id="as-abrir-detalles" class="as-linea m-0 w-full border-b text-left" hidden>
        <div data-campo="presupuesto" class="as-linea flex items-baseline justify-between gap-4 border-t py-3" hidden><dt class={etiqueta}>Presupuesto</dt><dd class="m-0 font-display text-lg text-ink-primary"></dd></div>
        <div data-campo="fecha" class="as-linea flex items-baseline justify-between gap-4 border-t py-3" hidden><dt class={etiqueta}>Fecha</dt><dd class="m-0 text-right text-ink-primary first-letter:uppercase"></dd></div>
        <div data-campo="lugar" class="as-linea flex items-baseline justify-between gap-4 border-t py-3" hidden><dt class={etiqueta}>Lugar</dt><dd class="m-0 text-right text-ink-primary"></dd></div>
        <div data-campo="pista" class="as-linea border-t py-3" hidden><dt class={etiqueta}>Una pista</dt><dd class="m-0 mt-1 text-ink-primary"></dd></div>
        <div data-campo="mensaje" class="as-linea border-t py-3" hidden><dt class={etiqueta}>Mensaje del grupo</dt><dd class="m-0 mt-1 text-ink-secondary italic"></dd></div>
      </dl>

      <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-3">
        <button type="button" id="as-calendario" class={textoBoton + ' text-warm'} hidden>Añadir la fecha a mi calendario</button>
        <a href="/amigo-secreto" class={textoBoton + ' text-ink-secondary no-underline'}>Organizar mi propio sorteo</a>
      </div>
    </section>

    <!-- ============ EN ESTE TELÉFONO ============ -->
    <dialog id="as-telefono" class="as-dialogo m-0 h-dvh max-h-none w-full max-w-none border-0 bg-ink p-0 text-ink-primary" aria-labelledby="as-tel-titulo">
      <div class="mx-auto flex min-h-full max-w-md flex-col px-6 py-6">
        <div class="flex items-baseline justify-between gap-3">
          <h2 id="as-tel-titulo" class="m-0 font-display text-xl">Pasa el teléfono</h2>
          <button type="button" id="as-tel-salir" class={textoBoton + ' text-ink-tertiary'}>Terminar</button>
        </div>

        <div id="as-tel-lista-zona" class="mt-6">
          <p class="m-0 text-sm text-ink-secondary">Toca tu nombre. <span id="as-tel-faltan" class="tabular-nums text-ink-tertiary"></span></p>
          <ul id="as-tel-lista" class="as-linea m-0 mt-3 list-none border-b p-0"></ul>
        </div>

        <div id="as-tel-confirmar" class="mt-16 flex flex-col items-center gap-3 text-center" hidden>
          <p class="m-0 font-display text-2xl">¿Eres <span id="as-tel-quien" class="text-warm"></span>?</p>
          <p class="m-0 text-sm text-ink-secondary">Que nadie más mire la pantalla.</p>
          <button type="button" id="as-tel-si" class="as-boton mt-4">Sí, abrir mi sobre</button>
          <button type="button" id="as-tel-no" class={textoBoton + ' mt-2 text-ink-tertiary'}>No soy yo</button>
        </div>

        <div id="as-tel-sobre" class="flex flex-col items-center pb-6" hidden>
          <Envelope id="as-tel-env" nameId="as-tel-nombre" />
          <p id="as-tel-pista" class="m-0 mt-12 max-w-xs text-sm text-ink-secondary" hidden></p>
          <button type="button" id="as-tel-listo" class="as-boton mt-6" hidden>Listo, cerrar y pasar</button>
        </div>
      </div>
    </dialog>

    <!-- ============ CONFIRMAR ============ -->
    <dialog id="as-confirmar" class="as-dialogo as-linea m-auto w-[min(92vw,26rem)] rounded-lg border bg-surface-alt p-6 text-ink-primary" aria-labelledby="as-conf-texto">
      <form method="dialog" class="flex flex-col gap-5">
        <p id="as-conf-texto" class="m-0 text-base leading-relaxed"></p>
        <div class="flex items-center justify-end gap-6">
          <button value="no" class={textoBoton + ' text-ink-secondary'}>Cancelar</button>
          <button value="si" id="as-conf-si" class="as-boton !px-5 !py-2 !text-sm">Sí</button>
        </div>
      </form>
    </dialog>

    <div id="toast-message" popover="manual" class="as-toast as-linea fixed inset-x-0 bottom-6 top-auto mx-auto w-max max-w-[90vw] rounded-full border bg-surface-alt px-5 py-2.5 text-sm text-ink-primary data-[visible=true]:block" role="status" aria-live="polite"></div>

    <!-- ============ PLANTILLAS ============ -->
    <template id="tpl-ficha">
      <li class="participant-tag as-linea inline-flex items-center gap-0.5 rounded-full border py-0.5 pl-3 pr-1 text-sm text-ink-primary data-[elegida=true]:border-warm data-[elegida=true]:text-warm data-[aviso=true]:border-warm">
        <button type="button" data-ficha-nombre class="border-0 bg-transparent p-0 text-inherit font-[inherit] cursor-default data-[tocable=true]:cursor-pointer data-[tocable=true]:underline data-[tocable=true]:underline-offset-4"></button>
        <button type="button" data-ficha-quitar class="grid size-7 place-items-center rounded-full border-0 bg-transparent p-0 text-base leading-none text-ink-tertiary cursor-pointer hover:text-warm" aria-label="Quitar">×</button>
      </li>
    </template>

    <template id="tpl-enlace">
      <li class="link-row group as-linea flex items-center gap-3 border-t py-3" data-enviado="false">
        <span data-num class="w-6 shrink-0 text-sm tabular-nums text-ink-tertiary"></span>
        <div class="min-w-0 flex-1">
          <p class="row-name m-0 truncate text-base font-semibold text-ink-primary" data-nombre></p>
          <p class="m-0 truncate text-xs text-ink-tertiary"><span data-estado class="hidden text-warm group-data-[enviado=true]:inline">Enviado · </span><span data-contacto></span></p>
        </div>
        <div class="row-actions flex shrink-0 items-center gap-4">
          <button type="button" data-enviar class={textoBoton + ' text-warm'}>Enviar</button>
          <button type="button" data-whatsapp class={textoBoton + ' text-warm'} hidden>WhatsApp</button>
          <button type="button" data-copiar class={textoBoton + ' text-ink-tertiary'}>Copiar</button>
        </div>
      </li>
    </template>

    <template id="tpl-matriz">
      <tr class="as-linea border-t"><td data-da class="py-1.5 text-ink-primary"></td><td class="px-2 text-center text-ink-tertiary" aria-hidden="true">→</td><td data-recibe class="py-1.5 text-ink-primary"></td></tr>
    </template>

    <template id="tpl-tel-nombre">
      <li class="as-linea border-t">
        <button type="button" class="flex w-full items-center justify-between border-0 bg-transparent px-0 py-4 text-left text-lg text-ink-primary cursor-pointer hover:text-warm disabled:cursor-default disabled:text-ink-tertiary disabled:line-through"></button>
      </li>
    </template>
  </main>

  <div data-solo="organizar">
    <AmigoSecretoArticulo />
    <AdSlot position="bottom" />
    <section class="hub-section wrap">
      <div class="section-header reveal">
        <h2 class="section-heading">Prueba otras herramientas de decisión</h2>
      </div>
      <HubGrid activeToolId="amigo-secreto" />
    </section>
  </div>

  <script src="../scripts/amigo-secreto-nuevo.js"></script>

  {/* Respaldo para navegadores por debajo del mínimo (SDD §0.4): si el
      módulo no arrancó, un enlace v1 repartido en años anteriores se sigue
      abriendo, y uno v2 explica que hace falta un navegador más reciente.
      ES5 a propósito. */}
  <script is:inline>
    (function () {
      function respaldo() {
        var app = document.getElementById('as-app');
        if (!app || app.getAttribute('data-ready')) return;
        var m = /[#?&]revelar=([^&]*)/.exec(location.hash + '&' + location.search);
        var v2 = /[#&]v=\d/.test(location.hash);
        if (!m && !v2) return;
        var nombre = null;
        if (m) try {
          var b64 = decodeURIComponent(decodeURIComponent(m[1]).replace(/ /g, '+'));
          var x = atob(b64), k = 'decidelo', s = '';
          for (var i = 0; i < x.length; i++) s += String.fromCharCode(x.charCodeAt(i) ^ k.charCodeAt(i % k.length));
          nombre = decodeURIComponent(escape(s));
        } catch (e) { nombre = null; }
        app.setAttribute('data-ready', 'respaldo');
        document.body.setAttribute('data-as-modo', 'abrir');
        var org = document.getElementById('organizer-screen');
        var rev = document.getElementById('reveal-screen');
        if (org) { org.hidden = true; org.style.display = 'none'; }
        if (rev) { rev.hidden = false; rev.style.display = 'block'; }
        var sobre = document.getElementById('gift-container');
        var nom = document.getElementById('revealed-name');
        if (nombre && sobre && nom) {
          nom.textContent = nombre;
          sobre.setAttribute('data-state', 'abierto');
          sobre.setAttribute('aria-label', 'Te toca regalarle a ' + nombre);
        } else {
          var t = document.getElementById('as-abrir-titulo');
          var intro = document.getElementById('as-abrir-intro');
          if (t) t.textContent = v2 ? 'Tu navegador es demasiado antiguo' : 'Este enlace no funciona';
          if (intro && v2) intro.textContent = 'Este enlace necesita un navegador más reciente. Ábrelo en Chrome o Safari actualizados.';
          if (sobre) sobre.style.display = 'none';
        }
      }
      if (window.addEventListener) window.addEventListener('load', function () { setTimeout(respaldo, 1500); });
    })();
  </script>
</Layout>

<style is:global>
  /* Propio de esta página, lo que Tailwind no expresa con los tokens del
     sitio: la línea divisoria (--divider-line no es utilidad), el h1 con su
     énfasis en Newsreader, el botón principal y los campos subrayados. */
  .as-page { display: block; }
  .as-page [hidden] { display: none !important; }
  .as-linea, .as-modos { border-color: var(--divider-line); }

  .as-h1 {
    font-family: var(--font-display, 'Outfit'), system-ui, sans-serif;
    font-size: clamp(2.1rem, 7vw, 3.2rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .as-h1 em {
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 400;
    color: var(--accent-warm);
  }

