---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import HubGrid from '../components/HubGrid.astro';
import SeoArticle from '../components/SeoArticle.astro';
import Wheel from '../components/Wheel.astro';
import { getSocialImageUrl } from '../lib/heroImages';

// El título y el arranque de la descripción vienen del experimento SEO que
// antes vivía en la raíz (ver el historial de index.astro). Solo se corrigió
// lo que dejó de ser verdad con el rediseño (modo foco y sonido ya no son
// botones de la cabecera); el texto nuevo, con datos de Search Console, es
// la fase 5 del SDD de la ruleta.
const title = 'Ruleta Aleatoria Online Gratis — Decídelo.app';
const description = 'Ruleta aleatoria online para sortear nombres, elegir al azar y resolver empates. Gratis, sin registro y 100% en tu navegador, con modos para eliminar y contar, pantalla completa y tic opcional.';
const keywords = 'ruleta aleatoria, ruleta de nombres, ruleta online, sortear nombres, ruleta de decisiones, ruleta para sorteos, girar la ruleta, ruleta gratis, ruleta random';

// La imagen vive en src/assets y la optimiza Astro; el JSON-LD necesita
// su URL absoluta ya generada, no la ruta pública que tenía antes.
const socialImage = await getSocialImageUrl('/blog/ruleta.png');

const schemaLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://decidelo.app/ruleta#webapp",
      "name": "Ruleta Aleatoria Online — Decídelo.app",
      "description": "Ruleta aleatoria online para sortear nombres, elegir al azar y resolver empates. Gratis, sin registro, con modos para eliminar y contar y pantalla completa.",
      "url": "https://decidelo.app/ruleta",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript and SVG",
      "softwareVersion": "2.0.0",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "image": socialImage,
      "screenshot": socialImage,
      "publisher": {
        "@type": "Organization",
        "@id": "https://decidelo.app/#organization",
        "name": "Decídelo.app",
        "url": "https://decidelo.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://decidelo.app/favicon.svg"
        }
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://decidelo.app/ruleta#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo funciona la ruleta aleatoria online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Escribe tus opciones en la lista (o pega varias a la vez), pulsa «Girar ruleta», toca la rueda o arrástrala, y se detiene sola en un resultado elegido al azar. Puedes escribir qué se decide, mezclar el orden u ocultar opciones sin borrarlas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo usar la ruleta para sortear nombres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Pulsa «Pegar lista», pega los nombres (uno por línea) y gira: es el uso más habitual, tanto para sorteos como para elegir turnos o participaciones al azar. Hasta 100 opciones."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo pongo la ruleta en pantalla completa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pulsa el icono de pantalla completa que hay sobre la rueda: deja solo la ruleta, el resultado y el botón, útil para proyectarla o para reducir distracciones. En el iPhone, que no tiene pantalla completa para páginas web, se activa el modo foco, que oculta el resto de la página."
          }
        },
        {
          "@type": "Question",
          "name": "¿La ruleta guarda mis datos en un servidor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Todo corre en tu navegador: tus opciones, el modo, el historial y tus preferencias se guardan localmente y no se envían a ningún servidor."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://decidelo.app/ruleta#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://decidelo.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Ruleta",
          "item": "https://decidelo.app/ruleta"
        }
      ]
    }
  ]
};
---

{/*
  showHomeHeader=false: /ruleta lee como sus hermanas (moneda, dados, etc.),
  no como la home. La página sigue la anatomía de DESIGN.md: hero corto con
  el selector de modo, la rueda con su resultado y su botón, el editor, el
  historial, y debajo AdSlot, artículo e índice de herramientas.

  El contenedor de la herramienta no lleva `.reveal`: su `transform` haría de
  bloque contenedor del aviso «Deshacer» (posición fija) y lo sacaría de la
  ventana en escritorio (SDD de la ruleta, RNF-11).
*/}
<Layout title={title} description={description} keywords={keywords} schemaLD={schemaLD} showHomeHeader={false}>
  <Fragment slot="head">
    {/* Newsreader itálica: la usa el énfasis en cursiva del h1 (ver DESIGN.md) */}
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,400&display=swap" rel="stylesheet">
  </Fragment>

  <main class="ruleta-tool wheel-palette wrap pb-8" id="ruleta-tool">

    <section class="ruleta-hero pt-2 sm:pt-6 lg:pt-4">
      <h1>Ruleta aleatoria, que <em>decida el azar</em></h1>
      <p class="ruleta-lede">Escribe tus opciones y deja que el azar elija: todas tienen la misma probabilidad.</p>
      <div class="ruleta-modes" role="group" aria-label="Modo">
        <button class="ruleta-mode" type="button" data-modo="normal" aria-pressed="true">Normal</button>
        <button class="ruleta-mode" type="button" data-modo="eliminar" aria-pressed="false">Eliminar</button>
        <button class="ruleta-mode" type="button" data-modo="contar" aria-pressed="false">Contar</button>
      </div>
    </section>

    <section class="ruleta-stage" id="ruleta-stage" aria-label="Ruleta">
      <Wheel />
      <p class="ruleta-result" id="ruleta-result" aria-live="polite">
        <span class="ruleta-result-main" id="ruleta-result-main"></span>
        <span class="ruleta-result-side" id="ruleta-result-side"></span>
      </p>
      <div class="flex justify-center mt-2"><button class="ruleta-spin" id="ruleta-girar" type="button">Girar ruleta</button></div>
      <div class="ruleta-actions" id="ruleta-acciones-resultado" hidden>
        <button class="ruleta-text-btn is-quiet" id="ruleta-quitar" type="button" hidden></button>
      </div>
      {/* Aviso con «Deshacer». Dentro de la zona de la rueda: así se ve
          también en pantalla completa (SDD §6.14.7). */}
      <div class="ruleta-aviso" id="ruleta-aviso" hidden>
        <span id="ruleta-aviso-texto"></span>
        <button class="ruleta-text-btn" id="ruleta-aviso-deshacer" type="button">Deshacer</button>
      </div>
    </section>

    <section class="ruleta-inputs" aria-label="Opciones">
      <div class="ruleta-field">
        <label class="ruleta-label" for="ruleta-pregunta">¿Qué se decide?</label>
        <input class="ruleta-line" id="ruleta-pregunta" type="text" maxlength="60" placeholder="¿Qué comemos hoy?" autocomplete="off">
      </div>
      <div class="ruleta-editor-head flex items-end justify-between mt-5">
        <span class="ruleta-label" id="ruleta-etq-opciones">Opciones</span>
        <button class="ruleta-text-btn" id="ruleta-pegar-toggle" type="button" aria-expanded="false" aria-controls="ruleta-pegar-panel">Pegar lista</button>
      </div>
      <div class="ruleta-opt-wrap">
        <ul class="ruleta-opt-list" id="ruleta-lista" aria-labelledby="ruleta-etq-opciones"></ul>
        <form class="ruleta-add-row" id="ruleta-alta" autocomplete="off">
          <label class="sr-only" for="ruleta-nueva">Añadir opción</label>
          <input class="ruleta-line" id="ruleta-nueva" type="text" placeholder="Añadir opción" enterkeyhint="enter" autocomplete="off" autocapitalize="sentences">
        </form>
      </div>
      <div class="mt-3" id="ruleta-pegar-panel" hidden>
        <label class="sr-only" for="ruleta-opciones">Opciones, una por línea</label>
        <textarea class="ruleta-box" id="ruleta-opciones" spellcheck="false" autocomplete="off" placeholder="Una opción por línea"></textarea>
      </div>
      <p class="ruleta-hint mt-1.5 text-ink-tertiary" id="ruleta-aviso-n" hidden>Con más de 40 opciones la rueda no pinta etiquetas; el resultado dice cuál salió.</p>
      <p class="ruleta-hint mt-1.5 text-ink-tertiary" id="ruleta-aviso-max" hidden>Caben 100 opciones activas; las demás quedan ocultas.</p>
      <div class="ruleta-chips flex flex-wrap items-center gap-2 mt-4" role="group" aria-label="Ejemplos para empezar">
        <span class="ruleta-label">Ejemplos</span>
        <button class="ruleta-chip" type="button" data-ejemplo="comida">Comida</button>
        <button class="ruleta-chip" type="button" data-ejemplo="verdad">Verdad o reto</button>
        <button class="ruleta-chip" type="button" data-ejemplo="nombres">Nombres</button>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 mt-2">
        <button class="ruleta-text-btn" id="ruleta-mezclar" type="button">Mezclar</button>
        <button class="ruleta-text-btn" id="ruleta-ordenar" type="button">Ordenar</button>
        <button class="ruleta-text-btn" id="ruleta-vaciar" type="button">Vaciar</button>
        <button class="ruleta-text-btn" id="ruleta-compartir" type="button">Compartir</button>
        <button class="ruleta-text-btn" id="ruleta-foco" type="button" aria-pressed="false">Modo foco</button>
        <button class="ruleta-text-btn" id="ruleta-reiniciar" type="button" hidden>Reiniciar cuentas</button>
        <span class="ruleta-share-status" id="ruleta-compartir-estado" role="status"></span>
      </div>
    </section>

    <section class="ruleta-hist" aria-label="Historial">
      <div class="ruleta-hist-head flex items-center gap-3">
        <span class="ruleta-label" id="ruleta-etq-hist">Últimos resultados</span>
        <span class="ruleta-hist-count flex-1 text-sm text-ink-tertiary tabular-nums" id="ruleta-hist-count"></span>
        <button class="ruleta-text-btn" id="ruleta-borrar-hist" type="button" hidden>Borrar</button>
      </div>
      <ol class="ruleta-hist-list" id="ruleta-historial" aria-labelledby="ruleta-etq-hist">
        <li class="ruleta-hist-vacio">Sin giros aún</li>
      </ol>
    </section>
  </main>

  {/* Plantillas de lo que repite el JS: las filas del editor y del historial. */}
  <template id="ruleta-fila-tpl">
    <li class="ruleta-opt-row">
      <span class="ruleta-opt-dot" aria-hidden="true"></span>
      <input class="ruleta-opt-text" type="text" aria-label="Opción" autocomplete="off" maxlength="60" enterkeyhint="done">
      <span class="ruleta-opt-count" hidden></span>
      <button class="ruleta-opt-btn ruleta-opt-vis" type="button" role="switch" aria-checked="true" aria-label="Mostrar en la rueda">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="ruleta-vis-on"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"></path><circle cx="12" cy="12" r="2.8"></circle></g><g class="ruleta-vis-off"><path d="M3 3l18 18M10.6 5.7A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a16 16 0 0 1-2.6 3.3M6.6 7.2A16 16 0 0 0 2.5 12S6 18.5 12 18.5a9.5 9.5 0 0 0 3.4-.6"></path></g></svg>
      </button>
      <button class="ruleta-opt-btn ruleta-opt-del" type="button" aria-label="Borrar opción">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </li>
  </template>
  <template id="ruleta-hist-tpl">
    <li><span class="ruleta-hist-op"></span><span class="ruleta-hist-para"></span></li>
  </template>

  <AdSlot position="top" />

  <section class="hub-section wrap">
    <div class="section-header reveal">
      <div class="section-tag">🧰 Caja de Herramientas</div>
      <h2 class="section-heading">Prueba otras herramientas de decisión</h2>
    </div>
    <HubGrid activeToolId="ruleta" />
  </section>

  {/* El artículo SEO se mudó entero desde index.astro. Aquí solo se corrigió
       lo que dejó de ser verdad con el rediseño; el texto nuevo es la fase 5
       del SDD de la ruleta (decidelo-textos, con datos de Search Console). */}
  <SeoArticle title="¿Cómo funciona la Ruleta Aleatoria Online y por qué usarla?">
    <p>La <strong>Ruleta Aleatoria Online</strong> de Decídelo.app dibuja la rueda con gráficos vectoriales (SVG) y la anima con las propias herramientas de animación del navegador, así que se ve nítida en cualquier pantalla y no necesita descargar nada pesado. Cada giro se siente orgánico y con suspenso -- y todo corre en tu navegador, sin registro ni servidores de por medio.</p>

    <h2>¿Cómo funciona la Ruleta?</h2>
    <ul>
      <li><strong>Escribe tus opciones</strong> en la lista (o pega varias a la vez con «Pegar lista»). La ruleta se actualiza en tiempo real y admite hasta 100.</li>
      <li><strong>Escribe qué se decide</strong> en el campo «¿Qué se decide?». Ideal para sorteos con nombre: "¿Quién lava los platos?". El resultado lo repite.</li>
      <li><strong>Gira de cuatro formas:</strong> con el botón «Girar ruleta», tocando la rueda, arrastrándola con el dedo o el ratón, o con el teclado (Espacio, Intro o Ctrl/Cmd+Intro). La fuerza del gesto solo cambia cuántas vueltas da, nunca quién gana.</li>
      <li><strong>El resultado aparece bajo la rueda</strong>, sin ventanas que lo tapen, y queda en el historial de tus últimos 20 giros. Si quieres seguir, «Girar otra vez».</li>
      <li><strong>Oculta opciones</strong> sin borrarlas, o pulsa «Quitar» tras un resultado. Perfecto para torneos por eliminación o para ir descartando candidatos ronda a ronda.</li>
    </ul>

    <h2>Tres modos: normal, eliminar y contar</h2>
    <ul>
      <li><strong>Normal:</strong> el ganador sigue en la rueda.</li>
      <li><strong>Eliminar:</strong> tras cada giro, el ganador se oculta solo; hasta que queda una opción. Se puede deshacer.</li>
      <li><strong>Contar:</strong> cada opción acumula sus victorias en la lista y en el historial. Útil para comprobar a la larga que el reparto es parejo.</li>
    </ul>

    <h2>Casos de uso populares</h2>

    <h3>Sorteos de nombres y ganadores</h3>
    <p>Ya sea para dinamizar tus sorteos en redes sociales (Instagram, TikTok, Facebook), seleccionar ganadores en concursos, o elegir el orden de exposición de estudiantes en clase, la <em>ruleta de nombres</em> da a todos la misma probabilidad: el ganador se elige antes del giro con el generador aleatorio del navegador y la rueda gira hasta él. El público confía en un resultado visualmente aleatorio más que en un simple número generado por computadora.</p>

    <h3>Decidir qué comer</h3>
    <p>El clásico dilema de parejas y amigos. Introduce opciones como "Pizza", "Tacos", "Sushi" o "Hamburguesas" y deja que el destino elija el menú del día. Elimina discusiones innecesarias de forma divertida y democrática.</p>

    <h3>Dinámicas de clase y gamificación</h3>
    <p>Los profesores y facilitadores utilizan esta herramienta para hacer preguntas aleatorias, asignar tareas, seleccionar equipos o elegir temas de debate. La ruleta mantiene a los participantes alerta, atentos y comprometidos porque cualquiera puede ser el próximo.</p>

    <h3>Juegos y entretenimiento</h3>
    <p>Úsala como una ruleta de la fortuna, verdad o reto, penitencias para fiestas o para determinar premios en eventos. Personalízala con retos, castigos, recompensas o cualquier contenido creativo que se te ocurra.</p>

    <h2>Diseño accesible y enfoque en la concentración</h2>
    <p>Hemos diseñado esta ruleta con especial atención a la accesibilidad y experiencia de usuario. El icono de <strong>pantalla completa</strong> de la rueda (y el <strong>Modo foco</strong>, que lo sustituye donde el navegador no tiene pantalla completa, como el iPhone) elimina todas las distracciones de la pantalla (texto informativo, herramientas secundarias, anuncios) y te permite centrarte exclusivamente en la ruleta. Es especialmente útil para proyectarla o para personas con TDAH que prefieren una interfaz limpia.</p>
    <p>El modo oscuro predeterminado reduce la fatiga ocular durante sesiones prolongadas. Si quieres, el altavoz de la rueda activa un «tic» suave al pasar por cada gajo; viene apagado y no suena nada más, ni celebraciones al ganar.</p>

    <h2>¿Por qué esta ruleta es diferente?</h2>
    <ul>
      <li><strong>Privacidad real:</strong> Sin servidores, sin cookies, sin registro. Todo funciona localmente en tu navegador.</li>
      <li><strong>Velocidad:</strong> Carga instantánea. No hay dependencias pesadas ni frameworks innecesarios.</li>
      <li><strong>Diseño cuidado:</strong> Cada detalle está pensado: desde las micro-animaciones hasta la paleta de colores.</li>
      <li><strong>Accesibilidad:</strong> Compatible con lectores de pantalla, navegación por teclado y preferencias de movimiento reducido.</li>
    </ul>
  </SeoArticle>

  <AdSlot position="bottom" />

  <script src="../scripts/ruleta.js"></script>
</Layout>

<style>
  .hub-section {
    padding: 3rem 0;
  }

  /* ====================================================================
     ANATOMÍA (SDD §6.1)
     ====================================================================
     El orden del HTML es el de móvil; en escritorio solo cambian las áreas
     de la rejilla, como en la moneda. Medidas del prototipo aprobado
     (docs/prototipos/ruleta-rueda.html, SDD §6.15): el alto del hero es fijo
     (h1 y entradilla reservan siempre dos líneas) para que la rueda pueda
     calcular su tamaño restando todo lo demás. Lo que manda no es la
     constante sino el invariante de scripts/lib/estados.mjs: holgura ≥ 16 px
     bajo el botón en todos los formatos. */
  .ruleta-tool {
    --h1: clamp(1.5rem, 5.5vw, 2.6rem);            /* cuerpo del h1: el alto del hero sale de él (2 líneas) */
    --hero-extra: calc(2.2 * var(--h1) - 52.8px);  /* lo que el hero mide de más respecto a 360 px */
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "hero" "wheel" "inputs" "hist";
    align-items: stretch;   /* `main` de global.css centra: aquí cada área ocupa su celda */
    max-width: 1360px;
    padding-top: 0;
    padding-bottom: 32px;
  }
  .ruleta-hero { grid-area: hero; }
  .ruleta-stage { grid-area: wheel; }
  .ruleta-inputs { grid-area: inputs; padding-top: 24px; display: flex; flex-direction: column; min-height: 0; }
  .ruleta-hist { grid-area: hist; padding-top: 24px; }

  .ruleta-hero h1 {
    margin: 0;
    font: 600 var(--h1)/1.1 'Outfit', sans-serif;
    letter-spacing: -0.02em;
    height: 2.2em; /* dos líneas siempre, alto fijo (con min-height la línea del <em> lo hacía crecer 2 px a ciertos anchos) */
  }
  .ruleta-hero h1 em { font: italic 400 1.08em/1 'Newsreader', Georgia, serif; color: var(--accent-warm); letter-spacing: 0; }
  .ruleta-lede {
    margin: 6px 0 0; color: var(--text-secondary); font-size: 1.05rem; line-height: 1.4;
    min-height: 2.8em; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; /* 2 líneas reservadas */
  }
  /* La entradilla se oculta si el alto es corto (DESIGN.md, «Pantallas bajas») */
  @media (max-width: 639px) and (max-height: 620px) { .ruleta-lede { display: none; } }

  /* Selector de modo (DESIGN.md): una sola pieza, borde divider, píldora; el
     modo elegido se rellena de --bg-surface-alt, no del acento. */
  .ruleta-modes {
    display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 8px;
    border: 1px solid var(--divider-line); border-radius: 999px; overflow: hidden;
  }
  .ruleta-mode {
    min-height: 44px; border: 0; background: transparent; color: var(--text-secondary);
    font: 500 0.9rem 'Inter', sans-serif; cursor: pointer;
  }
  .ruleta-mode + .ruleta-mode { border-left: 1px solid var(--divider-line); }
  .ruleta-mode[aria-pressed="true"] { background: var(--bg-surface-alt); color: var(--text-primary); font-weight: 600; }
  .ruleta-mode:focus-visible { outline: 2px solid var(--accent-warm); outline-offset: -2px; border-radius: 999px; }

  /* Tamaño de la rueda: resta del alto útil todo lo demás (SDD §6.1). `svh` y
     no `dvh`: no debe saltar cuando aparece o se va la barra de Safari. El
     mínimo de 12rem evita un ancho negativo en móvil horizontal, donde se
     acepta scroll vertical. */
  .ruleta-stage {
    --wheel-d: min(100%, max(12rem, calc(100svh - 394px - var(--hero-extra))), 36rem); /* desde 640 px */
    --ink-on-warm: #1a0e06; /* texto sobre --accent-warm (DESIGN.md) */
  }
  @media (max-width: 639px) {
    .ruleta-stage { --wheel-d: min(100%, max(12rem, calc(100svh - 371px - var(--hero-extra))), 32rem); } /* con entradilla (alto > 620 px) */
    .ruleta-lede { font-size: 0.95rem; }
  }
  /* Sin entradilla la rueda gana 48 px; el valor se ajustó con la medida, no a ojo */
  @media (max-width: 639px) and (max-height: 620px) {
    .ruleta-stage { --wheel-d: min(100%, max(12rem, calc(100svh - 322px - var(--hero-extra))), 32rem); }
  }
  @media (min-width: 1024px) {
    .ruleta-stage { --wheel-d: min(100%, max(12rem, calc(100svh - 267px)), 44rem); }
  }

  /* ---------- Resultado y acciones ---------- */
  .ruleta-result {
    margin: 8px 0 0; height: 48px; overflow: hidden; text-align: center;
    display: flex; flex-direction: column; justify-content: center;
    /* opacidad y no visibility: el texto cambia dentro de una región aria-live y
       tiene que seguir en el árbol de accesibilidad para anunciarse */
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
  }
  .ruleta-result.is-shown { opacity: 1; transform: none; }
  .ruleta-result-main {
    display: block;
    font: 600 1.6rem/1.15 'Outfit', sans-serif; letter-spacing: -0.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
