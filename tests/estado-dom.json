{
  "/ [modo-foco]": {
    ".hero": {
      "display": "none"
    },
    ".hub-section": {
      "display": "none"
    },
    "footer": {
      "display": "none"
    },
    ".nav-link": {
      "display": "none"
    },
    ".logo-link": {
      "display": "none"
    },
    ".header-inner": {
      "justifyContent": "flex-end"
    },
    ".roulette-section": {
      "display": "flex",
      "alignItems": "center",
      "padding": "0px",
      "minHeight": "820px"
    },
    ".roulette-section .section-header": {
      "display": "none"
    },
    ".app-grid": {
      "gridTemplateColumns": "500.5px 409.5px"
    },
    "body": {
      "backgroundColor": "rgb(6, 6, 8)"
    }
  },
  "/ [pestana-gestionar]": {
    "#tab-manage-content": {
      "display": "flex"
    },
    "#tab-edit-content": {
      "display": "none"
    },
    "#tab-manage": {
      "color": "rgb(226, 144, 90)",
      "backgroundColor": "rgba(0, 0, 0, 0)"
    }
  },
  "/ [modal-ganador]": {
    "#winner-modal": {
      "display": "flex",
      "opacity": "1",
      "visibility": "visible",
      "position": "fixed"
    },
    ".modal-card": {
      "transform": "matrix(1, 0, 0, 1, 0, 0)",
      "backgroundColor": "rgb(15, 15, 21)",
      "borderRadius": "24px"
    },
    ".modal-title": {
      "fontFamily": "Outfit, sans-serif",
      "color": "rgb(139, 139, 158)"
    },
    ".winner-name-text": {
      "fontSize": "32px",
      "fontWeight": "800"
    },
    ".celebration-emoji": {
      "display": "block",
      "fontSize": "56px"
    }
  },
  "/ [titulo-edicion]": {
    "#wheel-title-text.title-editing": {
      "cursor": "text",
      "userSelect": "text"
    }
  },
  "/ [deshacer-limpiar]": {
    "#undo-toast": {
      "display": "flex",
      "position": "fixed",
      "zIndex": "60"
    },
    "#undo-toast-btn": {
      "display": "block",
      "cursor": "pointer",
      "minHeight": "44px"
    }
  },
  "/ [reposo]": {
    ".hero": {
      "display": "flex"
    },
    ".hub-section": {
      "display": "block"
    },
    ".header-inner": {
      "justifyContent": "space-between"
    },
    "#tab-manage-content": {
      "display": "none"
    },
    ".roulette-section .section-header": {
      "display": "block"
    },
    "#winner-modal": {
      "display": "flex",
      "opacity": "0",
      "visibility": "visible"
    },
    ".hub-section .section-heading": {
      "fontSize": "36.8px"
    },
    ".hub-section .section-tag": {
      "marginBottom": "12px"
    },
    ".hub-section .section-header": {
      "marginBottom": "48px"
    }
  },
  "/dados [lanzado-casino]": {
    ".dice-cube": {
      "transformStyle": "preserve-3d",
      "width": "80px",
      "height": "80px",
      "position": "relative"
    },
    ".casino-face": {
      "backgroundColor": "rgba(220, 20, 40, 0.88)",
      "borderRadius": "12px",
      "display": "grid"
    },
    ".casino-dot": {
      "backgroundColor": "rgb(255, 255, 255)",
      "borderRadius": "50%"
    },
    "#result-display": {
      "display": "flex",
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
    }
  },
  "/dados [lanzado-yugioh]": {
    ".yugioh-face": {
      "backgroundColor": "rgba(0, 0, 0, 0)",
      "borderRadius": "8px",
      "display": "grid"
    },
    ".yugioh-dot": {
      "backgroundColor": "rgb(32, 26, 21)"
    }
  },
  "/dados [lanzado-dnd]": {
    ".d20-wrapper": {
      "display": "inline-block",
      "position": "static",
      "width": "90px",
      "height": "90px"
    },
    ".d20-number": {
      "position": "static",
      "fontFamily": "Outfit, sans-serif",
      "color": "rgb(240, 240, 245)"
    }
  },
  "/amigo-secreto [sorteo-hecho]": {
    ".participant-tag": {
      "display": "flex",
      "backgroundColor": "rgb(20, 20, 29)",
      "borderRadius": "999px"
    },
    ".link-row": {
      "display": "flex",
      "flexDirection": "row",
      "alignItems": "center",
      "backgroundColor": "rgb(20, 20, 29)"
    },
    ".row-name": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "fontWeight": "600",
      "color": "rgb(255, 255, 255)"
    },
    ".row-actions": {
      "display": "flex",
      "gap": "8px"
    },
    ".btn-action": {
      "display": "flex",
      "borderRadius": "6px",
      "cursor": "pointer"
    },
    "#results-section": {
      "display": "block"
    },
    "#matrix-tbody tr": {
      "display": "table-row"
    }
  },
  "/amigo-secreto [sorteo-hecho-movil]": {
    ".link-row": {
      "flexDirection": "column",
      "alignItems": "flex-start"
    },
    ".row-actions": {
      "width": "290px",
      "justifyContent": "flex-end"
    }
  }
}
