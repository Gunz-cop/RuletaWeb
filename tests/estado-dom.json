{
  "/ [modo-foco]": {
    ".hero": {
      "display": "none"
    },
    ".hub-section": {
      "display": "none"
    },
    "footer": {
      "display": "none"
    },
    ".nav-link": {
      "display": "none"
    },
    ".logo-link": {
      "display": "none"
    },
    ".header-inner": {
      "justifyContent": "flex-end"
    },
    ".roulette-section": {
      "display": "flex",
      "alignItems": "center",
      "padding": "0px",
      "minHeight": "820px"
    },
    ".app-grid": {
      "gridTemplateColumns": "500.5px 409.5px"
    },
    "body": {
      "backgroundColor": "rgb(6, 6, 8)"
    }
  },
  "/ [pestana-gestionar]": {
    "#tab-manage-content": {
      "display": "flex"
    },
    "#tab-edit-content": {
      "display": "none"
    },
    "#tab-manage": {
      "color": "rgb(0, 242, 254)",
      "backgroundColor": "rgba(0, 0, 0, 0)"
    }
  },
  "/ [modal-ganador]": {
    "#winner-modal": {
      "display": "flex",
      "opacity": "1",
      "visibility": "visible",
      "position": "fixed"
    },
    ".modal-card": {
      "transform": "matrix(1, 0, 0, 1, 0, 0)",
      "backgroundColor": "rgb(15, 15, 21)",
      "borderRadius": "24px"
    },
    ".modal-title": {
      "fontFamily": "Outfit, sans-serif",
      "color": "rgb(139, 139, 158)"
    },
    ".winner-name-text": {
      "fontSize": "32px",
      "fontWeight": "800"
    },
    ".celebration-emoji": {
      "display": "block",
      "fontSize": "56px"
    }
  },
  "/ [reposo]": {
    ".hero": {
      "display": "block"
    },
    ".hub-section": {
      "display": "block"
    },
    ".header-inner": {
      "justifyContent": "space-between"
    },
    "#tab-manage-content": {
      "display": "none"
    },
    "#winner-modal": {
      "display": "flex",
      "opacity": "0",
      "visibility": "visible"
    }
  }
}
