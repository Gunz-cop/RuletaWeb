{
  "/ruleta [modo-foco]": {
    ".hub-section": {
      "display": "none"
    },
    ".seo-section": {
      "display": "none"
    },
    "footer": {
      "display": "none"
    },
    "main.wrap": "NO EXISTE EN EL DOM",
    ".roulette-section": {
      "display": "flex",
      "alignItems": "center",
      "padding": "0px",
      "minHeight": "820px"
    },
    ".roulette-section .section-header": {
      "display": "none"
    },
    ".app-grid": {
      "gridTemplateColumns": "500.5px 409.5px"
    },
    "body": {
      "backgroundColor": "rgb(6, 6, 8)"
    }
  },
  "/ruleta [pestana-gestionar]": {
    "#tab-manage-content": {
      "display": "flex"
    },
    "#tab-edit-content": {
      "display": "none"
    },
    "#tab-manage": {
      "color": "rgb(226, 144, 90)",
      "backgroundColor": "rgba(0, 0, 0, 0)"
    }
  },
  "/ruleta [modal-ganador]": {
    "#winner-modal": {
      "display": "flex",
      "opacity": "1",
      "visibility": "visible",
      "position": "fixed"
    },
    ".modal-card": {
      "transform": "matrix(1, 0, 0, 1, 0, 0)",
      "backgroundColor": "rgb(15, 15, 21)",
      "borderRadius": "24px"
    },
    ".modal-title": {
      "fontFamily": "Outfit, sans-serif",
      "color": "rgb(139, 139, 158)"
    },
    ".winner-name-text": {
      "fontSize": "32px",
      "fontWeight": "800"
    },
    ".celebration-emoji": {
      "display": "block",
      "fontSize": "56px"
    }
  },
  "/ruleta [titulo-edicion]": {
    "#wheel-title-text.title-editing": {
      "cursor": "text",
      "userSelect": "text"
    }
  },
  "/ruleta [deshacer-limpiar]": {
    "#undo-toast": {
      "display": "flex",
      "position": "fixed",
      "zIndex": "60"
    },
    "#undo-toast-btn": {
      "display": "block",
      "cursor": "pointer",
      "minHeight": "44px"
    }
  },
  "/ [cabeceras-de-seccion]": {
    ".hub-section .section-heading": {
      "fontSize": "36.8px"
    },
    ".hub-section .section-tag": {
      "marginBottom": "12px"
    },
    ".hub-section .section-header": {
      "marginBottom": "48px"
    }
  },
  "/ruleta [reposo]": {
    "#tab-manage-content": {
      "display": "none"
    },
    ".roulette-section .section-header": {
      "display": "block"
    },
    "#winner-modal": {
      "display": "flex",
      "opacity": "0",
      "visibility": "visible"
    }
  },
  "/ruleta [h1-visible-390x844]": {
    "h1": {
      "display": "block"
    }
  },
  "/ruleta [panel-opciones-movil]": {
    "#mobile-options-panel": {
      "position": "fixed",
      "zIndex": "55",
      "transform": "matrix(1, 0, 0, 1, 0, 0)"
    },
    "#options-panel-toggle": {
      "height": "56px",
      "cursor": "pointer"
    },
    ".roulette-section .section-tag": "NO EXISTE EN EL DOM"
  },
  "/ruleta [panel-fijo-tras-scroll]": {
    "relacion": {
      "ok": true,
      "mensaje": "bottom antes de scrollear=1193.1px, después de scrollear a 900px=1193.1px (delta 0.0px, tolerancia 2px). Un delta grande significa que el panel no está fixed al viewport de verdad -- algún ancestro le puso un transform."
    }
  },
  "/ruleta [boton-girar-visible-con-panel-390x844]": {
    "relacion": {
      "ok": true,
      "mensaje": "spin-button.bottom=311.2px, panel.top=438.9px (holgura 127.7px, mínimo 16px). Holgura por debajo del mínimo significa que el panel abierto tapa (o casi tapa) el botón GIRAR."
    }
  },
  "/ruleta [boton-girar-visible-con-panel-375x667]": {
    "relacion": {
      "ok": true,
      "mensaje": "spin-button.bottom=316.1px, panel.top=346.8px (holgura 30.8px, mínimo 16px). Holgura por debajo del mínimo significa que el panel abierto tapa (o casi tapa) el botón GIRAR."
    }
  },
  "/ruleta [boton-girar-visible-con-panel-360x640]": {
    "relacion": {
      "ok": true,
      "mensaje": "spin-button.bottom=308.6px, panel.top=332.8px (holgura 24.3px, mínimo 16px). Holgura por debajo del mínimo significa que el panel abierto tapa (o casi tapa) el botón GIRAR."
    }
  },
  "/ruleta [panel-opciones-movil-gestionar]": {
    "#mobile-options-panel": {
      "transform": "matrix(1, 0, 0, 1, 0, 0)"
    },
    "#tab-manage-content": {
      "display": "flex"
    },
    "#tab-edit-content": {
      "display": "none"
    }
  },
  "/dados [lanzado-casino]": {
    ".dice-cube": {
      "transformStyle": "preserve-3d",
      "width": "80px",
      "height": "80px",
      "position": "relative"
    },
    ".casino-face": {
      "backgroundColor": "rgba(220, 20, 40, 0.88)",
      "borderRadius": "12px",
      "display": "grid"
    },
    ".casino-dot": {
      "backgroundColor": "rgb(255, 255, 255)",
      "borderRadius": "50%"
    },
    "#result-display": {
      "display": "flex",
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
    }
  },
  "/dados [lanzado-yugioh]": {
    ".yugioh-face": {
      "backgroundColor": "rgba(0, 0, 0, 0)",
      "borderRadius": "8px",
      "display": "grid"
    },
    ".yugioh-dot": {
      "backgroundColor": "rgb(32, 26, 21)"
    }
  },
  "/dados [lanzado-dnd]": {
    ".d20-wrapper": {
      "display": "inline-block",
      "position": "static",
      "width": "90px",
      "height": "90px"
    },
    ".d20-number": {
      "position": "static",
      "fontFamily": "Outfit, sans-serif",
      "color": "rgb(240, 240, 245)"
    }
  },
  "/amigo-secreto [sorteo-hecho]": {
    ".participant-tag": {
      "display": "flex",
      "backgroundColor": "rgb(20, 20, 29)",
      "borderRadius": "999px"
    },
    ".link-row": {
      "display": "flex",
      "flexDirection": "row",
      "alignItems": "center",
      "backgroundColor": "rgb(20, 20, 29)"
    },
    ".row-name": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "fontWeight": "600",
      "color": "rgb(255, 255, 255)"
    },
    ".row-actions": {
      "display": "flex",
      "gap": "8px"
    },
    ".btn-action": {
      "display": "flex",
      "borderRadius": "6px",
      "cursor": "pointer"
    },
    "#results-section": {
      "display": "block"
    },
    "#matrix-tbody tr": {
      "display": "table-row"
    }
  },
  "/amigo-secreto [sorteo-hecho-movil]": {
    ".link-row": {
      "flexDirection": "column",
      "alignItems": "flex-start"
    },
    ".row-actions": {
      "width": "290px",
      "justifyContent": "flex-end"
    }
  }
}
