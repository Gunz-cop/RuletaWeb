{
  // OJO: "name" es el Worker real en Cloudflare al que está atado el
  // dominio decidelo.app. Renombrarlo crearía un Worker nuevo y vacío y
  // dejaría producción apuntando al viejo. No tocar sin migrar el binding.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azares",
  "compatibility_date": "2026-09-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    // Astro escribe cada página como carpeta/index.html y el modo por
    // defecto (auto-trailing-slash) servía /amigo-secreto/ como página
    // aparte: Google la indexaba duplicada. Con este modo /ruta/ redirige
    // con 307 a /ruta, que es la canónica (trailingSlash: 'never').
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
